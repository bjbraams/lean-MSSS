variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}

/-- The **intensity** `γ = E η([0, 1]^d)` of a random measure on `ℝ^d`. -/
def intensity (P : Measure Ω) (η : Ω → Measure (EuclideanSpace ℝ (Fin d))) : ℝ≥0∞ :=
  ∫⁻ ω, η ω (unitCube d) ∂P

/-- The **reduced second factorial moment measure**
`α₂^!(B) = ∫ 𝟙{x ∈ [0, 1]^d, y - x ∈ B} α₂(d(x, y))`. -/
def reducedSecondMoment (α₂ : Measure (Fin 2 → EuclideanSpace ℝ (Fin d))) :
    Measure (EuclideanSpace ℝ (Fin d)) :=
  (α₂.restrict {z | z 0 ∈ unitCube d}).map fun z ↦ z 1 - z 0

/-- The σ-algebra on measures on `ℝ^d` generated by the shift-invariant measurable sets. -/
@[instance_reducible]
def invariantSigma : MeasurableSpace (Measure (EuclideanSpace ℝ (Fin d))) :=
  MeasurableSpace.generateFrom
    {A | MeasurableSet A ∧ ∀ y, (translate y) ⁻¹' A = A}

lemma intensity_def (P : Measure Ω) (η : Ω → Measure (EuclideanSpace ℝ (Fin d))) :
    intensity P η = ∫⁻ ω, η ω (unitCube d) ∂P := by
  rw [intensity]

lemma reducedSecondMoment_def (α₂ : Measure (Fin 2 → EuclideanSpace ℝ (Fin d))) :
    reducedSecondMoment α₂ = (α₂.restrict {z | z 0 ∈ unitCube d}).map fun z ↦ z 1 - z 0 := by
  rw [reducedSecondMoment]

lemma invariantSigma_def : (invariantSigma : MeasurableSpace (Measure (EuclideanSpace ℝ (Fin d))))
    = MeasurableSpace.generateFrom {A | MeasurableSet A ∧ ∀ y, (translate y) ⁻¹' A = A} := by
  rw [invariantSigma]

/-! ### Stationary point processes (SYNOPSIS item 82) -/

/-- The unit cube is the inverse image of the coordinate cube under the Euclidean equivalence. -/
private lemma unitCube_eq_preimage (d : ℕ) :
    unitCube d = WithLp.ofLp ⁻¹' Set.pi univ (fun _ : Fin d ↦ Icc (0 : ℝ) 1) := by
  ext x
  simp only [unitCube_def, mem_ofPred_eq, mem_preimage, Set.mem_pi, mem_univ, forall_true_left]

/-- The closed unit cube is measurable. -/
lemma measurableSet_unitCube (d : ℕ) : MeasurableSet (unitCube d) := by
  rw [unitCube_eq_preimage]
  exact MeasurableSet.univ_pi (fun _ ↦ measurableSet_Icc)
    |> (PiLp.continuous_ofLp 2 (fun _ : Fin d ↦ ℝ)).measurable

/-- The closed unit cube has unit Lebesgue measure. -/
lemma volume_unitCube (d : ℕ) : volume (unitCube d) = 1 := by
  rw [unitCube_eq_preimage, (PiLp.volume_preserving_ofLp (Fin d)).measure_preimage
    (MeasurableSet.univ_pi fun _ ↦ measurableSet_Icc).nullMeasurableSet, volume_pi_pi]
  simp [Real.volume_Icc]

/-- The centre is interior to the closed unit cube. -/
private lemma unitCube_mem_nhds (d : ℕ) :
    unitCube d ∈ 𝓝 (WithLp.toLp 2 fun _ : Fin d ↦ (1 / 2 : ℝ)) := by
  have hcube : unitCube d = ⋂ i : Fin d, (fun x : EuclideanSpace ℝ (Fin d) ↦
      x.ofLp i) ⁻¹' Icc (0 : ℝ) 1 := by
    ext x
    simp only [unitCube_def, mem_ofPred_eq, mem_iInter, mem_preimage]
  rw [hcube]
  apply Filter.iInter_mem.mpr
  intro i
  apply (PiLp.continuous_apply 2 (fun _ : Fin d ↦ ℝ) i).continuousAt.preimage_mem_nhds
  exact Icc_mem_nhds (by norm_num) (by norm_num)

/-- SYNOPSIS item 82 (a): a stationary random measure with finite intensity `γ` has intensity
measure `γ` times Lebesgue measure. -/
theorem intensityMeasure_stationary {P : Measure Ω} [IsProbabilityMeasure P]
    {η : Ω → Measure (EuclideanSpace ℝ (Fin d))} (hηm : Measurable η) (hst : IsStationary P η)
    (hγ : intensity P η < ∞) : P.bind η = intensity P η • volume := by
  let E := EuclideanSpace ℝ (Fin d)
  let μ := P.bind η
  have hshift (y : E) : μ.map (fun z ↦ z - y) = μ := by
    have hm : Measurable (fun z : E ↦ z - y) := by fun_prop
    have hηy : Measurable (fun ω ↦ translate y (η ω)) :=
      by simpa only [translate_def, Function.comp_def, E] using
        (Measure.measurable_map _ hm).comp hηm
    calc
      _ = P.bind (fun ω ↦ translate y (η ω)) :=
        by simpa only [translate_def] using Measure.map_bind hηm.aemeasurable hm.aemeasurable
      _ = (P.map (fun ω ↦ translate y (η ω))).bind id :=
        (Measure.bind_map hηy.aemeasurable measurable_id.aemeasurable).symm
      _ = μ := by
        rw [isStationary_def.mp hst y, Measure.bind_map hηm.aemeasurable measurable_id.aemeasurable]
        rfl
  let : μ.IsAddLeftInvariant :=
    ⟨fun y ↦ by simpa only [sub_neg_eq_add, add_comm] using hshift (-y)⟩
  have hmeas := measurableSet_unitCube d
  have hμcube : μ (unitCube d) = intensity P η := by
    dsimp only [μ]
    rw [intensity_def, Measure.bind_apply hmeas hηm.aemeasurable]
  let c : E := WithLp.toLp 2 fun _ ↦ 1 / 2
  let : IsLocallyFiniteMeasure μ := ⟨fun x ↦ by
    have hc : Continuous (fun z : E ↦ z - (x - c)) := by fun_prop
    refine ⟨(fun z ↦ z - (x - c)) ⁻¹' unitCube d, hc.continuousAt.preimage_mem_nhds ?_, ?_⟩
    · simpa only [sub_sub_cancel] using unitCube_mem_nhds d
    · rw [← Measure.map_apply hc.measurable hmeas, hshift, hμcube]
      exact hγ⟩
  have hvol := volume_unitCube d
  have hhaar := Measure.isAddLeftInvariant_eq_smul μ (volume : Measure E)
  have hscalar := congrArg (fun ν : Measure E ↦ ν (unitCube d)) hhaar
  simp only [hμcube, Measure.coe_nnreal_smul_apply, hvol, mul_one] at hscalar
  rw [hscalar]
  exact hhaar

private abbrev Euclidean (d : ℕ) := EuclideanSpace ℝ (Fin d)

private lemma isBounded_unitCube (d : ℕ) : Bornology.IsBounded (unitCube d) := by
  rw [unitCube_eq_preimage]
  exact ((PiLp.homeomorph 2 (fun _ : Fin d ↦ ℝ)).isCompact_preimage.2
    (isCompact_univ_pi fun _ ↦ isCompact_Icc)).isBounded

/-- Finite rectangles along a compact exhaustion suffice for measure extensionality. -/
private lemma ext_euclidean_prod_of_bounded {μ ν : Measure (Euclidean d × Euclidean d)}
    (hfin : ∀ {A B}, MeasurableSet A → MeasurableSet B → Bornology.IsBounded A →
      Bornology.IsBounded B → μ (A ×ˢ B) < ∞)
    (heq : ∀ {A B}, MeasurableSet A → MeasurableSet B → Bornology.IsBounded A →
      Bornology.IsBounded B → μ (A ×ˢ B) = ν (A ×ˢ B)) : μ = ν := by
  let C := compactCovering (Euclidean d)
  have hC (n : ℕ) : IsCompact (C n) := isCompact_compactCovering _ _
  have hcover : ⋃ n, C n ×ˢ C n = univ := by
    simpa only [univ_inter, univ_prod_univ] using
      iUnion_prod_inter_eq_prod (compactCovering_subset (Euclidean d))
        (iUnion_compactCovering (Euclidean d)) univ univ
  apply Measure.ext_of_iUnion_eq_univ hcover
  intro n
  let : IsFiniteMeasure (μ.restrict (C n ×ˢ C n)) := ⟨by
    rw [Measure.restrict_apply_univ]
    exact hfin (hC n).measurableSet (hC n).measurableSet (hC n).isBounded (hC n).isBounded⟩
  refine Measure.ext_prod fun {A B} hA hB ↦ ?_
  rw [Measure.restrict_apply (hA.prod hB), Measure.restrict_apply (hA.prod hB), prod_inter_prod]
  exact heq (hA.inter (hC n).measurableSet) (hB.inter (hC n).measurableSet)
    ((hC n).isBounded.subset inter_subset_right) ((hC n).isBounded.subset inter_subset_right)

/-- A measure on pairs invariant under translation in the first coordinate factors as
Lebesgue measure times its second marginal restricted to the unit cube. -/
private lemma euclidean_prod_of_map_add_fst_eq (M : Measure (Euclidean d × Euclidean d))
    (hfin : ∀ {A B}, MeasurableSet A → MeasurableSet B → Bornology.IsBounded A →
      Bornology.IsBounded B → M (A ×ˢ B) < ∞)
    (hshift : ∀ t : Euclidean d, M.map (fun z ↦ (t + z.1, z.2)) = M) :
    let ν := (M.restrict (unitCube d ×ˢ univ)).map Prod.snd
    IsLocallyFiniteMeasure ν ∧ M = volume.prod ν := by
  intro ν
  have hν {B : Set (Euclidean d)} (hB : MeasurableSet B) : ν B = M (unitCube d ×ˢ B) := by
    rw [show ν B = ((M.restrict (unitCube d ×ˢ univ)).map Prod.snd) B from rfl,
      Measure.map_apply measurable_snd hB, Measure.restrict_apply (measurable_snd hB)]
    congr 1
    ext z
    simp [and_comm]
  have : IsLocallyFiniteMeasure ν := ⟨fun x ↦ by
    refine ⟨Metric.ball x 1, Metric.ball_mem_nhds _ zero_lt_one, ?_⟩
    rw [hν measurableSet_ball]
    exact hfin (measurableSet_unitCube _) measurableSet_ball (isBounded_unitCube _)
      Metric.isBounded_ball⟩
  refine ⟨inferInstance, ext_euclidean_prod_of_bounded hfin fun {A B} hA hB _ hb ↦ ?_⟩
  let μ := (M.restrict (univ ×ˢ B)).map Prod.fst
  have hμ {S : Set (Euclidean d)} (hS : MeasurableSet S) : μ S = M (S ×ˢ B) := by
    rw [Measure.map_apply measurable_fst hS, Measure.restrict_apply (measurable_fst hS)]
    congr 1
    ext z
    simp
  have : IsLocallyFiniteMeasure μ := ⟨fun x ↦ by
    refine ⟨Metric.ball x 1, Metric.ball_mem_nhds _ zero_lt_one, ?_⟩
    rw [hμ measurableSet_ball]
    exact hfin measurableSet_ball hB Metric.isBounded_ball hb⟩
  have : μ.IsAddLeftInvariant := ⟨fun t ↦ by
    have ht : Measurable (fun x : Euclidean d ↦ t + x) := by fun_prop
    have htm : Measurable (fun z : Euclidean d × Euclidean d ↦ (t + z.1, z.2)) := by fun_prop
    ext S hS
    rw [Measure.map_apply ht hS, hμ (ht hS), hμ hS]
    calc
      _ = (M.map (fun z ↦ (t + z.1, z.2))) (S ×ˢ B) :=
        (Measure.map_apply htm (hS.prod hB)).symm
      _ = _ := by rw [hshift t]⟩
  have hh := Measure.isAddLeftInvariant_eq_smul μ (volume : Measure (Euclidean d))
  have hc := congrArg (fun m : Measure (Euclidean d) ↦ m (unitCube d)) hh
  simp only [hμ (measurableSet_unitCube d), Measure.coe_nnreal_smul_apply, volume_unitCube,
    mul_one] at hc
  rw [Measure.prod_prod, ← hμ hA, hh, Measure.coe_nnreal_smul_apply, ← hc, hν hB, mul_comm]

private lemma pointSum_sq_measurable_count_ae_lt_top
    (I : Ω → ℕ → Bool) (x : Ω → ℕ → Euclidean d) {P : Measure Ω}
    (hm : Measurable fun ω ↦ pointSum (I ω) (x ω))
    (hsq : ∀ B, Bornology.IsBounded B → ∫⁻ ω, pointSum (I ω) (x ω) B ^ 2 ∂P < ∞)
    {A : Set (Euclidean d)} (hA : MeasurableSet A) (hb : Bornology.IsBounded A) :
    ∀ᵐ ω ∂P, pointSum (I ω) (x ω) A < ∞ := by
  have h := ae_lt_top (((Measure.measurable_coe hA).comp hm).pow_const 2) (hsq A hb).ne
  exact h.mono fun ω hω ↦ by
    contrapose! hω
    dsimp only [Function.comp_apply]
    rw [top_unique hω]
    simp

private lemma factorialPointSum_two_bind_rectangles
    (I : Ω → ℕ → Bool) (x : Ω → ℕ → Euclidean d) {P : Measure Ω}
    (hm : Measurable fun ω ↦ pointSum (I ω) (x ω))
    (hsq : ∀ B, Bornology.IsBounded B → ∫⁻ ω, pointSum (I ω) (x ω) B ^ 2 ∂P < ∞) :
    let M := (P.bind fun ω ↦ factorialPointSum 2 (I ω) (x ω)).map
      MeasurableEquiv.finTwoArrow
    ∀ {A B}, MeasurableSet A → MeasurableSet B → Bornology.IsBounded A →
      Bornology.IsBounded B →
      M (A ×ˢ B) = ∫⁻ ω, pointSum (I ω) (x ω) A * pointSum (I ω) (x ω) B -
        pointSum (I ω) (x ω) (A ∩ B) ∂P := by
  let C := compactCovering (Euclidean d)
  have hC (n : ℕ) : IsCompact (C n) := isCompact_compactCovering _ _
  have hfin : ∀ᵐ ω ∂P, ∀ n, pointSum (I ω) (x ω) (C n) < ∞ := ae_all_iff.2 fun n ↦
    pointSum_sq_measurable_count_ae_lt_top I x hm hsq (hC n).measurableSet (hC n).isBounded
  have hα := aemeasurable_factorialPointSum_two_of_cover I x hm
    (fun n ↦ (hC n).measurableSet) (compactCovering_subset (Euclidean d))
    (iUnion_compactCovering (Euclidean d)) hfin
  intro M A B hA hB ha hb
  let e : (Fin 2 → Euclidean d) ≃ᵐ Euclidean d × Euclidean d := MeasurableEquiv.finTwoArrow
  change ((P.bind fun ω ↦ factorialPointSum 2 (I ω) (x ω)).map e) (A ×ˢ B) = _
  rw [Measure.map_apply e.measurable (hA.prod hB),
    Measure.bind_apply (e.measurable (hA.prod hB)) hα]
  apply lintegral_congr_ae
  filter_upwards [pointSum_sq_measurable_count_ae_lt_top I x hm hsq (hA.inter hB)
    (ha.subset inter_subset_left)] with ω hω
  rw [← Measure.map_apply e.measurable (hA.prod hB)]
  exact ENNReal.eq_sub_of_add_eq hω.ne (factorialPointSum_two_apply_prod_add _ _ hA hB)

/-- The second factorial moment of a stationary process is invariant under diagonal shifts. -/
private lemma factorialPointSum_two_bind_stationary
    (I : Ω → ℕ → Bool) (x : Ω → ℕ → Euclidean d) {P : Measure Ω}
    (hm : Measurable fun ω ↦ pointSum (I ω) (x ω))
    (hst : IsStationary P fun ω ↦ pointSum (I ω) (x ω))
    (hsq : ∀ B, Bornology.IsBounded B → ∫⁻ ω, pointSum (I ω) (x ω) B ^ 2 ∂P < ∞) :
    let M := (P.bind fun ω ↦ factorialPointSum 2 (I ω) (x ω)).map
      MeasurableEquiv.finTwoArrow
    (∀ {A B}, MeasurableSet A → MeasurableSet B → Bornology.IsBounded A →
      Bornology.IsBounded B → M (A ×ˢ B) < ∞) ∧
    ∀ t : Euclidean d, M.map (fun z ↦ (t + z.1, t + z.2)) = M := by
  intro M
  let η (ω : Ω) := pointSum (I ω) (x ω)
  have hrect := @factorialPointSum_two_bind_rectangles _ _ _ I x P hm hsq
  have hfin {A B : Set (Euclidean d)} (hA : MeasurableSet A) (hB : MeasurableSet B)
      (ha : Bornology.IsBounded A) (hb : Bornology.IsBounded B) : M (A ×ˢ B) < ∞ := by
    rw [hrect hA hB ha hb]
    refine (lintegral_mono fun ω ↦ ?_).trans_lt (hsq (A ∪ B) (ha.union hb))
    change η ω A * η ω B - η ω (A ∩ B) ≤ η ω (A ∪ B) ^ 2
    rw [pow_two]
    exact tsub_le_self.trans (mul_le_mul' (measure_mono subset_union_left)
      (measure_mono subset_union_right))
  refine ⟨@hfin, fun t ↦ ?_⟩
  symm
  apply ext_euclidean_prod_of_bounded (@hfin)
  intro A B hA hB ha hb
  let shift (z : Euclidean d) := t + z
  have hshift : Measurable shift := by fun_prop
  have hpair : Measurable (fun z : Euclidean d × Euclidean d ↦ (t + z.1, t + z.2)) := by
    fun_prop
  have hisom : Isometry shift := Isometry.of_dist_eq fun a b ↦ dist_add_left t a b
  have hbnd {S : Set (Euclidean d)} (hS : Bornology.IsBounded S) :
      Bornology.IsBounded (shift ⁻¹' S) := hisom.antilipschitzWith.isBounded_preimage hS
  let F (m : Measure (Euclidean d)) := m A * m B - m (A ∩ B)
  have hF : Measurable F :=
    ((Measure.measurable_coe hA).fun_mul (Measure.measurable_coe hB)).fun_sub
      (Measure.measurable_coe (hA.inter hB))
  have hηmap : Measurable (fun ω ↦ (η ω).map shift) := (Measure.measurable_map _ hshift).comp hm
  have hstat : P.map (fun ω ↦ (η ω).map shift) = P.map η := by
    simpa only [translate_def, sub_neg_eq_add, add_comm, η, shift] using
      (isStationary_def.mp hst (-t))
  rw [Measure.map_apply hpair (hA.prod hB)]
  change M (A ×ˢ B) = M ((shift ⁻¹' A) ×ˢ (shift ⁻¹' B))
  rw [hrect hA hB ha hb, hrect (hshift hA) (hshift hB) (hbnd ha) (hbnd hb)]
  change ∫⁻ ω, F (η ω) ∂P = _
  simp_rw [← preimage_inter, ← Measure.map_apply hshift hA, ← Measure.map_apply hshift hB,
    ← Measure.map_apply hshift (hA.inter hB)]
  change ∫⁻ ω, F (η ω) ∂P = ∫⁻ ω, F ((η ω).map shift) ∂P
  rw [← lintegral_map hF hm, ← lintegral_map hF hηmap, hstat]

private lemma displacement_finite_on_bounded_rectangles
    {M : Measure (Euclidean d × Euclidean d)}
    (hfin : ∀ {A B}, MeasurableSet A → MeasurableSet B → Bornology.IsBounded A →
      Bornology.IsBounded B → M (A ×ˢ B) < ∞)
    {A B : Set (Euclidean d)} (hA : MeasurableSet A) (hB : MeasurableSet B)
    (ha : Bornology.IsBounded A) (hb : Bornology.IsBounded B) :
    (M.map (fun z ↦ (z.1, z.2 - z.1))) (A ×ˢ B) < ∞ := by
  let D (z : Euclidean d × Euclidean d) := (z.1, z.2 - z.1)
  have hm : Measurable D := by fun_prop
  obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.mp (ha.union hb)
  let C := Metric.closedBall (0 : Euclidean d) (max R (R + R))
  change M.map D (A ×ˢ B) < ∞
  rw [Measure.map_apply hm (hA.prod hB)]
  refine (measure_mono ?_).trans_lt
    (hfin (A := C) (B := C) measurableSet_closedBall measurableSet_closedBall
      Metric.isBounded_closedBall Metric.isBounded_closedBall)
  rintro ⟨u, v⟩ ⟨hu, hv⟩
  have hu' : ‖u‖ ≤ R := hR u (Or.inl hu)
  have hv' : ‖v - u‖ ≤ R := hR (v - u) (Or.inr hv)
  have hv'' : ‖v‖ ≤ R + R := calc
    ‖v‖ = ‖(v - u) + u‖ := by rw [sub_add_cancel]
    _ ≤ ‖v - u‖ + ‖u‖ := norm_add_le _ _
    _ ≤ _ := add_le_add hv' hu'
  exact ⟨mem_closedBall_zero_iff.mpr (hu'.trans (le_max_left _ _)),
    mem_closedBall_zero_iff.mpr (hv''.trans (le_max_right _ _))⟩

/-- SYNOPSIS item 82 (b): for a stationary, locally square-integrable point process
`η = ∑_{n : I n} δ_{x_n}`, the reduced second factorial moment measure is locally finite and
`∫ f dα₂ = ∫∫ f(x, x + y) α₂^!(dy) dx` for measurable `f ≥ 0`. -/
theorem reducedSecondMoment_spec {P : Measure Ω} [IsProbabilityMeasure P]
    (I : Ω → ℕ → Bool) (x : Ω → ℕ → EuclideanSpace ℝ (Fin d))
    (hm : Measurable fun ω ↦ pointSum (I ω) (x ω))
    (hst : IsStationary P fun ω ↦ pointSum (I ω) (x ω))
    (hsq : ∀ B, Bornology.IsBounded B → ∫⁻ ω, pointSum (I ω) (x ω) B ^ 2 ∂P < ∞) :
    let α₂ := P.bind fun ω ↦ factorialPointSum 2 (I ω) (x ω)
    IsLocallyFiniteMeasure (reducedSecondMoment α₂) ∧
      ∀ f : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞,
        Measurable (Function.uncurry f) →
        ∫⁻ z, f (z 0) (z 1) ∂α₂ = ∫⁻ y, ∫⁻ v, f y (y + v) ∂reducedSecondMoment α₂ := by
  intro α
  let e : (Fin 2 → Euclidean d) ≃ᵐ Euclidean d × Euclidean d := MeasurableEquiv.finTwoArrow
  let D (z : Euclidean d × Euclidean d) := (z.1, z.2 - z.1)
  let R := (α.map e).map D
  have hD : Measurable D := by fun_prop
  obtain ⟨hfin, hstat⟩ := factorialPointSum_two_bind_stationary I x hm hst hsq
  have hRfin {A B : Set (Euclidean d)} (hA : MeasurableSet A) (hB : MeasurableSet B)
      (ha : Bornology.IsBounded A) (hb : Bornology.IsBounded B) : R (A ×ˢ B) < ∞ :=
    displacement_finite_on_bounded_rectangles (@hfin) hA hB ha hb
  have hRstat (t : Euclidean d) : R.map (fun z ↦ (t + z.1, z.2)) = R := by
    let fstShift (z : Euclidean d × Euclidean d) := (t + z.1, z.2)
    let pairShift (z : Euclidean d × Euclidean d) := (t + z.1, t + z.2)
    have hfst : Measurable fstShift := by fun_prop
    have hpair : Measurable pairShift := by fun_prop
    have heq : fstShift ∘ D = D ∘ pairShift := by
      ext z <;> simp [fstShift, D, pairShift, add_sub_add_left_eq_sub]
    change ((α.map e).map D).map fstShift = _
    rw [Measure.map_map hfst hD, heq, ← Measure.map_map hD hpair, hstat t]
  let ν := (R.restrict (unitCube d ×ˢ univ)).map Prod.snd
  obtain ⟨hνfinite, hprod⟩ := euclidean_prod_of_map_add_fst_eq R (@hRfin) hRstat
  have hR : R = α.map (fun z ↦ (z 0, z 1 - z 0)) := Measure.map_map hD e.measurable
  have hν : ν = reducedSecondMoment α := by
    ext S hS
    dsimp only [ν]
    have hdisp : Measurable (fun z : Fin 2 → Euclidean d ↦ z 1 - z 0) := by fun_prop
    rw [reducedSecondMoment_def, Measure.map_apply measurable_snd hS,
      Measure.restrict_apply (measurable_snd hS), hR,
      Measure.map_apply (by fun_prop) ((measurable_snd hS).inter
        ((measurableSet_unitCube d).prod MeasurableSet.univ)),
      Measure.map_apply hdisp hS, Measure.restrict_apply (hdisp hS)]
    congr 1
    ext z
    simp
  rw [← hν]
  refine ⟨hνfinite, fun f hf ↦ ?_⟩
  let F (z : Euclidean d × Euclidean d) := f z.1 (z.1 + z.2)
  have hF : Measurable F := hf.comp (show Measurable (fun z : Euclidean d × Euclidean d ↦
    (z.1, z.1 + z.2)) by fun_prop)
  change ∫⁻ z, f (z 0) (z 1) ∂α = ∫⁻ y, ∫⁻ v, F (y, v) ∂ν
  rw [← lintegral_prod F hF.aemeasurable, ← hprod, hR, lintegral_map hF (by fun_prop)]
  exact lintegral_congr fun z ↦ by simp [F]

/-- SYNOPSIS item 82 (c): for `d ≥ 1`, a stationary Poisson process with finite intensity is
mixing, hence ergodic. -/
theorem poisson_mixing (hd : 1 ≤ d) {P : Measure Ω} [IsProbabilityMeasure P]
    {η : Ω → Measure (EuclideanSpace ℝ (Fin d))} {γ : ℝ≥0∞} (hγ : γ < ∞)
    (hη : IsPoissonRandomMeasure P η (γ • volume)) :
    (∀ A B : Set (Measure (EuclideanSpace ℝ (Fin d))), MeasurableSet A → MeasurableSet B →
      Tendsto (fun y ↦ P.map η (A ∩ translate y ⁻¹' B)) (cocompact _)
        (𝓝 (P.map η A * P.map η B))) ∧
    ∀ A, MeasurableSet A → (∀ y, translate y ⁻¹' A = A) → P.map η A = 0 ∨ P.map η A = 1 := by
  sorry

/-- SYNOPSIS item 82 (d), ergodic theorem: for a stationary random measure with finite
intensity, a compact convex `W` with nonempty interior, and `a_n → ∞`, `η(a_n W) / |a_n W|`
converges in `L¹` to `E[η([0, 1]^d) ∣ ℐ]`, `ℐ` the invariant σ-algebra; the limit is `γ` when the
law of `η` is ergodic. -/
theorem tendsto_count_div_volume {P : Measure Ω} [IsProbabilityMeasure P]
    {η : Ω → Measure (EuclideanSpace ℝ (Fin d))} (hηm : Measurable η) (hst : IsStationary P η)
    (hγ : intensity P η < ∞) {W : Set (EuclideanSpace ℝ (Fin d))} (hWc : IsCompact W)
    (hWconv : Convex ℝ W) (hWi : (interior W).Nonempty) {a : ℕ → ℝ}
    (ha : Tendsto a atTop atTop) :
    let L := P[fun ω ↦ (η ω (unitCube d)).toReal | invariantSigma.comap η]
    Tendsto (fun n ↦ ∫ ω, |(η ω (a n • W)).toReal / (volume (a n • W)).toReal - L ω| ∂P)
        atTop (𝓝 0) ∧
      ((∀ A, MeasurableSet A → (∀ y, translate y ⁻¹' A = A) → P.map η A = 0 ∨ P.map η A = 1) →
        L =ᵐ[P] fun _ ↦ (intensity P η).toReal) := by
  sorry

/-! ### Palm distributions (SYNOPSIS item 83) -/

/-- SYNOPSIS item 83, refined Campbell theorem: a stationary point process with intensity
`γ ∈ (0, ∞)` has a unique Palm distribution `P⁰`, a probability measure with
`E ∫ f(x, θ_x η) η(dx) = γ ∫∫ f(x, μ) P⁰(dμ) dx` for measurable `f ≥ 0`; moreover
`P⁰(μ{0} > 0) = 1`. -/
theorem existsUnique_palm {P : Measure Ω} [IsProbabilityMeasure P]
    {η : Ω → Measure (EuclideanSpace ℝ (Fin d))} (hηm : Measurable η)
    (hint : ∀ ω, (η ω).IsIntegerValued) (hst : IsStationary P η) (hγ0 : 0 < intensity P η)
    (hγ : intensity P η < ∞) :
    ∃! P₀ : Measure (Measure (EuclideanSpace ℝ (Fin d))), IsProbabilityMeasure P₀ ∧
      (∀ f : EuclideanSpace ℝ (Fin d) → Measure (EuclideanSpace ℝ (Fin d)) → ℝ≥0∞,
        Measurable (Function.uncurry f) →
        ∫⁻ ω, ∫⁻ x, f x (translate x (η ω)) ∂(η ω) ∂P =
          intensity P η * ∫⁻ x, ∫⁻ μ, f x μ ∂P₀) ∧
      P₀ {μ | 0 < μ {0}} = 1 := by
  sorry

section LocalPalm

variable {X : Type*} [MeasurableSpace X] [StandardBorelSpace X]

/-- A finite measure is encoded by its mass and its normalised image on a compact interval. -/
private abbrev FiniteMeasureCode := ℝ≥0∞ × ProbabilityMeasure unitInterval

private theorem nonempty_probabilityMeasure_unitInterval :
    Nonempty (ProbabilityMeasure unitInterval) :=
  ⟨⟨Measure.dirac (0 : unitInterval), inferInstance⟩⟩

private theorem polishSpace_probabilityMeasure_unitInterval :
    PolishSpace (ProbabilityMeasure unitInterval) := by
  let : MetricSpace (ProbabilityMeasure unitInterval) :=
    TopologicalSpace.metrizableSpaceMetric _
  infer_instance

attribute [local instance] nonempty_probabilityMeasure_unitInterval
  polishSpace_probabilityMeasure_unitInterval

/-- The normalised image measure, with an arbitrary point mass when the input is zero. -/
private def finiteMeasureProbValue (e : X → unitInterval) (μ : FiniteMeasure X) :
    Measure unitInterval :=
  if (μ : Measure X) univ = 0 then Measure.dirac 0
  else ((μ : Measure X) univ)⁻¹ • (μ : Measure X).map e

/-- The normalised pushforward is a probability measure on the compact interval. -/
private def finiteMeasureProbCode (e : X → unitInterval) (he : Measurable e)
    (μ : FiniteMeasure X) : ProbabilityMeasure unitInterval :=
  ⟨finiteMeasureProbValue e μ, by
    by_cases h : (μ : Measure X) univ = 0
    · simp only [finiteMeasureProbValue, ite_eq_left h]
      infer_instance
    · refine ⟨?_⟩
      rw [finiteMeasureProbValue, ite_eq_right h, smul_apply,
        Measure.map_apply he MeasurableSet.univ, Set.preimage_univ, smul_eq_mul]
      exact ENNReal.inv_mul_cancel h (measure_ne_top _ _)⟩

omit [StandardBorelSpace X] in
/-- The probability part of the finite measure code is measurable in the finite measure. -/
private theorem measurable_finiteMeasureProbCode {e : X → unitInterval} (he : Measurable e) :
    Measurable (finiteMeasureProbCode e he) := by
  let mass (μ : FiniteMeasure X) := (μ : Measure X) univ
  have hm : Measurable mass :=
    (Measure.measurable_coe MeasurableSet.univ).comp measurable_subtype_coe
  have hb : Measurable (fun (μ : FiniteMeasure X) ↦ (mass μ)⁻¹ • (μ : Measure X).map e) := by
    refine Measure.measurable_of_measurable_coe _ fun s hs ↦ ?_
    simp only [smul_apply, smul_eq_mul, Measure.map_apply he hs]
    exact hm.inv.mul ((Measure.measurable_coe (he hs)).comp measurable_subtype_coe)
  have hval : Measurable (fun μ ↦ (finiteMeasureProbCode e he μ : Measure unitInterval)) := by
    -- Work with the represented measure before rewriting its zero-mass branch.
    change Measurable (finiteMeasureProbValue e)
    exact Measurable.ite (hm (measurableSet_singleton 0)) measurable_const hb
  exact hval.subtype_mk

omit [StandardBorelSpace X] in
/-- The finite measure code is measurable in both coordinates. -/
private theorem measurable_finiteMeasure_encode {e : X → unitInterval} (he : Measurable e) :
    Measurable (fun μ : FiniteMeasure X ↦
      ((μ : Measure X) univ, finiteMeasureProbCode e he μ)) :=
  ((Measure.measurable_coe MeasurableSet.univ).comp measurable_subtype_coe).prodMk
    (measurable_finiteMeasureProbCode he)

omit [StandardBorelSpace X] in
/-- A code decodes by pulling back the probability measure and restoring its original mass. -/
private theorem measurable_finiteMeasure_decode {e : X → unitInterval}
    (he : MeasurableEmbedding e) :
    Measurable (fun c : FiniteMeasureCode ↦ c.1 • (c.2 : Measure unitInterval).comap e) := by
  refine Measure.measurable_of_measurable_coe _ fun s hs ↦ ?_
  simp_rw [smul_apply, smul_eq_mul, Measure.comap_apply _ he.injective
    (fun _ ht ↦ he.measurableSet_image' ht) _ hs]
  exact measurable_fst.mul ((Measure.measurable_coe (he.measurableSet_image' hs)).comp
    (measurable_subtype_coe.comp measurable_snd))

omit [StandardBorelSpace X] in
/-- Decoding an actual finite measure code restores the original measure. -/
private theorem finiteMeasure_decode_encode {e : X → unitInterval}
    (he : MeasurableEmbedding e) (μ : FiniteMeasure X) :
    (μ : Measure X) univ •
    (finiteMeasureProbCode e he.measurable μ : Measure unitInterval).comap e = (μ : Measure X) := by
  by_cases h : (μ : Measure X) univ = 0
  · rw [h, zero_smul, Measure.measure_univ_eq_zero.mp h]
  · -- Eliminate the subtype proof before cancelling normalization.
    change (μ : Measure X) univ • (finiteMeasureProbValue e μ).comap e = (μ : Measure X)
    rw [finiteMeasureProbValue, ite_eq_right h, Measure.comap_smul, he.comap_map, smul_smul,
      ENNReal.mul_inv_cancel h (measure_ne_top _ _), one_smul]


/-- Restrict a measure to a finite-mass set and use zero for an infinite restriction. -/
private def cutFiniteMeasureValue (C : Set X) (μ : Measure X) : Measure X :=
  if μ C = ⊤ then 0 else μ.restrict C

/-- The restriction-with-fallback construction has finite mass. -/
private def cutFiniteMeasure (C : Set X) (μ : Measure X) : FiniteMeasure X :=
  ⟨cutFiniteMeasureValue C μ, by
    by_cases h : μ C = ⊤
    · simp only [cutFiniteMeasureValue, ite_eq_left h]
      infer_instance
    · simp only [cutFiniteMeasureValue, ite_eq_right h]
      exact isFiniteMeasure_restrict.mpr h⟩

omit [StandardBorelSpace X] in
/-- The finite restriction is measurable in the original measure. -/
private lemma measurable_cutFiniteMeasure {C : Set X} (hC : MeasurableSet C) :
    Measurable (cutFiniteMeasure C : Measure X → FiniteMeasure X) := by
  have hr : Measurable (fun μ : Measure X ↦ μ.restrict C) := by
    refine Measure.measurable_of_measurable_coe _ fun s hs ↦ ?_
    simp only [Measure.restrict_apply hs]
    exact Measure.measurable_coe (hs.inter hC)
  have hm : Measurable (fun μ ↦ (cutFiniteMeasure C μ : Measure X)) := by
    -- Measure evaluations discard the proof that each piece is finite.
    change Measurable (cutFiniteMeasureValue C)
    exact Measurable.ite (Measure.measurable_coe hC (measurableSet_singleton _)) measurable_const hr
  exact hm.subtype_mk

/-- Coding every member of a countable measurable partition gives a standard Borel target. -/
private abbrev PalmMeasureCode := ℕ → FiniteMeasureCode

local notation "eₓ" => (unitInterval.sigmoid ∘ MeasureTheory.embeddingReal X)
local notation "heₓ" => (measurableEmbedding_sigmoid_comp_embeddingReal X)

/-- Encode the restrictions of a measure to the pieces of a partition. -/
private def encodePalmMeasure (C : ℕ → Set X) (μ : Measure X) : PalmMeasureCode := fun n ↦
  let ν := cutFiniteMeasure (C n) μ
  ((ν : Measure X) univ, finiteMeasureProbCode eₓ (heₓ).measurable ν)

/-- Decode the pieces and superpose the resulting measures. -/
private def decodePalmMeasure (v : PalmMeasureCode) : Measure X :=
  Measure.sum fun n ↦ (v n).1 • ((v n).2 : Measure unitInterval).comap eₓ

/-- A measurable partition gives a measurable map into the countable code space. -/
private lemma measurable_encodePalmMeasure {C : ℕ → Set X} (hC : ∀ n, MeasurableSet (C n)) :
    Measurable (encodePalmMeasure C : Measure X → PalmMeasureCode) :=
  Measurable.of_eval fun n ↦
    (measurable_finiteMeasure_encode (heₓ).measurable).comp (measurable_cutFiniteMeasure (hC n))

/-- The decoded measure is measurable for the evaluation measurable structure. -/
private lemma measurable_decodePalmMeasure :
    Measurable (decodePalmMeasure : PalmMeasureCode → Measure X) :=
  TauCeti.MeasureTheory.measurable_measure_sum.comp (Measurable.of_eval fun n ↦
    (measurable_finiteMeasure_decode heₓ).comp (measurable_pi_apply n))

omit [StandardBorelSpace X] in
/-- On a finite-mass piece the code's cutoff agrees with ordinary restriction. -/
private lemma coe_cutFiniteMeasure_of_ne_top {C : Set X} {μ : Measure X} (h : μ C ≠ ⊤) :
    (cutFiniteMeasure C μ : Measure X) = μ.restrict C := by
  -- Unfold only the measure, without its finite-mass proof.
  change cutFiniteMeasureValue C μ = μ.restrict C
  exact ite_eq_right h

/-- A measure finite on every piece of a measurable partition is recovered by decoding. -/
private lemma decode_encodePalmMeasure {C : ℕ → Set X} (hC : ∀ n, MeasurableSet (C n))
    (hd : Pairwise (Disjoint on C)) (hcover : ⋃ n, C n = univ)
    {μ : Measure X} (hfin : ∀ n, μ (C n) ≠ ⊤) :
    decodePalmMeasure (encodePalmMeasure C μ) = μ := by
  dsimp only [decodePalmMeasure, encodePalmMeasure]
  simp_rw [finiteMeasure_decode_encode heₓ, coe_cutFiniteMeasure_of_ne_top (hfin _)]
  rw [← Measure.restrict_iUnion hd hC, hcover, Measure.restrict_univ]

variable {P : Measure Ω} {ξ : Ω → Measure X}

/-- The Campbell measure on the product of the location space and the measure code space. -/
private lemma exists_palmCodeJoint (hξm : Measurable ξ) {C : ℕ → Set X}
    (hC : ∀ n, MeasurableSet (C n)) (hd : Pairwise (Disjoint on C)) (hcover : ⋃ n, C n = univ)
    (hfin : ∀ᵐ ω ∂P, ∀ n, ξ ω (C n) ≠ ⊤) :
    ∃ ρ : Measure (X × PalmMeasureCode),
      ∀ f : X × PalmMeasureCode → ℝ≥0∞, Measurable f →
        ∫⁻ p, f p ∂ρ =
          ∫⁻ ω, ∫⁻ x, f (x, encodePalmMeasure C (ξ ω)) ∂ξ ω ∂P := by
  let code := encodePalmMeasure C ∘ ξ
  have hcode := (measurable_encodePalmMeasure hC).comp hξm
  let K (ω : Ω) := Measure.sum fun n : ℕ ↦
    ((cutFiniteMeasure (C n) (ξ ω)) : Measure X).map (fun x ↦ (x, code ω))
  have hK : Measurable K := by
    refine TauCeti.MeasureTheory.measurable_measure_sum.comp (Measurable.of_eval fun n ↦ ?_)
    exact (TauCeti.MeasureTheory.measurable_map_finiteMeasure_of_measurable_uncurry
      (f := fun (c : PalmMeasureCode) (x : X) ↦ (x, c)) measurable_swap).comp
        (((measurable_cutFiniteMeasure (hC n)).comp hξm).prodMk hcode)
  refine ⟨P.bind K, fun f hf ↦ ?_⟩
  rw [Measure.lintegral_bind hK.aemeasurable hf.aemeasurable]
  refine lintegral_congr_ae (hfin.mono fun ω hw ↦ ?_)
  have hm : Measurable (fun x : X ↦ (x, code ω)) := measurable_id.prodMk measurable_const
  dsimp only [K]
  rw [← Measure.map_sum hm.aemeasurable, lintegral_map hf hm]
  simp_rw [coe_cutFiniteMeasure_of_ne_top (hw _)]
  rw [← Measure.restrict_iUnion hd hC, hcover, Measure.restrict_univ]
  rfl

/-- Deterministic disjoint pieces of finite mean mass, used to code the directing measures. -/
private abbrev palmCodePieces (P : Measure Ω) (ξ : Ω → Measure X) [SigmaFinite (P.bind ξ)] :=
  disjointed (spanningSets (P.bind ξ))

omit [StandardBorelSpace X] in
/-- Almost every random measure is finite on each piece of its deterministic mean cover. -/
private lemma ae_ne_top_palmCodePieces [SigmaFinite (P.bind ξ)] (hξm : Measurable ξ) :
    ∀ᵐ ω ∂P, ∀ n, ξ ω (palmCodePieces P ξ n) ≠ ⊤ := ae_all_iff.2 fun n ↦ by
  have hm : MeasurableSet (palmCodePieces P ξ n) :=
    MeasurableSet.disjointed (measurableSet_spanningSets (P.bind ξ)) n
  have hf : (P.bind ξ) (palmCodePieces P ξ n) < ⊤ :=
    (measure_mono (disjointed_subset (spanningSets (P.bind ξ)) n)).trans_lt
      (measure_spanningSets_lt_top (P.bind ξ) n)
  rw [Measure.bind_apply hm hξm.aemeasurable] at hf
  exact (ae_lt_top ((Measure.measurable_coe hm).comp hξm) hf.ne).mono fun _ hw ↦ hw.ne

/-- The first marginal of the encoded Campbell measure is the intensity measure. -/
private lemma fst_eq_of_palmCodeJoint (hξm : Measurable ξ) {C : ℕ → Set X}
    {ρ : Measure (X × PalmMeasureCode)}
    (hρ : ∀ f : X × PalmMeasureCode → ℝ≥0∞, Measurable f →
      ∫⁻ p, f p ∂ρ = ∫⁻ ω, ∫⁻ x, f (x, encodePalmMeasure C (ξ ω)) ∂ξ ω ∂P) :
    ρ.fst = P.bind ξ := by
  ext A hA
  have hAm : MeasurableSet (Prod.fst ⁻¹' A : Set (X × PalmMeasureCode)) := measurable_fst hA
  rw [Measure.fst_apply hA, ← lintegral_indicator_one hAm,
    hρ _ (measurable_one.indicator hAm), Measure.bind_apply hA hξm.aemeasurable]
  exact lintegral_congr fun ω ↦ lintegral_indicator_one hA

/-- SYNOPSIS item 83, local Palm distributions: a random measure on a Polish space with
σ-finite intensity measure `M` has a probability kernel `x ↦ P_x` with
`E ∫ g(x, ξ) ξ(dx) = ∫∫ g(x, μ) P_x(dμ) M(dx)` for measurable `g ≥ 0`. -/
theorem exists_palmKernel {X : Type*} [MeasurableSpace X] [TopologicalSpace X] [PolishSpace X]
    [BorelSpace X] {P : Measure Ω} [IsProbabilityMeasure P] {ξ : Ω → Measure X}
    (hξm : Measurable ξ) [SigmaFinite (P.bind ξ)] :
    ∃ Px : Kernel X (Measure X), IsMarkovKernel Px ∧
      ∀ g : X → Measure X → ℝ≥0∞, Measurable (Function.uncurry g) →
        ∫⁻ ω, ∫⁻ x, g x (ξ ω) ∂(ξ ω) ∂P = ∫⁻ x, ∫⁻ μ, g x μ ∂Px x ∂P.bind ξ := by
  let C := palmCodePieces P ξ
  have hcm : ∀ n, MeasurableSet (C n) :=
    MeasurableSet.disjointed (measurableSet_spanningSets (P.bind ξ))
  have hd : Pairwise (Disjoint on C) := fun i j hne ↦
    disjoint_disjointed (spanningSets (P.bind ξ)) hne
  have hc : ⋃ n, C n = univ := iUnion_disjointed.trans (iUnion_spanningSets (P.bind ξ))
  have hfin : ∀ᵐ ω ∂P, ∀ n, ξ ω (C n) ≠ ⊤ := ae_ne_top_palmCodePieces hξm
  obtain ⟨ρ, hρ⟩ := exists_palmCodeJoint hξm hcm hd hc hfin
  have hM := fst_eq_of_palmCodeJoint hξm hρ
  have : SigmaFinite ρ.fst := by rw [hM]; infer_instance
  let κ := ρ.sigmaFiniteCondKernel
  let decode : PalmMeasureCode → Measure X := decodePalmMeasure
  have hdec : Measurable decode := measurable_decodePalmMeasure
  refine ⟨κ.map decode, Kernel.IsMarkovKernel.map κ hdec, fun g hg ↦ ?_⟩
  let f : X × PalmMeasureCode → ℝ≥0∞ := fun p ↦ g p.1 (decode p.2)
  have hf : Measurable f := hg.comp (measurable_fst.prodMk (hdec.comp measurable_snd))
  calc
    _ = ∫⁻ p, f p ∂ρ := by
      rw [hρ _ hf]
      refine lintegral_congr_ae (hfin.mono fun ω hw ↦ ?_)
      simp only [f, decode, decode_encodePalmMeasure hcm hd hc hw]
    _ = ∫⁻ x, ∫⁻ v, g x (decode v) ∂κ x ∂P.bind ξ := by
      calc
        _ = ∫⁻ p, f p ∂(ρ.fst ⊗ₘ κ) := by rw [Measure.compProd_fst_sigmaFiniteCondKernel ρ]
        _ = _ := by rw [Measure.lintegral_compProd hf, hM]
    _ = _ := by
      refine lintegral_congr fun x ↦ ?_
      exact (Kernel.lintegral_map κ hdec x (hg.comp measurable_prodMk_left)).symm

/-- The set of measures finite on each piece of a countable measurable family. -/
private def palmFiniteOn (C : ℕ → Set X) : Set (Measure X) := {μ | ∀ n, μ (C n) ≠ ⊤}

omit [StandardBorelSpace X] in
/-- The finite-on-pieces condition is measurable in the evaluations of a measure. -/
private lemma measurableSet_palmFiniteOn {C : ℕ → Set X} (hC : ∀ n, MeasurableSet (C n)) :
    MeasurableSet (palmFiniteOn C) := by
  simp only [palmFiniteOn, Set.ofPred_forall]
  exact MeasurableSet.iInter fun n ↦ Measure.measurable_coe (hC n)
    (measurableSet_singleton (⊤ : ℝ≥0∞)).compl

omit [StandardBorelSpace X] in
/-- A Campbell representation puts almost every conditional law on the measures finite on
the deterministic pieces of finite mean mass. -/
private lemma ae_palmKernel_measure_compl_palmFiniteOn_eq_zero {C : ℕ → Set X}
    (hC : ∀ n, MeasurableSet (C n)) (hfin : ∀ᵐ ω ∂P, ∀ n, ξ ω (C n) ≠ ⊤)
    (Px : Kernel X (Measure X))
    (hPx : ∀ g : X → Measure X → ℝ≥0∞, Measurable (Function.uncurry g) →
      ∫⁻ ω, ∫⁻ x, g x (ξ ω) ∂(ξ ω) ∂P = ∫⁻ x, ∫⁻ μ, g x μ ∂Px x ∂P.bind ξ) :
    ∀ᵐ x ∂P.bind ξ, Px x (palmFiniteOn C)ᶜ = 0 := by
  let D := (palmFiniteOn C)ᶜ
  have hD : MeasurableSet D := (measurableSet_palmFiniteOn hC).compl
  let g : X → Measure X → ℝ≥0∞ := fun _ μ ↦ D.indicator 1 μ
  have hg : Measurable (Function.uncurry g) :=
    (measurable_one.indicator hD).comp measurable_snd
  have hL : (∫⁻ ω, ∫⁻ x, g x (ξ ω) ∂ξ ω ∂P) = 0 := by
    rw [← lintegral_zero]
    refine lintegral_congr_ae (hfin.mono fun ω hw ↦ ?_)
    have hnot : ξ ω ∉ D := fun hbad ↦ hbad hw
    simp only [g, Set.indicator_of_notMem hnot, lintegral_zero]
  rw [hPx _ hg] at hL
  have hmass : (∫⁻ x, Px x D ∂P.bind ξ) = 0 := by
    simpa only [g, lintegral_indicator_one hD] using hL
  exact (lintegral_eq_zero_iff (Px.measurable_coe hD)).mp hmass

/-- Pushing a kernel representing Campbell integrals to the code space disintegrates
the encoded Campbell measure. -/
private lemma compProd_map_encodePalm_eq_of_palmKernel [SigmaFinite (P.bind ξ)]
    {C : ℕ → Set X} (hC : ∀ n, MeasurableSet (C n))
    {ρ : Measure (X × PalmMeasureCode)} (hM : ρ.fst = P.bind ξ)
    (hρ : ∀ f : X × PalmMeasureCode → ℝ≥0∞, Measurable f →
      ∫⁻ p, f p ∂ρ = ∫⁻ ω, ∫⁻ x, f (x, encodePalmMeasure C (ξ ω)) ∂ξ ω ∂P)
    (Px : Kernel X (Measure X)) [IsMarkovKernel Px]
    (hPx : ∀ g : X → Measure X → ℝ≥0∞, Measurable (Function.uncurry g) →
      ∫⁻ ω, ∫⁻ x, g x (ξ ω) ∂(ξ ω) ∂P = ∫⁻ x, ∫⁻ μ, g x μ ∂Px x ∂P.bind ξ) :
    ρ.fst ⊗ₘ (Px.map (encodePalmMeasure C)) = ρ := by
  rw [hM]
  have henc := measurable_encodePalmMeasure hC
  have : IsMarkovKernel (Px.map (encodePalmMeasure C)) := Kernel.IsMarkovKernel.map Px henc
  ext A hA
  let f : X × PalmMeasureCode → ℝ≥0∞ := A.indicator 1
  have hf : Measurable f := measurable_one.indicator hA
  let g : X → Measure X → ℝ≥0∞ := fun x μ ↦ f (x, encodePalmMeasure C μ)
  have hg : Measurable (Function.uncurry g) :=
    hf.comp (measurable_fst.prodMk (henc.comp measurable_snd))
  rw [← lintegral_indicator_one hA, ← lintegral_indicator_one hA]
  -- Express both indicators with the same test before applying the two integral formulas.
  change (∫⁻ p, f p ∂(P.bind ξ ⊗ₘ Px.map (encodePalmMeasure C))) = ∫⁻ p, f p ∂ρ
  rw [Measure.lintegral_compProd hf, hρ _ hf]
  calc
    _ = ∫⁻ x, ∫⁻ μ, g x μ ∂Px x ∂P.bind ξ :=
      lintegral_congr fun x ↦ Kernel.lintegral_map Px henc x (hf.comp measurable_prodMk_left)
    _ = _ := (hPx g hg).symm

/-- Decoding the law of the code of a measure returns the original law when the measure is
almost surely finite on each piece. -/
private lemma map_decode_encodePalm_eq {C : ℕ → Set X} (hC : ∀ n, MeasurableSet (C n))
    (hd : Pairwise (Disjoint on C)) (hcover : ⋃ n, C n = univ)
    {μ : Measure (Measure X)} (hμ : μ (palmFiniteOn C)ᶜ = 0) :
    (μ.map (encodePalmMeasure C)).map decodePalmMeasure = μ := by
  rw [Measure.map_map measurable_decodePalmMeasure (measurable_encodePalmMeasure hC)]
  have heq : decodePalmMeasure ∘ encodePalmMeasure C =ᵐ[μ] id :=
    (show ∀ᵐ η ∂μ, η ∈ palmFiniteOn C from mem_ae_iff.mpr hμ).mono
      (fun _ h ↦ decode_encodePalmMeasure hC hd hcover h)
  rw [Measure.map_congr heq, Measure.map_id]

/-- SYNOPSIS item 83: the kernel of local Palm distributions is unique up to `M`-null sets. -/
theorem palmKernel_ae_eq {X : Type*} [MeasurableSpace X] [TopologicalSpace X] [PolishSpace X]
    [BorelSpace X] {P : Measure Ω} [IsProbabilityMeasure P] {ξ : Ω → Measure X}
    (hξm : Measurable ξ) [SigmaFinite (P.bind ξ)] {Px Px' : Kernel X (Measure X)}
    [IsMarkovKernel Px] [IsMarkovKernel Px']
    (h : ∀ g : X → Measure X → ℝ≥0∞, Measurable (Function.uncurry g) →
      ∫⁻ ω, ∫⁻ x, g x (ξ ω) ∂(ξ ω) ∂P = ∫⁻ x, ∫⁻ μ, g x μ ∂Px x ∂P.bind ξ)
    (h' : ∀ g : X → Measure X → ℝ≥0∞, Measurable (Function.uncurry g) →
      ∫⁻ ω, ∫⁻ x, g x (ξ ω) ∂(ξ ω) ∂P = ∫⁻ x, ∫⁻ μ, g x μ ∂Px' x ∂P.bind ξ) :
    ∀ᵐ x ∂P.bind ξ, Px x = Px' x := by
  let C := palmCodePieces P ξ
  have hcm : ∀ n, MeasurableSet (C n) :=
    MeasurableSet.disjointed (measurableSet_spanningSets (P.bind ξ))
  have hd : Pairwise (Disjoint on C) := fun i j hne ↦
    disjoint_disjointed (spanningSets (P.bind ξ)) hne
  have hc : ⋃ n, C n = univ := iUnion_disjointed.trans (iUnion_spanningSets (P.bind ξ))
  have hfin : ∀ᵐ ω ∂P, ∀ n, ξ ω (C n) ≠ ⊤ := ae_ne_top_palmCodePieces hξm
  obtain ⟨ρ, hρ⟩ := exists_palmCodeJoint hξm hcm hd hc hfin
  have hM := fst_eq_of_palmCodeJoint hξm hρ
  have : SigmaFinite ρ.fst := by rw [hM]; infer_instance
  have henc := measurable_encodePalmMeasure hcm
  have : IsMarkovKernel (Px.map (encodePalmMeasure C)) := Kernel.IsMarkovKernel.map Px henc
  have : IsMarkovKernel (Px'.map (encodePalmMeasure C)) := Kernel.IsMarkovKernel.map Px' henc
  have hP := Measure.eq_sigmaFiniteCondKernel_of_measure_eq_compProd ρ _
    (compProd_map_encodePalm_eq_of_palmKernel hcm hM hρ Px h)
  have hQ := Measure.eq_sigmaFiniteCondKernel_of_measure_eq_compProd ρ _
    (compProd_map_encodePalm_eq_of_palmKernel hcm hM hρ Px' h')
  have hEq := hP.trans hQ.symm
  rw [hM] at hEq
  filter_upwards [hEq, ae_palmKernel_measure_compl_palmFiniteOn_eq_zero hcm hfin Px h,
    ae_palmKernel_measure_compl_palmFiniteOn_eq_zero hcm hfin Px' h'] with x hx hp hq
  rw [Kernel.map_apply Px henc x, Kernel.map_apply Px' henc x] at hx
  rw [← map_decode_encodePalm_eq hcm hd hc hp, ← map_decode_encodePalm_eq hcm hd hc hq, hx]

end LocalPalm

/-! ### The Slivnyak–Mecke theorem (SYNOPSIS item 84) -/

/-- The finite Poisson law integrates a test by mixing finite products of the location law. -/
private lemma lintegral_finitePoissonLaw_finPi {X : Type*} [MeasurableSpace X]
    (r : ℝ≥0) (Q : Measure X) [IsProbabilityMeasure Q]
    {G : Measure X → ℝ≥0∞} (hG : Measurable G) :
    ∫⁻ μ, G μ ∂finitePoissonLaw r Q =
      ∫⁻ n : ℕ, ∫⁻ z : Fin n → X, G (∑ i : Fin n, Measure.dirac (z i))
        ∂Measure.pi (fun _ ↦ Q) ∂poissonMeasure r := by
  rw [lintegral_finitePoissonLaw r Q hG]
  refine lintegral_congr fun n ↦ ?_
  let zfn : (ℕ → X) → Fin n → X := fun z i ↦ z i
  have hm : Measurable zfn := Measurable.of_eval fun _ ↦ measurable_pi_apply _
  have hp : MeasurePreserving zfn (Measure.infinitePi (fun _ : ℕ ↦ Q))
      (Measure.pi (fun _ : Fin n ↦ Q)) :=
    ⟨hm, by
      simpa only [Measure.infinitePi_eq_pi, zfn, Function.comp_apply] using
        (Measure.map_infinitePi_infinitePi_of_inj (P := fun _ : ℕ ↦ Q)
          (f := (Fin.val : Fin n → ℕ)) Fin.val_injective)⟩
  have htest : Measurable (fun z : Fin n → X ↦ G (∑ i : Fin n, Measure.dirac (z i))) :=
    hG.comp (Finset.measurable_sum _ fun i _ ↦
      Measure.measurable_dirac.comp (measurable_pi_apply i))
  convert hp.lintegral_comp htest using 2
  ext z
  congr 1
  exact (Fin.sum_univ_eq_sum_range (fun i ↦ Measure.dirac (z i)) n).symm

/-- Integration against a finite measure of a jointly measurable test of its point and
measure arguments is measurable in the finite measure. -/
private lemma measurable_lintegral_cutFiniteMeasure {X : Type*} [MeasurableSpace X]
    {g : X × Measure X → ℝ≥0∞} (hg : Measurable g) :
    Measurable (fun μ ↦ ∫⁻ y, g (y, μ) ∂(cutFiniteMeasure univ μ : Measure X)) := by
  let K (μ : Measure X) := (cutFiniteMeasure univ μ : Measure X).map (fun x ↦ (x, μ))
  have hK : Measurable K :=
    (TauCeti.MeasureTheory.measurable_map_finiteMeasure_of_measurable_uncurry
      (f := fun (a : Measure X) (x : X) ↦ (x, a)) measurable_swap).comp
        ((measurable_cutFiniteMeasure MeasurableSet.univ).prodMk measurable_id)
  have heq (μ : Measure X) :
      (∫⁻ y, g (y, μ) ∂(cutFiniteMeasure univ μ : Measure X)) = ∫⁻ z, g z ∂K μ := by
    have hm : Measurable (fun x : X ↦ (x, μ)) := measurable_id.prodMk measurable_const
    exact (lintegral_map hg hm).symm
  simp_rw [heq]
  exact (Measure.measurable_lintegral hg).comp hK

private lemma exists_probability_smul_eq_of_finite {X : Type*} [MeasurableSpace X]
    {Λ : Measure X} [IsFiniteMeasure Λ] (h0 : Λ ≠ 0) :
    ∃ (r : ℝ≥0) (Q : Measure X), IsProbabilityMeasure Q ∧ (r : ℝ≥0∞) • Q = Λ := by
  have hmass : Λ univ ≠ 0 := mt Measure.measure_univ_eq_zero.mp h0
  let r := (Λ univ).toNNReal
  let Q := (Λ univ)⁻¹ • Λ
  have hQ : IsProbabilityMeasure Q :=
    ⟨by rw [smul_apply, smul_eq_mul, ENNReal.inv_mul_cancel hmass (measure_ne_top _ _)]⟩
  have hrQ : (r : ℝ≥0∞) • Q = Λ := by
    rw [smul_smul, ENNReal.coe_toNNReal (measure_ne_top Λ univ),
      ENNReal.mul_inv_cancel hmass (measure_ne_top _ _), one_smul]
  exact ⟨r, Q, hQ, hrQ⟩

/-- Mecke's insertion identity for a Poisson random measure of finite total intensity. -/
theorem lintegral_finitePoissonRandomMeasure_mecke
    {X : Type*} [MeasurableSpace X] {P : Measure Ω} [IsProbabilityMeasure P]
    {η : Ω → Measure X} {Λ : Measure X} [IsFiniteMeasure Λ]
    (hη : IsPoissonRandomMeasure P η Λ) {g : X × Measure X → ℝ≥0∞} (hg : Measurable g) :
    ∫⁻ ω, ∫⁻ y, g (y, η ω) ∂η ω ∂P =
      ∫⁻ y, ∫⁻ ω, g (y, η ω + Measure.dirac y) ∂P ∂Λ := by
  by_cases h0 : Λ = 0
  · have hz : IsPoissonRandomMeasure P η (0 : Measure X) := h0 ▸ hη
    rw [h0, lintegral_zero_measure, ← lintegral_zero]
    refine lintegral_congr_ae (hz.ae_eq_zero_measure.mono fun ω hw ↦ ?_)
    simp only [hw, lintegral_zero_measure]
  obtain ⟨r, Q, hQ, hrQ⟩ := exists_probability_smul_eq_of_finite h0
  have hLaw : P.map η = finitePoissonLaw r Q := by
    have hr' := isPoissonRandomMeasure_finitePoissonLaw r Q
    rw [hrQ] at hr'
    simpa only [Measure.map_id] using (hη.identDistrib hr').map_eq
  let H (μ : Measure X) :=
    ∫⁻ y, g (y, μ) ∂(cutFiniteMeasure univ μ : Measure X)
  have hH : Measurable H := measurable_lintegral_cutFiniteMeasure hg
  have hcut (μ : Measure X) (hfin : μ univ < ⊤) : H μ = ∫⁻ y, g (y, μ) ∂μ := by
    simp only [H, coe_cutFiniteMeasure_of_ne_top hfin.ne, Measure.restrict_univ]
  calc
    _ = ∫⁻ ω, H (η ω) ∂P := by
      refine lintegral_congr_ae ((hη.ae_lt_top MeasurableSet.univ (measure_lt_top Λ univ)).mono
        fun ω hfin ↦ (hcut _ hfin).symm)
    _ = ∫⁻ μ, H μ ∂finitePoissonLaw r Q := by
      rw [← hLaw, lintegral_map hH hη.measurable]
    _ = ∫⁻ n : ℕ, ∫⁻ z : Fin n → X, H (∑ i : Fin n, Measure.dirac (z i))
            ∂Measure.pi (fun _ ↦ Q) ∂poissonMeasure r := lintegral_finitePoissonLaw_finPi r Q hH
    _ = ∫⁻ n : ℕ, ∫⁻ z : Fin n → X, ∫⁻ y, g (y, ∑ i, Measure.dirac (z i))
            ∂(∑ i, Measure.dirac (z i)) ∂Measure.pi (fun _ ↦ Q) ∂poissonMeasure r := by
      refine lintegral_congr fun n ↦ lintegral_congr fun z ↦ ?_
      exact hcut _ (measure_lt_top _ _)
    _ = (r : ℝ≥0∞) * ∫⁻ y, ∫⁻ n : ℕ, ∫⁻ z : Fin n → X,
          g (y, Measure.dirac y + ∑ i, Measure.dirac (z i))
            ∂Measure.pi (fun _ ↦ Q) ∂poissonMeasure r ∂Q :=
      Q.lintegral_finsetSum_dirac_poissonMeasure_pi r hg
    _ = _ := by
      have hscale : (∫⁻ y, ∫⁻ ω, g (y, η ω + Measure.dirac y) ∂P ∂Λ) =
          (r : ℝ≥0∞) * ∫⁻ y, ∫⁻ ω, g (y, η ω + Measure.dirac y) ∂P ∂Q := by
        calc
          _ = ∫⁻ y, ∫⁻ ω, g (y, η ω + Measure.dirac y) ∂P ∂((r : ℝ≥0∞) • Q) := by rw [hrQ]
          _ = _ := lintegral_smul_measure _ _
      rw [hscale]
      congr 1
      refine lintegral_congr fun y ↦ ?_
      let L (μ : Measure X) := g (y, Measure.dirac y + μ)
      have hL : Measurable L := hg.comp (measurable_const.prodMk
        (measurable_const.add measurable_id))
      rw [← lintegral_finitePoissonLaw_finPi r Q hL, ← hLaw, lintegral_map hL hη.measurable]
      simp only [L, add_comm]

/-- The void probability of a measurable set of finite Poisson intensity. -/
theorem measure_count_eq_zero_of_poisson {X : Type*} [MeasurableSpace X]
    {P : Measure Ω} {η : Ω → Measure X} {Λ : Measure X} (hη : IsPoissonRandomMeasure P η Λ)
    {B : Set X} (hB : MeasurableSet B) (hfin : Λ B < ⊤) :
    P {ω | η ω B = 0} = ENNReal.ofReal (Real.exp (-(Λ B).toReal)) := by
  have hL := hη.hasLaw hB hfin
  have hpre : (fun n : ℕ ↦ (n : ℝ≥0∞)) ⁻¹' {0} = ({0} : Set ℕ) := by
    ext n
    simp only [mem_preimage, mem_singleton_iff, Nat.cast_eq_zero]
  rw [show {ω | η ω B = 0} = (fun ω ↦ η ω B) ⁻¹' {0} from rfl,
    ← Measure.map_apply_of_aemeasurable hL.aemeasurable (measurableSet_singleton _),
    hL.map_eq, Measure.map_apply Measurable.of_discrete (measurableSet_singleton _), hpre,
    poissonMeasure_singleton]
  simp
  rfl

/-- The mean of a Poisson count on a measurable set of finite intensity. -/
theorem lintegral_poisson_count {X : Type*} [MeasurableSpace X] {P : Measure Ω}
    {η : Ω → Measure X} {Λ : Measure X} (hη : IsPoissonRandomMeasure P η Λ)
    {B : Set X} (hB : MeasurableSet B) (hfin : Λ B < ⊤) :
    ∫⁻ ω, η ω B ∂P = Λ B := by
  have hL := hη.hasLaw hB hfin
  calc
    _ = ∫⁻ v : ℝ≥0∞, v ∂(poissonMeasure (Λ B).toNNReal).map (Nat.cast : ℕ → ℝ≥0∞) :=
      hL.lintegral_comp measurable_id.aemeasurable
    _ = ∫⁻ n : ℕ, (n : ℝ≥0∞) ∂poissonMeasure (Λ B).toNNReal :=
      lintegral_map measurable_id Measurable.of_discrete
    _ = _ := (lintegral_natCast_poissonMeasure _).trans (ENNReal.coe_toNNReal hfin.ne)


/-- Translation of a finite measure, with zero returned when the total mass is infinite. -/
def translateFinitePart {d : ℕ} (y : EuclideanSpace ℝ (Fin d))
    (μ : Measure (EuclideanSpace ℝ (Fin d))) : Measure (EuclideanSpace ℝ (Fin d)) :=
  translate y (cutFiniteMeasure univ μ : Measure (EuclideanSpace ℝ (Fin d)))

/-- The finite-part translation depends measurably on the shift and the measure. -/
theorem measurable_translateFinitePart {d : ℕ} :
    Measurable (fun p : EuclideanSpace ℝ (Fin d) × Measure (EuclideanSpace ℝ (Fin d)) ↦
      translateFinitePart p.1 p.2) := by
  let E := EuclideanSpace ℝ (Fin d)
  have hm : Measurable (Function.uncurry (fun (y z : E) ↦ z - y)) := by fun_prop
  simpa only [translateFinitePart, translate_def, Function.comp_def] using
    (TauCeti.MeasureTheory.measurable_map_finiteMeasure_of_measurable_uncurry hm).comp
      (((measurable_cutFiniteMeasure MeasurableSet.univ).comp measurable_snd).prodMk measurable_fst)

/-- Finite-part translation agrees with translation for a finite measure. -/
lemma translateFinitePart_eq {d : ℕ} (y : EuclideanSpace ℝ (Fin d))
    {μ : Measure (EuclideanSpace ℝ (Fin d))} (hμ : μ univ < ∞) :
    translateFinitePart y μ = translate y μ := by
  simp only [translateFinitePart, coe_cutFiniteMeasure_of_ne_top hμ.ne, Measure.restrict_univ]

/-- Evaluate a translated measure on a measurable set. -/
lemma translate_apply_measurable {d : ℕ} (x : EuclideanSpace ℝ (Fin d))
    (μ : Measure (EuclideanSpace ℝ (Fin d))) {B : Set (EuclideanSpace ℝ (Fin d))}
    (hB : MeasurableSet B) : translate x μ B = μ ((fun z ↦ z - x) ⁻¹' B) := by
  have hm : Measurable (fun z : EuclideanSpace ℝ (Fin d) ↦ z - x) := by fun_prop
  rw [translate_def, Measure.map_apply hm hB]

/-- SYNOPSIS item 84, Slivnyak–Mecke theorem: a stationary point process with intensity
`γ ∈ (0, ∞)` and Palm distribution `P⁰` is a Poisson process if and only if `P⁰` is the law of
`η + δ_0`. -/
theorem isPoissonRandomMeasure_iff_palm {P : Measure Ω} [IsProbabilityMeasure P]
    {η : Ω → Measure (EuclideanSpace ℝ (Fin d))} (hηm : Measurable η)
    (hint : ∀ ω, (η ω).IsIntegerValued) (hst : IsStationary P η) (hγ0 : 0 < intensity P η)
    (hγ : intensity P η < ∞) {P₀ : Measure (Measure (EuclideanSpace ℝ (Fin d)))}
    [IsProbabilityMeasure P₀]
    (hP₀ : ∀ f : EuclideanSpace ℝ (Fin d) → Measure (EuclideanSpace ℝ (Fin d)) → ℝ≥0∞,
      Measurable (Function.uncurry f) →
      ∫⁻ ω, ∫⁻ x, f x (translate x (η ω)) ∂(η ω) ∂P = intensity P η * ∫⁻ x, ∫⁻ μ, f x μ ∂P₀) :
    IsPoissonRandomMeasure P η (intensity P η • volume) ↔
      P₀ = P.map fun ω ↦ η ω + Measure.dirac 0 := by
  sorry

/-- SYNOPSIS item 84, general form: a point process on a Polish space with locally finite
intensity measure `M` is a Poisson process if and only if `P_x` is the law of `η + δ_x` for
`M`-almost every `x`. -/
theorem isPoissonRandomMeasure_iff_palmKernel {X : Type*} [MeasurableSpace X]
    [TopologicalSpace X] [PolishSpace X] [BorelSpace X] {P : Measure Ω} [IsProbabilityMeasure P]
    {η : Ω → Measure X} (hηm : Measurable η) (hint : ∀ ω, (η ω).IsIntegerValued)
    [IsLocallyFiniteMeasure (P.bind η)] [SigmaFinite (P.bind η)] {Px : Kernel X (Measure X)}
    [IsMarkovKernel Px]
    (hPx : ∀ g : X → Measure X → ℝ≥0∞, Measurable (Function.uncurry g) →
      ∫⁻ ω, ∫⁻ x, g x (η ω) ∂(η ω) ∂P = ∫⁻ x, ∫⁻ μ, g x μ ∂Px x ∂P.bind η) :
    IsPoissonRandomMeasure P η (P.bind η) ↔
      ∀ᵐ x ∂P.bind η, Px x = P.map fun ω ↦ η ω + Measure.dirac x := by
  sorry

end MSSS
