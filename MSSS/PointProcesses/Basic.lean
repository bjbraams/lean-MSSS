/-!
# Point processes given by their points

Shared definitions for SYNOPSIS Part 4. A random measure on `X` is a map `η : Ω → Measure X`; the
measurable structure on `Measure X` is generated by the evaluations `μ ↦ μ B`. Factorial moment
measures are defined for point processes presented by their points,
`η = ∑_{n : I n} δ_{x_n}` with an index mask `I : ℕ → Bool`; the factorial measure `η^{(m)}` is
then the sum of `δ_{(x_{n_1}, …, x_{n_m})}` over distinct retained indices. A point process
with `η = ∑_{n < κ} δ_{X_n}` uses the mask `n < κ`. TauCeti supplies measurability of a countable
sum of measures and the criterion for measurability on a countable, generating cover.
The rectangle moment identities use Mathlib’s product measure and countable-sum identities.

## Main definitions

* `MSSS.pointSum I x`: the counting measure `∑_{n : I n} δ_{x_n}`.
* `MSSS.factorialPointSum m I x`: its factorial measure `η^{(m)}` on `Fin m → X`.
* `MSSS.finiteMask κ`: the mask `n < κ`.
* `MSSS.translate y μ`: the shifted measure `θ_y μ (B) = μ(B + y)` on `ℝ^d`.
* `MSSS.IsStationary P η`: the law of `θ_y η` does not depend on `y`.
* `MSSS.unitCube d`: the cube `[0, 1]^d`.
-/

public section

noncomputable section

open MeasureTheory Set Function
open scoped ENNReal

namespace MSSS

variable {X : Type*} [MeasurableSpace X]

/-- The counting measure `∑_{n : I n} δ_{x_n}` of the retained points. -/
def pointSum (I : ℕ → Bool) (x : ℕ → X) : Measure X :=
  Measure.sum fun n ↦ if I n then Measure.dirac (x n) else 0

/-- The factorial measure `η^{(m)} = ∑ δ_{(x_{n_1}, …, x_{n_m})}` over pairwise distinct retained
indices `n_1, …, n_m`. -/
def factorialPointSum (m : ℕ) (I : ℕ → Bool) (x : ℕ → X) : Measure (Fin m → X) :=
  Measure.sum fun n : {n : Fin m → ℕ // Function.Injective n} ↦
    if ∀ i, I (n.1 i) then Measure.dirac fun i ↦ x (n.1 i) else 0

/-- The mask `n < κ` of a point process `∑_{n < κ} δ_{X_n}`. -/
def finiteMask (κ : ℕ∞) (n : ℕ) : Bool :=
  decide ((n : ℕ∞) < κ)

lemma pointSum_def (I : ℕ → Bool) (x : ℕ → X) :
    pointSum I x = Measure.sum fun n ↦ if I n then Measure.dirac (x n) else 0 := by
  rw [pointSum]

lemma factorialPointSum_def (m : ℕ) (I : ℕ → Bool) (x : ℕ → X) :
    factorialPointSum m I x = Measure.sum fun n : {n : Fin m → ℕ // Function.Injective n} ↦
      if ∀ i, I (n.1 i) then Measure.dirac fun i ↦ x (n.1 i) else 0 := by
  rw [factorialPointSum]

lemma finiteMask_def (κ : ℕ∞) (n : ℕ) : finiteMask κ n = decide ((n : ℕ∞) < κ) := by
  rw [finiteMask]

/-- A point sum is measurable in its retention mask and locations. -/
lemma measurable_pointSum {M : Type*} [MeasurableSpace M] {I : M → ℕ → Bool}
    {x : M → ℕ → X} (hI : Measurable I) (hx : Measurable x) :
    Measurable (fun m ↦ pointSum (I m) (x m)) := by
  simp only [pointSum_def]
  apply TauCeti.MeasureTheory.measurable_measure_sum.comp
  apply Measurable.of_eval
  intro n
  refine Measurable.ite ?_ (Measure.measurable_dirac.comp ((measurable_pi_apply n).comp hx))
    measurable_const
  exact ((measurable_pi_apply n).comp hI) (measurableSet_singleton true)

/-- The factorial counting measure is measurable when the mask and locations are measurable. -/
lemma measurable_factorialPointSum {M : Type*} [MeasurableSpace M] (k : ℕ)
    {I : M → ℕ → Bool} {x : M → ℕ → X} (hI : Measurable I) (hx : Measurable x) :
    Measurable (fun m ↦ factorialPointSum k (I m) (x m)) := by
  simp only [factorialPointSum_def]
  apply TauCeti.MeasureTheory.measurable_measure_sum.comp
  apply Measurable.of_eval
  intro n
  refine Measurable.ite ?_ (Measure.measurable_dirac.comp
    (Measurable.of_eval fun i ↦ (measurable_pi_apply (n.1 i)).comp hx)) measurable_const
  rw [Set.ofPred_forall]
  exact MeasurableSet.iInter fun i ↦
    ((measurable_pi_apply (n.1 i)).comp hI) (measurableSet_singleton true)

/-- The truncating masks are jointly measurable in the count and the position. -/
lemma measurable_finiteMask : Measurable finiteMask := by
  apply Measurable.of_eval
  intro n
  exact Measurable.of_discrete

/-- A function on two coordinates is injective precisely when its two values differ. -/
lemma injective_fin_two_iff {α : Type*} (u : Fin 2 → α) : Injective u ↔ u 0 ≠ u 1 := by
  refine ⟨fun hi he ↦ Fin.zero_ne_one (hi he), ?_⟩
  intro hu i j hij
  fin_cases i <;> fin_cases j
  · rfl
  · exact (hu hij).elim
  · exact (hu hij.symm).elim
  · rfl

private theorem prod_pointSum_eq_map_sum (I : ℕ → Bool) (x : ℕ → X) :
    let b (u : Fin 2 → ℕ) : Measure (Fin 2 → X) :=
      if ∀ i, I (u i) then Measure.dirac (fun i ↦ x (u i)) else 0
    (pointSum I x).prod (pointSum I x) = (Measure.sum b).map MeasurableEquiv.finTwoArrow := by
  classical
  intro b
  let a (k : ℕ) := if I k then Measure.dirac (x k) else 0
  have ha (k : ℕ) : IsFiniteMeasure (a k) := by
    dsimp only [a]
    split <;> infer_instance
  let e : (Fin 2 → X) ≃ᵐ X × X := MeasurableEquiv.finTwoArrow
  rw [Measure.map_sum e.measurable.aemeasurable]
  have hd : (pointSum I x).prod (pointSum I x) =
      Measure.sum (fun p : ℕ × ℕ ↦ (a p.1).prod (a p.2)) :=
    Measure.prod_sum a a
  rw [hd]
  ext s hs
  simp only [Measure.sum_apply _ hs]
  let e' : (Fin 2 → ℕ) ≃ ℕ × ℕ := MeasurableEquiv.finTwoArrow.toEquiv
  rw [← e'.tsum_eq]
  refine tsum_congr fun u ↦ ?_
  have hr : (a (u 0)).prod (a (u 1)) = (b u).map e := by
    simp only [a, b, Fin.forall_fin_two]
    by_cases h0 : I (u 0)
    · by_cases h1 : I (u 1)
      · simp only [h0, h1, and_self, ↓reduceIte, Measure.dirac_prod_dirac,
          Measure.map_dirac' e.measurable]
        rfl
      · simp [h0, h1]
    · simp [h0]
  exact congrArg (fun μ : Measure (X × X) ↦ μ s) hr

/-- The two-fold product of a counting measure counts both distinct occurrences and the
diagonal contribution from choosing the same occurrence twice. -/
theorem prod_pointSum_eq_map_factorialPointSum_add_diagonal (I : ℕ → Bool) (x : ℕ → X) :
    (pointSum I x).prod (pointSum I x) =
      (factorialPointSum 2 I x + (pointSum I x).map (fun y _ ↦ y)).map
        MeasurableEquiv.finTwoArrow := by
  classical
  let b (u : Fin 2 → ℕ) : Measure (Fin 2 → X) :=
    if ∀ i, I (u i) then Measure.dirac (fun i ↦ x (u i)) else 0
  let e : (Fin 2 → X) ≃ᵐ X × X := MeasurableEquiv.finTwoArrow
  have hpi : (pointSum I x).prod (pointSum I x) = (Measure.sum b).map e :=
    prod_pointSum_eq_map_sum I x
  have happ : Measure.sum b =
      factorialPointSum 2 I x + (pointSum I x).map (fun y _ ↦ y) := by
    rw [← Measure.sum_add_sum_compl {u | Injective u} b]
    congr 1
    let diag : X → Fin 2 → X := fun y _ ↦ y
    have hdiag : Measurable diag := measurable_pi_iff.2 fun _ ↦ measurable_id
    rw [pointSum_def, Measure.map_sum hdiag.aemeasurable]
    ext s hs
    simp only [Measure.sum_apply _ hs]
    let E : ({u : Fin 2 → ℕ | Injective u}ᶜ : Set (Fin 2 → ℕ)) ≃ ℕ := {
      toFun := fun u ↦ u.1 0
      invFun := fun n ↦ ⟨fun _ ↦ n, by
        rw [Set.mem_compl_iff, Set.mem_ofPred_eq, injective_fin_two_iff]
        simp⟩
      left_inv := fun u ↦ Subtype.ext (funext (Fin.forall_fin_two.2 ⟨rfl, by
        simpa [Set.mem_compl_iff, injective_fin_two_iff] using u.2⟩))
      right_inv := fun _ ↦ rfl }
    rw [← E.tsum_eq]
    refine tsum_congr fun u ↦ ?_
    have h01 : u.1 0 = u.1 1 := by
      simpa only [Set.mem_compl_iff, Set.mem_ofPred_eq, injective_fin_two_iff, not_not] using u.2
    have heq : ∀ i : Fin 2, u.1 i = u.1 0 := Fin.forall_fin_two.2 ⟨rfl, h01.symm⟩
    by_cases hi : I (u.1 0)
    · simp [b, heq, hi, E, Measure.map_dirac' hdiag, diag]
    · simp [b, heq, hi, E]
  rw [hpi, happ]

/-- The two-point factorial count on a rectangle excludes one diagonal occurrence for each
point in the overlap. -/
lemma factorialPointSum_two_apply_prod_add (I : ℕ → Bool) (x : ℕ → X)
    {A B : Set X} (hA : MeasurableSet A) (hB : MeasurableSet B) :
    ((factorialPointSum 2 I x).map MeasurableEquiv.finTwoArrow) (A ×ˢ B) +
      pointSum I x (A ∩ B) = pointSum I x A * pointSum I x B := by
  have hs : SFinite (pointSum I x) := by
    rw [pointSum_def]
    have (n : ℕ) : IsFiniteMeasure (if I n then Measure.dirac (x n) else 0) := by
      split <;> infer_instance
    infer_instance
  let e : (Fin 2 → X) ≃ᵐ X × X := MeasurableEquiv.finTwoArrow
  let diag : X → Fin 2 → X := fun y _ ↦ y
  have hdiag : Measurable diag := measurable_pi_iff.2 fun _ ↦ measurable_id
  have hD : diag ⁻¹' (e ⁻¹' (A ×ˢ B)) = A ∩ B := rfl
  have h := congrArg (fun μ : Measure (X × X) ↦ μ (A ×ˢ B))
    (prod_pointSum_eq_map_factorialPointSum_add_diagonal I x)
  rw [Measure.prod_prod, Measure.map_apply e.measurable (hA.prod hB), add_apply,
    Measure.map_apply hdiag (e.measurable (hA.prod hB)), hD] at h
  rw [Measure.map_apply e.measurable (hA.prod hB), h]


omit [MeasurableSpace X] in
/-- Two truncations by the same increasing covering sequence cover a rectangle. -/
lemma iUnion_prod_inter_eq_prod {C : ℕ → Set X} (hmono : Monotone C)
    (hcover : ⋃ n, C n = univ) (A B : Set X) :
    (⋃ n, (A ∩ C n) ×ˢ (B ∩ C n)) = A ×ˢ B := by
  refine Set.Subset.antisymm (Set.iUnion_subset fun _ ↦ Set.prod_mono
    inter_subset_left inter_subset_left) ?_
  rintro ⟨x, y⟩ ⟨hx, hy⟩
  obtain ⟨n, hn⟩ : ∃ n, x ∈ C n := Set.mem_iUnion.mp (hcover ▸ Set.mem_univ x)
  obtain ⟨m, hm⟩ : ∃ m, y ∈ C m := Set.mem_iUnion.mp (hcover ▸ Set.mem_univ y)
  exact Set.mem_iUnion.mpr ⟨max n m, ⟨hx, hmono (le_max_left _ _) hn⟩,
    ⟨hy, hmono (le_max_right _ _) hm⟩⟩

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}

open Classical in
private theorem measurable_factorialPointSum_two_apply_prod (I : Ω → ℕ → Bool)
    (x : Ω → ℕ → X) (hm : Measurable (fun ω ↦ pointSum (I ω) (x ω)))
    {M : Set Ω} (hM : MeasurableSet M) {A B : Set X}
    (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hfin : ∀ ω ∈ M, pointSum (I ω) (x ω) (A ∩ B) < ⊤) :
    Measurable (fun ω ↦ (if ω ∈ M then (factorialPointSum 2 (I ω) (x ω)).map
      MeasurableEquiv.finTwoArrow else 0) (A ×ˢ B)) := by
  classical
  let η (ω : Ω) := pointSum (I ω) (x ω)
  let α (ω : Ω) := if ω ∈ M then (factorialPointSum 2 (I ω) (x ω)).map
    MeasurableEquiv.finTwoArrow else 0
  change Measurable fun ω ↦ α ω (A ×ˢ B)
  have heq (ω : Ω) : α ω (A ×ˢ B) =
      if ω ∈ M then η ω A * η ω B - η ω (A ∩ B) else 0 := by
    by_cases hw : ω ∈ M
    · simp only [α, ite_eq_left hw]
      exact ENNReal.eq_sub_of_add_eq (hfin ω hw).ne
        (factorialPointSum_two_apply_prod_add _ _ hA hB)
    · simp only [α, ite_eq_right hw, FunLike.coe_zero, Pi.zero_apply]
  simp_rw [heq]
  exact Measurable.ite hM
    ((((Measure.measurable_coe hA).comp hm).mul ((Measure.measurable_coe hB).comp hm)).sub
      ((Measure.measurable_coe (hA.inter hB)).comp hm)) measurable_const

/-- Measurability of the point sum gives almost-everywhere measurability of its second
factorial measure when the point sum is almost surely finite on a fixed covering sequence. -/
theorem aemeasurable_factorialPointSum_two_of_cover (I : Ω → ℕ → Bool) (x : Ω → ℕ → X)
    (hm : Measurable (fun ω ↦ pointSum (I ω) (x ω))) {C : ℕ → Set X}
    (hC : ∀ n, MeasurableSet (C n)) (hmono : Monotone C) (hcover : ⋃ n, C n = univ)
    (hfin : ∀ᵐ ω ∂P, ∀ n, pointSum (I ω) (x ω) (C n) < ⊤) :
    AEMeasurable (fun ω ↦ factorialPointSum 2 (I ω) (x ω)) P := by
  classical
  let M := {ω | ∀ n, pointSum (I ω) (x ω) (C n) < ⊤}
  have hM : MeasurableSet M := by
    simp only [M, Set.ofPred_forall]
    exact MeasurableSet.iInter (fun n ↦
      ((Measure.measurable_coe (hC n)).comp hm) measurableSet_Iio)
  let e : (Fin 2 → X) ≃ᵐ X × X := MeasurableEquiv.finTwoArrow
  let α (ω : Ω) := if ω ∈ M then (factorialPointSum 2 (I ω) (x ω)).map e else 0
  have hα (A B : Set X) (hA : MeasurableSet A) (hB : MeasurableSet B) (n : ℕ) :
      Measurable (fun ω ↦ α ω ((A ∩ C n) ×ˢ (B ∩ C n))) :=
    measurable_factorialPointSum_two_apply_prod I x hm hM (hA.inter (hC n)) (hB.inter (hC n))
      (fun ω hw ↦ (measure_mono (Set.inter_subset_left.trans Set.inter_subset_right)).trans_lt
        (hw n))
  have hbox (A B : Set X) (hA : MeasurableSet A) (hB : MeasurableSet B) :
      Measurable (fun ω ↦ α ω (A ×ˢ B)) := by
    have hh (ω : Ω) : α ω (A ×ˢ B) = ⨆ n, α ω ((A ∩ C n) ×ˢ (B ∩ C n)) := by
      rw [← iUnion_prod_inter_eq_prod hmono hcover A B]
      exact (show Monotone (fun n ↦ (A ∩ C n) ×ˢ (B ∩ C n)) from
        fun _ _ hij ↦ Set.prod_mono (Set.inter_subset_inter_right _ (hmono hij))
          (Set.inter_subset_inter_right _ (hmono hij))).measure_iUnion
    simp_rw [hh]
    exact Measurable.iSup (hα A B hA hB)
  have hαm : Measurable α := by
    refine Measurable.measure_of_isPiSystem_of_iUnion (B := fun n ↦ C n ×ˢ C n)
      generateFrom_prod.symm isPiSystem_prod (fun n ↦ ⟨C n, hC n, C n, hC n, rfl⟩) ?_ ?_ ?_
    · simpa only [univ_inter, univ_prod_univ] using
        iUnion_prod_inter_eq_prod hmono hcover univ univ
    · intro ω n
      by_cases hw : ω ∈ M
      · simp only [α, ite_eq_left hw]
        have heq := factorialPointSum_two_apply_prod_add (I ω) (x ω) (hC n) (hC n)
        refine ne_top_of_le_ne_top (ENNReal.mul_lt_top (hw n) (hw n)).ne ?_
        exact le_of_le_of_eq (le_add_right le_rfl) heq
      · simp only [α, ite_eq_right hw, FunLike.coe_zero, Pi.zero_apply]
        exact ENNReal.zero_ne_top
    · rintro s ⟨A, hA, B, hB, rfl⟩
      exact hbox A B hA hB
  refine ((Measure.measurable_map e.symm e.symm.measurable).comp hαm).aemeasurable.congr ?_
  filter_upwards [hfin] with ω hw
  simp only [Function.comp_apply, α, ite_eq_left (show ω ∈ M from hw),
    Measure.map_map e.symm.measurable e.measurable, MeasurableEquiv.symm_comp_self, Measure.map_id]


section Euclidean

variable {d : ℕ}

/-- The shifted measure `θ_y μ`, `θ_y μ (B) = μ(B + y)`. -/
def translate (y : EuclideanSpace ℝ (Fin d)) (μ : Measure (EuclideanSpace ℝ (Fin d))) :
    Measure (EuclideanSpace ℝ (Fin d)) :=
  μ.map fun x ↦ x - y

/-- A random measure on `ℝ^d` is **stationary** when `θ_y η` has the law of `η` for every `y`. -/
def IsStationary {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (η : Ω → Measure (EuclideanSpace ℝ (Fin d))) : Prop :=
  ∀ y, P.map (fun ω ↦ translate y (η ω)) = P.map η

/-- The unit cube `[0, 1]^d`. -/
def unitCube (d : ℕ) : Set (EuclideanSpace ℝ (Fin d)) :=
  {x | ∀ i, WithLp.ofLp x i ∈ Icc (0 : ℝ) 1}

lemma translate_def (y : EuclideanSpace ℝ (Fin d)) (μ : Measure (EuclideanSpace ℝ (Fin d))) :
    translate y μ = μ.map fun x ↦ x - y := by
  rw [translate]

lemma isStationary_def {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {η : Ω → Measure (EuclideanSpace ℝ (Fin d))} :
    IsStationary P η ↔ ∀ y, P.map (fun ω ↦ translate y (η ω)) = P.map η := Iff.rfl

lemma unitCube_def (d : ℕ) :
    unitCube d = {x : EuclideanSpace ℝ (Fin d) | ∀ i, WithLp.ofLp x i ∈ Icc (0 : ℝ) 1} := by
  rw [unitCube]

end Euclidean

end MSSS
