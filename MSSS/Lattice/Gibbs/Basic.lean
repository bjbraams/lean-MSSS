/-!
# Gibbs specifications and tail measures

This module defines finite-region specifications and Gibbs measures on a product of state spaces.
A Gibbs measure is a probability measure satisfying the DLR equations for every finite region.
The tail σ-algebra is the intersection of the exterior σ-algebras of the finite regions.

For the extreme Gibbs measure results of SYNOPSIS item 61, Mathlib provides Radon–Nikodym
derivatives of trimmed measures, finite exhaustions of countable sets, and measurable liminf.
Each exterior version of the density uses countably many coordinates. A countable closure
contains the coordinates used by the versions along its own finite exhaustion.

## Main definitions

* `MSSS.outsideSigma` and `MSSS.tailSigma`, the exterior and tail σ-algebras.
* `MSSS.IsSpecification`, `MSSS.IsGibbs`, and `MSSS.gibbsSet`.
* `MSSS.IsPotential`, `MSSS.IsAbsolutelySummable`, `MSSS.hamiltonian`, and `MSSS.gibbsKernel`.
* `MSSS.IsLocalFunction`, `MSSS.TendstoLocally`, and `MSSS.IsExtremeGibbs`.

## Main results

* `MSSS.isGibbs_iff_tail_density`.
* `MSSS.eq_of_isGibbs_of_tail_eq`.
* `MSSS.isExtremeGibbs_iff_tail_trivial`.
* `MSSS.exists_tail_mutuallySingular`.
-/

public section

noncomputable section

open MeasureTheory Filter Topology Set
open scoped ENNReal

namespace MSSS

variable {S E : Type*} [MeasurableSpace E]

/-- The σ-algebra `𝒯_Λ` generated by the coordinates outside `Λ`. -/
@[instance_reducible]
def outsideSigma (Λ : Set S) : MeasurableSpace (S → E) :=
  MeasurableSpace.comap (fun (ω : S → E) (j : ↥Λᶜ) ↦ ω j) inferInstance

/-- The **tail σ-algebra** `𝒯 = ⋂_Λ 𝒯_Λ`, over finite `Λ`. -/
@[instance_reducible]
def tailSigma : MeasurableSpace (S → E) :=
  ⨅ Λ : Finset S, outsideSigma (Λ : Set S)

lemma outsideSigma_def (Λ : Set S) : (outsideSigma Λ : MeasurableSpace (S → E)) =
    MeasurableSpace.comap (fun (ω : S → E) (j : ↥Λᶜ) ↦ ω j) inferInstance := by
  rw [outsideSigma]

lemma tailSigma_def : (tailSigma : MeasurableSpace (S → E)) =
    ⨅ Λ : Finset S, outsideSigma (Λ : Set S) := by
  rw [tailSigma]

/-- A **specification**: probability measures `γ Λ ω` that are `𝒯_Λ`-measurable in `ω`, proper,
and consistent (`γ_Δ γ_Λ = γ_Δ` for `Λ ⊆ Δ`). -/
structure IsSpecification (γ : Finset S → (S → E) → Measure (S → E)) : Prop where
  /-- Each `γ Λ ω` is a probability measure. -/
  isProbabilityMeasure : ∀ Λ ω, IsProbabilityMeasure (γ Λ ω)
  /-- `ω ↦ γ Λ ω A` is `𝒯_Λ`-measurable. -/
  measurable : ∀ (Λ : Finset S) A, MeasurableSet A →
    Measurable[outsideSigma (Λ : Set S)] fun ω ↦ γ Λ ω A
  /-- Properness: `γ Λ ω B = 𝟙_B(ω)` for `B ∈ 𝒯_Λ`. -/
  proper : ∀ (Λ : Finset S) B, MeasurableSet[outsideSigma (Λ : Set S)] B → ∀ ω,
    γ Λ ω B = B.indicator 1 ω
  /-- Consistency: `γ_Δ γ_Λ = γ_Δ` for `Λ ⊆ Δ`. -/
  consistent : ∀ Λ Δ, Λ ⊆ Δ → ∀ ω A, MeasurableSet A →
    ∫⁻ ω', γ Λ ω' A ∂(γ Δ ω) = γ Δ ω A

/-- `μ` is a **Gibbs measure** for `γ`: a probability measure satisfying the DLR equations
`μ γ_Λ = μ` for every finite `Λ`. -/
def IsGibbs (γ : Finset S → (S → E) → Measure (S → E)) (μ : Measure (S → E)) : Prop :=
  IsProbabilityMeasure μ ∧ ∀ Λ A, MeasurableSet A → μ A = ∫⁻ ω, γ Λ ω A ∂μ

/-- The set `𝒢(γ)` of Gibbs measures. -/
def gibbsSet (γ : Finset S → (S → E) → Measure (S → E)) : Set (Measure (S → E)) :=
  {μ | IsGibbs γ μ}

lemma isGibbs_def {γ : Finset S → (S → E) → Measure (S → E)} {μ : Measure (S → E)} :
    IsGibbs γ μ ↔ IsProbabilityMeasure μ ∧ ∀ Λ A, MeasurableSet A →
      μ A = ∫⁻ ω, γ Λ ω A ∂μ := Iff.rfl

lemma mem_gibbsSet {γ : Finset S → (S → E) → Measure (S → E)} {μ : Measure (S → E)} :
    μ ∈ gibbsSet γ ↔ IsGibbs γ μ := Iff.rfl

/-! ### Gibbsian specifications -/

/-- `Φ` is a **potential**: each `Φ A` is measurable and depends only on the coordinates in
`A`. -/
def IsPotential (Φ : Finset S → (S → E) → ℝ) : Prop :=
  ∀ A, Measurable (Φ A) ∧ ∀ ω ω', (∀ j ∈ A, ω j = ω' j) → Φ A ω = Φ A ω'

/-- `Φ` is **absolutely summable**: `∑_{A ∋ i} sup |Φ_A| < ∞` for every site `i`. -/
def IsAbsolutelySummable (Φ : Finset S → (S → E) → ℝ) : Prop :=
  ∀ i, ∑' A : {A : Finset S // i ∈ A}, ⨆ ω, ENNReal.ofReal |Φ A ω| < ⊤

/-- The **Hamiltonian** `H_Λ = ∑_{A ∩ Λ ≠ ∅} Φ_A`. -/
def hamiltonian (Φ : Finset S → (S → E) → ℝ) (Λ : Finset S) (ω : S → E) : ℝ :=
  ∑' A : {A : Finset S // ¬ Disjoint A Λ}, Φ A ω

/-- The configuration equal to `ζ` on `Λ` and to `ω` off `Λ`. -/
def splice [DecidableEq S] (Λ : Finset S) (ζ : Λ → E) (ω : S → E) : S → E :=
  fun s ↦ if h : s ∈ Λ then ζ ⟨s, h⟩ else ω s

/-- The **Gibbsian specification**
`γ^Φ_Λ(A ∣ ω) = Z_Λ(ω)⁻¹ ∫ 𝟙_A(ζ ω_{S∖Λ}) e^{-H_Λ(ζ ω_{S∖Λ})} ρ^Λ(dζ)` for the a priori
measure `ρ`. -/
def gibbsKernel [DecidableEq S] (Φ : Finset S → (S → E) → ℝ) (ρ : Measure E) [SigmaFinite ρ]
    (Λ : Finset S) (ω : S → E) : Measure (S → E) :=
  (((Measure.pi fun _ : Λ ↦ ρ).withDensity fun ζ ↦
      ENNReal.ofReal (Real.exp (-hamiltonian Φ Λ (splice Λ ζ ω)))) univ)⁻¹ •
    ((Measure.pi fun _ : Λ ↦ ρ).withDensity fun ζ ↦
      ENNReal.ofReal (Real.exp (-hamiltonian Φ Λ (splice Λ ζ ω)))).map (splice Λ · ω)

lemma isPotential_def {Φ : Finset S → (S → E) → ℝ} : IsPotential Φ ↔
    ∀ A, Measurable (Φ A) ∧ ∀ ω ω', (∀ j ∈ A, ω j = ω' j) → Φ A ω = Φ A ω' := Iff.rfl

omit [MeasurableSpace E] in
lemma isAbsolutelySummable_def {Φ : Finset S → (S → E) → ℝ} : IsAbsolutelySummable Φ ↔
    ∀ i, ∑' A : {A : Finset S // i ∈ A}, ⨆ ω, ENNReal.ofReal |Φ A ω| < ⊤ := Iff.rfl

omit [MeasurableSpace E] in
lemma hamiltonian_def (Φ : Finset S → (S → E) → ℝ) (Λ : Finset S) (ω : S → E) :
    hamiltonian Φ Λ ω = ∑' A : {A : Finset S // ¬ Disjoint A Λ}, Φ A ω := by
  rw [hamiltonian]

omit [MeasurableSpace E] in
lemma splice_def [DecidableEq S] (Λ : Finset S) (ζ : Λ → E) (ω : S → E) :
    splice Λ ζ ω = fun s ↦ if h : s ∈ Λ then ζ ⟨s, h⟩ else ω s := by
  funext s
  rw [splice]

lemma gibbsKernel_def [DecidableEq S] (Φ : Finset S → (S → E) → ℝ) (ρ : Measure E)
    [SigmaFinite ρ] (Λ : Finset S) (ω : S → E) : gibbsKernel Φ ρ Λ ω =
      (((Measure.pi fun _ : Λ ↦ ρ).withDensity fun ζ ↦
          ENNReal.ofReal (Real.exp (-hamiltonian Φ Λ (splice Λ ζ ω)))) univ)⁻¹ •
        ((Measure.pi fun _ : Λ ↦ ρ).withDensity fun ζ ↦
          ENNReal.ofReal (Real.exp (-hamiltonian Φ Λ (splice Λ ζ ω)))).map (splice Λ · ω) := by
  rw [gibbsKernel]

/-- A **local function** depends on finitely many coordinates. -/
def IsLocalFunction (f : (S → E) → ℝ) : Prop :=
  ∃ Δ : Finset S, ∀ ω ω', (∀ j ∈ Δ, ω j = ω' j) → f ω = f ω'

/-- **Local convergence** of measures along a filter: `∫ f dμ_a → ∫ f dμ` for every bounded
measurable local function `f`. -/
def TendstoLocally {α : Type*} (F : Filter α) (μs : α → Measure (S → E))
    (μ : Measure (S → E)) : Prop :=
  ∀ f : (S → E) → ℝ, IsLocalFunction f → Measurable f → (∃ C, ∀ ω, |f ω| ≤ C) →
    Tendsto (fun a ↦ ∫ ω, f ω ∂μs a) F (𝓝 (∫ ω, f ω ∂μ))

omit [MeasurableSpace E] in
lemma isLocalFunction_def {f : (S → E) → ℝ} : IsLocalFunction f ↔
    ∃ Δ : Finset S, ∀ ω ω', (∀ j ∈ Δ, ω j = ω' j) → f ω = f ω' := Iff.rfl

lemma tendstoLocally_def {α : Type*} {F : Filter α} {μs : α → Measure (S → E)}
    {μ : Measure (S → E)} : TendstoLocally F μs μ ↔
      ∀ f : (S → E) → ℝ, IsLocalFunction f → Measurable f → (∃ C, ∀ ω, |f ω| ≤ C) →
        Tendsto (fun a ↦ ∫ ω, f ω ∂μs a) F (𝓝 (∫ ω, f ω ∂μ)) := Iff.rfl

/-! ### Extreme Gibbs measures (SYNOPSIS item 61) -/

/-- `μ` is an **extreme** element of `𝒢(γ)`: it is not a proper convex combination of two other
Gibbs measures. -/
def IsExtremeGibbs (γ : Finset S → (S → E) → Measure (S → E)) (μ : Measure (S → E)) : Prop :=
  IsGibbs γ μ ∧ ∀ ν₁ ν₂, IsGibbs γ ν₁ → IsGibbs γ ν₂ → ∀ t : ℝ, 0 < t → t < 1 →
    μ = ENNReal.ofReal t • ν₁ + ENNReal.ofReal (1 - t) • ν₂ → ν₁ = μ

lemma isExtremeGibbs_def {γ : Finset S → (S → E) → Measure (S → E)} {μ : Measure (S → E)} :
    IsExtremeGibbs γ μ ↔ IsGibbs γ μ ∧ ∀ ν₁ ν₂, IsGibbs γ ν₁ → IsGibbs γ ν₂ → ∀ t : ℝ,
      0 < t → t < 1 → μ = ENNReal.ofReal t • ν₁ + ENNReal.ofReal (1 - t) • ν₂ → ν₁ = μ :=
  Iff.rfl

/-- Conditioning on the coordinates outside a smaller set gives a finer sigma-algebra. -/
lemma outsideSigma_anti : Antitone (outsideSigma (S := S) (E := E)) := by
  intro Λ Δ h
  rw [outsideSigma_def, outsideSigma_def]
  let f (u : ↥Λᶜ → E) (s : ↥Δᶜ) := u ⟨s, fun hs ↦ s.2 (h hs)⟩
  exact MeasurableSpace.comap_le_comap_of_eq_comp f
    (Measurable.of_eval fun _ ↦ measurable_pi_apply _) rfl

/-- The exterior sigma-algebra is contained in the product sigma-algebra. -/
lemma outsideSigma_le (Λ : Set S) :
    outsideSigma (E := E) Λ ≤ (inferInstance : MeasurableSpace (S → E)) :=
  (Measurable.of_eval (f := fun (ω : S → E) (s : ↥Λᶜ) ↦ ω s)
    fun _ ↦ measurable_pi_apply _).comap_le

/-- The tail sigma-algebra is contained in every exterior sigma-algebra. -/
lemma tailSigma_le_outsideSigma (Λ : Finset S) :
    tailSigma (E := E) ≤ outsideSigma (Λ : Set S) :=
  iInf_le _ Λ

/-- The tail sigma-algebra is contained in the product sigma-algebra. -/
lemma tailSigma_le :
    tailSigma (S := S) (E := E) ≤ (inferInstance : MeasurableSpace (S → E)) :=
  (tailSigma_le_outsideSigma (∅ : Finset S)).trans (outsideSigma_le _)

/-- A specification keeps exterior events fixed, including when intersected with another
measurable event. -/
private lemma IsSpecification.apply_inter_outside {γ : Finset S → (S → E) → Measure (S → E)}
    (hγ : IsSpecification γ) (Λ : Finset S) (ω : S → E) {A B : Set (S → E)}
    (hA : MeasurableSet A) (hB : MeasurableSet[outsideSigma (Λ : Set S)] B) :
    γ Λ ω (A ∩ B) = B.indicator (fun x ↦ γ Λ x A) ω := by
  let _ := hγ.isProbabilityMeasure Λ ω
  have h := hγ.proper Λ B hB ω
  by_cases ho : ω ∈ B
  · rw [indicator_of_mem ho] at h ⊢
    rw [inter_comm]
    simpa only [univ_inter] using (γ Λ ω).measure_inter_eq_of_measure_eq hA
      (h.trans measure_univ.symm) (subset_univ B) (measure_ne_top _ _)
  · rw [indicator_of_notMem ho] at h ⊢
    exact measure_mono_null inter_subset_right h

/-- Under a Gibbs measure, a specification's conditional probability integrates over an
exterior event to the joint probability. -/
private lemma IsGibbs.lintegral_spec_restrict {γ : Finset S → (S → E) → Measure (S → E)}
    (hγ : IsSpecification γ) {μ : Measure (S → E)} (hμ : IsGibbs γ μ)
    (Λ : Finset S) {A B : Set (S → E)} (hA : MeasurableSet A)
    (hB : MeasurableSet[outsideSigma (Λ : Set S)] B) :
    (∫⁻ x in B, γ Λ x A ∂μ) = μ (A ∩ B) := by
  have hm := outsideSigma_le (E := E) (Λ : Set S) B hB
  rw [hμ.2 Λ (A ∩ B) (hA.inter hm), ← lintegral_indicator hm]
  exact lintegral_congr fun x ↦ (hγ.apply_inter_outside Λ x hA hB).symm

/-- Under a Gibbs measure, multiplying the conditional probability by an exterior-measurable
weight gives the weighted measure of the event. -/
private lemma IsGibbs.lintegral_spec_mul {γ : Finset S → (S → E) → Measure (S → E)}
    (hγ : IsSpecification γ) {μ : Measure (S → E)} (hμ : IsGibbs γ μ)
    (Λ : Finset S) {A : Set (S → E)} (hA : MeasurableSet A)
    {g : (S → E) → ℝ≥0∞} (hg : Measurable[outsideSigma (Λ : Set S)] g) :
    (∫⁻ x, g x * γ Λ x A ∂μ) = ∫⁻ x in A, g x ∂μ := by
  let hm := outsideSigma_le (E := E) (Λ : Set S)
  have he : (μ.withDensity (fun x ↦ γ Λ x A)).trim hm = (μ.restrict A).trim hm := by
    refine @Measure.ext _ (outsideSigma (Λ : Set S)) _ _ fun B hB ↦ ?_
    rw [trim_measurableSet_eq hm hB, trim_measurableSet_eq hm hB, withDensity_apply _ (hm B hB),
      Measure.restrict_apply (hm B hB), hμ.lintegral_spec_restrict hγ Λ hA hB, inter_comm]
  calc
    (∫⁻ x, g x * γ Λ x A ∂μ) = ∫⁻ x, g x ∂μ.withDensity (fun x ↦ γ Λ x A) := by
      rw [lintegral_withDensity_eq_lintegral_mul _ ((hγ.measurable Λ A hA).mono hm le_rfl)
        (hg.mono hm le_rfl)]
      simp only [Pi.mul_apply, mul_comm]
    _ = ∫⁻ x, g x ∂(μ.withDensity (fun x ↦ γ Λ x A)).trim hm := (lintegral_trim hm hg).symm
    _ = ∫⁻ x in A, g x ∂μ := by rw [he, lintegral_trim hm hg]

/-- A probability density measurable in the tail of a Gibbs measure gives another Gibbs measure. -/
private lemma IsGibbs.withDensity_of_measurable_tail
    {γ : Finset S → (S → E) → Measure (S → E)} (hγ : IsSpecification γ)
    {μ : Measure (S → E)} (hμ : IsGibbs γ μ) {g : (S → E) → ℝ≥0∞}
    (hg : Measurable[tailSigma] g) [IsProbabilityMeasure (μ.withDensity g)] :
    IsGibbs γ (μ.withDensity g) := by
  refine ⟨inferInstance, fun Λ A hA ↦ ?_⟩
  rw [withDensity_apply _ hA, lintegral_withDensity_eq_lintegral_mul _
    (hg.mono tailSigma_le le_rfl)
    ((hγ.measurable Λ A hA).mono (outsideSigma_le _) le_rfl)]
  exact (hμ.lintegral_spec_mul hγ Λ hA (hg.mono (tailSigma_le_outsideSigma Λ) le_rfl)).symm

/-- The exterior restriction of a Gibbs measure relative to another Gibbs measure has a
Radon–Nikodym derivative that also represents the full relative density. -/
private lemma IsGibbs.exists_withDensity_outside
    {γ : Finset S → (S → E) → Measure (S → E)} (hγ : IsSpecification γ)
    {μ ν : Measure (S → E)} (hμ : IsGibbs γ μ) (hν : IsGibbs γ ν) (hνμ : ν ≪ μ) (Λ : Finset S) :
    ∃ g : (S → E) → ℝ≥0∞, Measurable[outsideSigma (Λ : Set S)] g ∧ ν = μ.withDensity g := by
  let _ := hμ.1
  let _ := hν.1
  let hm := outsideSigma_le (E := E) (Λ : Set S)
  let g := (ν.trim hm).rnDeriv (μ.trim hm)
  have hg : Measurable[outsideSigma (Λ : Set S)] g := Measure.measurable_rnDeriv _ _
  refine ⟨g, hg, ?_⟩
  ext A hA
  have hkernel := hγ.measurable Λ A hA
  calc
    ν A = ∫⁻ x, γ Λ x A ∂ν := hν.2 Λ A hA
    _ = ∫⁻ x, γ Λ x A ∂ν.trim hm := (lintegral_trim hm hkernel).symm
    _ = ∫⁻ x, g x * γ Λ x A ∂μ.trim hm := by
      rw [← Measure.withDensity_rnDeriv_eq (ν.trim hm) (μ.trim hm) (hνμ.trim hm)]
      exact lintegral_withDensity_eq_lintegral_mul _ hg hkernel
    _ = ∫⁻ x, g x * γ Λ x A ∂μ := lintegral_trim hm (hg.mul hkernel)
    _ = (μ.withDensity g) A := by rw [withDensity_apply _ hA, hμ.lintegral_spec_mul hγ Λ hA hg]

/-- A measurable function of exterior coordinates agrees on configurations agreeing there. -/
lemma eq_of_measurable_outsideSigma {Y : Type*} [MeasurableSpace Y]
    [MeasurableSingletonClass Y] {Λ : Set S} {f : (S → E) → Y}
    (hf : Measurable[outsideSigma Λ] f) {x y : S → E} (hxy : ∀ j ∈ Λᶜ, x j = y j) :
    f x = f y := by
  have hs := hf (measurableSet_singleton (f x))
  rw [outsideSigma_def, MeasurableSpace.measurableSet_comap] at hs
  obtain ⟨T, _, hT⟩ := hs
  have h : (fun j : ↥Λᶜ ↦ x j) = fun j : ↥Λᶜ ↦ y j :=
    funext fun j ↦ hxy j j.2
  have hx : x ∈ f ⁻¹' {f x} := mem_singleton _
  rw [← hT] at hx
  have hy : y ∈ f ⁻¹' {f x} := by
    rw [← hT]
    rw [mem_preimage] at hx ⊢
    rwa [h] at hx
  exact hy.symm

/-- A product-measurable function constant on every exterior fibre is exterior-measurable. -/
lemma measurable_outsideSigma_of_eq {Y : Type*} [MeasurableSpace Y]
    {Λ : Set S} {f : (S → E) → Y} (a : S → E) (hf : Measurable f)
    (he : ∀ x y : S → E, (∀ j ∈ Λᶜ, x j = y j) → f x = f y) :
    Measurable[outsideSigma Λ] f := by
  classical
  let p (w : S → E) (j : ↥Λᶜ) := w j
  let e (v : ↥Λᶜ → E) (j : S) := if hj : j ∈ Λᶜ then v ⟨j, hj⟩ else a j
  have hme : Measurable e := Measurable.of_eval fun j ↦ by
    by_cases hj : j ∈ Λᶜ
    · simpa only [e, dite_eq_left hj] using measurable_pi_apply (⟨j, hj⟩ : ↥Λᶜ)
    · simpa only [e, dite_eq_right hj] using measurable_const (a := a j)
  have hmp : Measurable[outsideSigma Λ] p := comap_measurable p
  have hfe : f = f ∘ e ∘ p := by
    funext x
    apply he
    intro j hj
    simp only [Function.comp_apply, e, dite_eq_left hj, p]
  rw [hfe]
  exact hf.comp (hme.comp hmp)

/-- A measurable product event uses at most countably many coordinates. -/
private lemma measurableSet_exists_countable_coordinates {A : Set (S → E)} (hA : MeasurableSet A) :
    ∃ J : Set S, J.Countable ∧ MeasurableSet[outsideSigma Jᶜ] A := by
  rw [MeasurableSpace.pi, MeasurableSpace.measurableSet_iSup] at hA
  induction hA with
  | basic A hA =>
    obtain ⟨i, hi⟩ := hA
    let J : Set S := {i}
    let p (ω : S → E) (j : ↥Jᶜᶜ) := ω j
    have hip : i ∈ Jᶜᶜ := by simp only [compl_compl, J, mem_singleton_iff]
    have hm : Measurable[outsideSigma Jᶜ] (fun ω : S → E ↦ ω i) :=
      (measurable_pi_apply (⟨i, hip⟩ : ↥Jᶜᶜ)).comp (comap_measurable p)
    exact ⟨J, countable_singleton i, hm.comap_le A hi⟩
  | empty => exact ⟨∅, countable_empty, @MeasurableSet.empty _ (outsideSigma _)⟩
  | compl A _ ih =>
    obtain ⟨J, hJ, h⟩ := ih
    exact ⟨J, hJ, h.compl⟩
  | iUnion A _ ih =>
    choose J hJ hm using ih
    let I := ⋃ n, J n
    exact ⟨I, countable_iUnion hJ, MeasurableSet.iUnion fun n ↦
      outsideSigma_anti (compl_subset_compl.mpr (subset_iUnion J n)) _ (hm n)⟩

/-- An extended-real measurable function on a product uses at most countably many coordinates. -/
private lemma measurable_exists_countable_coordinates {f : (S → E) → ℝ≥0∞} (hf : Measurable f) :
    ∃ J : Set S, J.Countable ∧ Measurable[outsideSigma Jᶜ] f := by
  let T := MeasurableSpace.countableGeneratingSet ℝ≥0∞
  let _ : Countable T := MeasurableSpace.countable_countableGeneratingSet.to_subtype
  choose J hJ hm using fun s : T ↦ measurableSet_exists_countable_coordinates
    (hf (MeasurableSpace.measurableSet_countableGeneratingSet s.2))
  let I := ⋃ s : T, J s
  refine ⟨I, countable_iUnion hJ, ?_⟩
  let _ : MeasurableSpace (S → E) := outsideSigma (E := E) Iᶜ
  rw [← MeasurableSpace.generateFrom_countableGeneratingSet (α := ℝ≥0∞)]
  exact measurable_generateFrom fun s hs ↦
    outsideSigma_anti (compl_subset_compl.mpr (subset_iUnion J ⟨s, hs⟩)) _ (hm ⟨s, hs⟩)

/-- A finite subset of an increasing union occurs in one member of the union. -/
lemma exists_finset_subset_of_subset_iUnion_nat {U : ℕ → Set S} (hU : Monotone U)
    {T : Finset S} (hT : (T : Set S) ⊆ ⋃ n, U n) : ∃ n, (T : Set S) ⊆ U n := by
  classical
  have h : ∀ j ∈ T, ∀ᶠ n in atTop, j ∈ U n := by
    intro j hj
    obtain ⟨n, hn⟩ := mem_iUnion.mp (hT hj)
    exact eventually_atTop.mpr ⟨n, fun k hk ↦ hU hk hn⟩
  exact ((eventually_all_finset T).mpr h).exists

/-- There is a countable set of coordinates closed under adjoining the countable set assigned
to each of its finite subsets. -/
lemma exists_countable_closed_finset_family (J : Finset S → Set S)
    (hJ : ∀ T, (J T).Countable) :
    ∃ U : Set S, U.Countable ∧ ∀ T : Finset S, (T : Set S) ⊆ U → J T ⊆ U := by
  classical
  let a (K : Set S) := K ∪ ⋃ T : Finset ↥K, J (T.image Subtype.val)
  let U : ℕ → Set S := Nat.rec ∅ fun _ K ↦ a K
  have hU (n : ℕ) : U (n + 1) = a (U n) := rfl
  have hc (n : ℕ) : (U n).Countable := by
    induction n with
    | zero => exact countable_empty
    | succ n ih =>
      rw [hU]
      let _ : Countable (Finset ↥(U n)) := @Finset.countable ↥(U n) ih.to_subtype
      have hu : (⋃ T : Finset ↥(U n), J (T.image Subtype.val)).Countable :=
        countable_iUnion fun T : Finset ↥(U n) ↦ hJ (T.image Subtype.val)
      exact ih.union hu
  have hm : Monotone U := monotone_nat_of_le_succ fun n ↦ by
    rw [hU]
    exact subset_union_left
  refine ⟨⋃ n, U n, countable_iUnion hc, fun T hT ↦ ?_⟩
  obtain ⟨n, hn⟩ := exists_finset_subset_of_subset_iUnion_nat hm hT
  let s : Finset ↥(U n) := T.attach.image (fun a ↦ ⟨a.1, hn a.2⟩)
  have hs : s.image Subtype.val = T := by
    simpa only [s, Finset.image_image, Function.comp_def] using T.attach_image_val
  intro j hj
  refine mem_iUnion.mpr ⟨n + 1, ?_⟩
  rw [hU]
  exact Or.inr (mem_iUnion.mpr ⟨s, hs.symm ▸ hj⟩)

/-- A measurable function that uses only coordinates in a countable set and ignores each
finite piece of its exhaustion is measurable in the full tail. -/
private lemma measurable_tail_of_measurable_exhaustion
    {T : ℕ → Finset S} (hT : Monotone T) {U : Set S} (hU : ⋃ n, (T n : Set S) = U)
    (a : S → E) {g : (S → E) → ℝ≥0∞} (hg : Measurable[outsideSigma Uᶜ] g)
    (ht : ∀ n, Measurable[outsideSigma (T n : Set S)] g) :
    Measurable[tailSigma] g := by
  classical
  intro A hA
  rw [tailSigma_def, MeasurableSpace.measurableSet_iInf]
  intro Λ
  refine measurable_outsideSigma_of_eq a (hg.mono (outsideSigma_le _) le_rfl) (fun x y hxy ↦ ?_) hA
  let L := Λ.filter fun i ↦ i ∈ U
  have hL : (L : Set S) ⊆ ⋃ n, (T n : Set S) := by
    intro j hj
    rw [hU]
    exact (Finset.mem_filter.mp hj).2
  obtain ⟨n, hn⟩ := exists_finset_subset_of_subset_iUnion_nat (fun _ _ h ↦ hT h) hL
  let z (j : S) := if j ∈ T n then x j else y j
  have hxg : g x = g z := eq_of_measurable_outsideSigma hg fun j hj ↦ by
    rw [compl_compl] at hj
    by_cases h : j ∈ T n
    · simp only [z, h, ite_true]
    · have hj' : j ∉ Λ := fun hΛ ↦ h (hn (Finset.mem_filter.mpr ⟨hΛ, hj⟩))
      simp only [z, h, ite_false, hxy j hj']
  have hyg : g z = g y := eq_of_measurable_outsideSigma (ht n) fun j hj ↦ by
    simp only [z, mem_compl_iff, Finset.mem_coe] at hj ⊢
    simp only [hj, ite_false]
  exact hxg.trans hyg

/-- If a fixed relative density has a version measurable in every exterior sigma-algebra,
then it has a version measurable in the tail. -/
private lemma exists_withDensity_tail_of_outside
    {μ ν : Measure (S → E)} [IsProbabilityMeasure μ]
    (h : ∀ Λ : Finset S, ∃ g : (S → E) → ℝ≥0∞,
      Measurable[outsideSigma (Λ : Set S)] g ∧ ν = μ.withDensity g) :
    ∃ g : (S → E) → ℝ≥0∞, Measurable[tailSigma] g ∧ ν = μ.withDensity g := by
  classical
  choose f hf hν using h
  have hf' (Λ : Finset S) : Measurable (f Λ) := (hf Λ).mono (outsideSigma_le _) le_rfl
  choose J hJ hfm using fun Λ ↦ measurable_exists_countable_coordinates (hf' Λ)
  obtain ⟨U, hU, hclosed⟩ := exists_countable_closed_finset_family J hJ
  let K := hU.finiteExhaustion
  let T (n : ℕ) := (K.finite n).toFinset
  have hT (n : ℕ) : (T n : Set S) = K n := (K.finite n).coe_toFinset
  have hmono : Monotone T := fun m n hmn ↦ by
    rw [← Finset.coe_subset, hT, hT]
    exact K.mono hmn
  have hTU (n : ℕ) : (T n : Set S) ⊆ U := by
    simpa only [hT, K.iUnion_eq] using (subset_iUnion K n)
  let g (x : S → E) := Filter.liminf (fun n ↦ f (T n) x) atTop
  have hgU : Measurable[outsideSigma Uᶜ] g := by
    let _ : MeasurableSpace (S → E) := outsideSigma (E := E) Uᶜ
    exact Measurable.liminf fun n ↦ (hfm (T n)).mono
      (outsideSigma_anti (compl_subset_compl.mpr (hclosed (T n) (hTU n)))) le_rfl
  have hgT (N : ℕ) : Measurable[outsideSigma (T N : Set S)] g := by
    have hg : g = fun x ↦ Filter.liminf (fun n ↦ f (T (n + N)) x) atTop :=
      funext fun x ↦ (Filter.liminf_nat_add (fun n ↦ f (T n) x) N).symm
    rw [hg]
    let _ : MeasurableSpace (S → E) := outsideSigma (E := E) (T N : Set S)
    exact Measurable.liminf fun n ↦ (hf (T (n + N))).mono
      (outsideSigma_anti (hmono (Nat.le_add_left N n))) le_rfl
  let a : S → E := Classical.choice (nonempty_of_isProbabilityMeasure μ)
  have htail : Measurable[tailSigma] g :=
    measurable_tail_of_measurable_exhaustion hmono (by simp only [hT, K.iUnion_eq]) a hgU hgT
  refine ⟨g, htail, ?_⟩
  have heq (n : ℕ) : f (T 0) =ᵐ[μ] f (T n) :=
    (withDensity_eq_iff_of_sigmaFinite (hf' (T 0)).aemeasurable (hf' (T n)).aemeasurable).mp
      ((hν (T 0)).symm.trans (hν (T n)))
  have hgeq : f (T 0) =ᵐ[μ] g := by
    filter_upwards [ae_all_iff.mpr heq] with x hx
    simp only [g, ← hx, Filter.liminf_const]
  rw [hν (T 0), withDensity_congr_ae hgeq]

/-- A convex combination of Gibbs measures for the same specification is Gibbs. -/
lemma IsGibbs.convex_combination {γ : Finset S → (S → E) → Measure (S → E)}
    {μ ν : Measure (S → E)} (hμ : IsGibbs γ μ) (hν : IsGibbs γ ν) {t : ℝ}
    (ht₀ : 0 ≤ t) (ht₁ : t ≤ 1) :
    IsGibbs γ (ENNReal.ofReal t • μ + ENNReal.ofReal (1 - t) • ν) := by
  let _ := hμ.1
  let _ := hν.1
  refine ⟨⟨?_⟩, fun Λ A hA ↦ ?_⟩
  · simp only [add_apply, smul_apply, smul_eq_mul, measure_univ, mul_one,
      ← ENNReal.ofReal_add ht₀ (sub_nonneg.mpr ht₁), add_sub_cancel, ENNReal.ofReal_one]
  · simp only [add_apply, smul_apply, smul_eq_mul, lintegral_add_measure,
      lintegral_smul_measure, hμ.2 Λ A hA, hν.2 Λ A hA]

/-- SYNOPSIS item 61: for `μ ∈ 𝒢(γ)` and a probability measure `ν ≪ μ`, `ν ∈ 𝒢(γ)` if and only if
`dν/dμ` has a `𝒯`-measurable version. -/
theorem isGibbs_iff_tail_density {γ : Finset S → (S → E) → Measure (S → E)}
    (hγ : IsSpecification γ) {μ ν : Measure (S → E)} (hμ : IsGibbs γ μ)
    [IsProbabilityMeasure ν] (hνμ : ν ≪ μ) :
    IsGibbs γ ν ↔ ∃ g : (S → E) → ℝ≥0∞, Measurable[tailSigma] g ∧ ν = μ.withDensity g := by
  let _ := hμ.1
  constructor
  · intro hν
    exact exists_withDensity_tail_of_outside (hμ.exists_withDensity_outside hγ hν hνμ)
  · rintro ⟨g, hg, rfl⟩
    exact hμ.withDensity_of_measurable_tail hγ hg

/-- SYNOPSIS item 61: an element of `𝒢(γ)` is determined within `𝒢(γ)` by its restriction to the
tail σ-algebra. -/
theorem eq_of_isGibbs_of_tail_eq {γ : Finset S → (S → E) → Measure (S → E)}
    (hγ : IsSpecification γ) {μ ν : Measure (S → E)} (hμ : IsGibbs γ μ) (hν : IsGibbs γ ν)
    (h : ∀ A, MeasurableSet[tailSigma] A → μ A = ν A) : μ = ν := by
  let _ := hμ.1
  let _ := hν.1
  let ρ := ENNReal.ofReal (1 / 2 : ℝ) • μ + ENNReal.ofReal (1 - 1 / 2 : ℝ) • ν
  have hρ : IsGibbs γ ρ := hμ.convex_combination hν (by norm_num) (by norm_num)
  let _ := hρ.1
  have hμρ : μ ≪ ρ := (Measure.absolutelyContinuous_smul
    (ENNReal.ofReal_ne_zero_iff.mpr (by norm_num : 0 < (1 / 2 : ℝ)))).trans
    (Measure.absolutelyContinuous_of_le (fun A ↦ by rw [add_apply]; exact le_self_add))
  have hνρ : ν ≪ ρ := (Measure.absolutelyContinuous_smul
    (ENNReal.ofReal_ne_zero_iff.mpr (by norm_num : 0 < (1 - 1 / 2 : ℝ)))).trans
    (Measure.absolutelyContinuous_of_le (fun A ↦ by rw [add_apply]; exact le_add_self))
  obtain ⟨f, hf, ehf⟩ := (isGibbs_iff_tail_density hγ hρ hμρ).mp hμ
  obtain ⟨g, hg, ehg⟩ := (isGibbs_iff_tail_density hγ hρ hνρ).mp hν
  let hm := tailSigma_le (S := S) (E := E)
  have he : μ.trim hm = ν.trim hm := by
    refine @Measure.ext _ tailSigma _ _ fun A hA ↦ ?_
    rw [trim_measurableSet_eq hm hA, trim_measurableSet_eq hm hA]
    exact h A hA
  rw [ehf, ehg, trim_withDensity hm hf, trim_withDensity hm hg] at he
  have hae := (withDensity_eq_iff_of_sigmaFinite hf.aemeasurable hg.aemeasurable).mp he
  rw [ehf, ehg, withDensity_congr_ae (ae_eq_of_ae_eq_trim hae)]

/-- Conditioning a Gibbs measure on a tail event of positive probability preserves its
specification. -/
private lemma IsGibbs.smul_restrict_of_tail
    {γ : Finset S → (S → E) → Measure (S → E)} (hγ : IsSpecification γ)
    {μ : Measure (S → E)} (hμ : IsGibbs γ μ) {A : Set (S → E)}
    (hA : MeasurableSet[tailSigma] A) (hA₀ : 0 < μ A) :
    IsGibbs γ ((μ A)⁻¹ • μ.restrict A) := by
  let _ := hμ.1
  have hm := tailSigma_le A hA
  let f : (S → E) → ℝ≥0∞ := A.indicator fun _ ↦ (μ A)⁻¹
  have hf : Measurable[tailSigma] f := by
    let _ : MeasurableSpace (S → E) := tailSigma
    exact measurable_const.indicator hA
  have he : μ.withDensity f = (μ A)⁻¹ • μ.restrict A := by
    dsimp only [f]
    rw [withDensity_indicator hm, withDensity_const]
  have hprob : IsProbabilityMeasure (μ.withDensity f) := ⟨by
    rw [he, smul_apply, smul_eq_mul, Measure.restrict_apply_univ,
      ENNReal.inv_mul_cancel hA₀.ne' (measure_ne_top _ _)]⟩
  rw [← he]
  exact hμ.withDensity_of_measurable_tail hγ hf

/-- A nontrivial tail event yields a proper decomposition of the Gibbs measure. -/
private lemma IsExtremeGibbs.measure_tail_eq_zero_or_one
    {γ : Finset S → (S → E) → Measure (S → E)} (hγ : IsSpecification γ)
    {μ : Measure (S → E)} (hμ : IsExtremeGibbs γ μ) {A : Set (S → E)}
    (hA : MeasurableSet[tailSigma] A) : μ A = 0 ∨ μ A = 1 := by
  let _ := hμ.1.1
  by_contra! hne
  have hm := tailSigma_le A hA
  have hp : 0 < μ A := hne.1.bot_lt
  have hlt : μ A < 1 := lt_of_le_of_ne prob_le_one hne.2
  have hpc : 0 < μ Aᶜ := by
    rw [measure_compl hm (measure_ne_top _ _), measure_univ]
    exact tsub_pos_of_lt hlt
  have hν₁ := hμ.1.smul_restrict_of_tail hγ hA hp
  have hc : MeasurableSet[tailSigma] Aᶜ := by
    let _ : MeasurableSpace (S → E) := tailSigma
    exact hA.compl
  have hν₂ := hμ.1.smul_restrict_of_tail hγ hc hpc
  have ht := ENNReal.toReal_pos hne.1 (measure_ne_top μ A)
  have ht₁ : (μ A).toReal < 1 := by
    simpa only [ENNReal.toReal_one] using (ENNReal.toReal_lt_toReal (measure_ne_top μ A)
      ENNReal.one_ne_top).mpr hlt
  have he₁ : ENNReal.ofReal (μ A).toReal = μ A := ENNReal.ofReal_toReal (measure_ne_top _ _)
  have he₂ : ENNReal.ofReal (1 - (μ A).toReal) = μ Aᶜ := by
    rw [ENNReal.ofReal_sub _ ht.le, ENNReal.ofReal_one, he₁,
      measure_compl hm (measure_ne_top _ _), measure_univ]
  have he : μ = ENNReal.ofReal (μ A).toReal • ((μ A)⁻¹ • μ.restrict A) +
      ENNReal.ofReal (1 - (μ A).toReal) • ((μ Aᶜ)⁻¹ • μ.restrict Aᶜ) := by
    rw [he₁, he₂, smul_smul, smul_smul,
      ENNReal.mul_inv_cancel hp.ne' (measure_ne_top _ _),
      ENNReal.mul_inv_cancel hpc.ne' (measure_ne_top _ _), one_smul, one_smul,
      Measure.restrict_add_restrict_compl hm]
  have h₁ := congrArg (fun η : Measure (S → E) ↦ η A) (hμ.2 _ _ hν₁ hν₂ _ ht ht₁ he)
  rw [smul_apply, smul_eq_mul, Measure.restrict_apply_self,
    ENNReal.inv_mul_cancel hp.ne' (measure_ne_top _ _)] at h₁
  exact hne.2 h₁.symm

/-- SYNOPSIS item 61: a Gibbs measure is extreme if and only if it is trivial on the tail
σ-algebra. -/
theorem isExtremeGibbs_iff_tail_trivial {γ : Finset S → (S → E) → Measure (S → E)}
    (hγ : IsSpecification γ) {μ : Measure (S → E)} (hμ : IsGibbs γ μ) :
    IsExtremeGibbs γ μ ↔ ∀ A, MeasurableSet[tailSigma] A → μ A = 0 ∨ μ A = 1 := by
  let _ := hμ.1
  constructor
  · intro he A hA
    exact he.measure_tail_eq_zero_or_one hγ hA
  · intro htail
    refine ⟨hμ, fun ν₁ ν₂ hν₁ _ t ht _ hdecomp ↦ ?_⟩
    let _ := hν₁.1
    have hν₁μ : ν₁ ≪ μ := by
      rw [hdecomp]
      exact (Measure.absolutelyContinuous_smul (ENNReal.ofReal_ne_zero_iff.mpr ht)).trans
        (Measure.absolutelyContinuous_of_le (fun A ↦ by rw [add_apply]; exact le_self_add))
    refine eq_of_isGibbs_of_tail_eq hγ hν₁ hμ fun A hA ↦ ?_
    rcases htail A hA with h0 | h1
    · rw [h0, hν₁μ h0]
    · have hm := tailSigma_le A hA
      have h0 : μ Aᶜ = 0 := by
        rw [measure_compl hm (measure_ne_top _ _), measure_univ, h1, tsub_self]
      have hA₁ : ν₁ A + ν₁ Aᶜ = 1 := by rw [measure_add_measure_compl hm, measure_univ]
      rwa [hν₁μ h0, add_zero, ← h1] at hA₁

/-- SYNOPSIS item 61: distinct extreme Gibbs measures are mutually singular on the tail
σ-algebra. -/
theorem exists_tail_mutuallySingular {γ : Finset S → (S → E) → Measure (S → E)}
    (hγ : IsSpecification γ) {μ ν : Measure (S → E)} (hμ : IsExtremeGibbs γ μ)
    (hν : IsExtremeGibbs γ ν) (hne : μ ≠ ν) :
    ∃ A, MeasurableSet[tailSigma] A ∧ μ A = 1 ∧ ν A = 0 := by
  let _ := hμ.1.1
  let _ := hν.1.1
  obtain ⟨A, hA, hAne⟩ : ∃ A, MeasurableSet[tailSigma] A ∧ μ A ≠ ν A := by
    by_contra! h
    exact hne (eq_of_isGibbs_of_tail_eq hγ hμ.1 hν.1 h)
  have hm := tailSigma_le A hA
  rcases hμ.measure_tail_eq_zero_or_one hγ hA with hμ₀ | hμ₁ <;>
    rcases hν.measure_tail_eq_zero_or_one hγ hA with hν₀ | hν₁
  · exact False.elim (hAne (hμ₀.trans hν₀.symm))
  · have hc : MeasurableSet[tailSigma] Aᶜ := by
      let _ : MeasurableSpace (S → E) := tailSigma
      exact hA.compl
    refine ⟨Aᶜ, hc, ?_, ?_⟩
    · rw [measure_compl hm (measure_ne_top _ _), measure_univ, hμ₀, tsub_zero]
    · rw [measure_compl hm (measure_ne_top _ _), measure_univ, hν₁, tsub_self]
  · exact ⟨A, hA, hμ₁, hν₀⟩
  · exact False.elim (hAne (hμ₁.trans hν₁.symm))

end MSSS
