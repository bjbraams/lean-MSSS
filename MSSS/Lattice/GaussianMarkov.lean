/-!
# Gaussian Markov random fields

SYNOPSIS items 55 and 56. A random vector `x ∼ N(μ, Q⁻¹)` with positive definite precision `Q`
is a Gaussian Markov random field for a graph `G` on its index set when, for `i ≠ j`,
`Q_{ij} ≠ 0` exactly when `i ∼ j`. Conditioning on the coordinates in a set `A` means
conditioning on the σ-algebra `MSSS.coordSigma A` that they generate.

## Main definitions

* `MSSS.coordSigma A`: the σ-algebra generated by the coordinates in `A`.
* `MSSS.Separates G A B C`: every path in `G` from `A` to `B` meets `C`.
* `MSSS.PairwiseMarkov`, `MSSS.LocalMarkov`, `MSSS.GlobalMarkov`: the Markov properties of a
  law on `ι → ℝ` with respect to `G`.

## Main results

The conditional moments and conditional independence use the centered precision residual,
which is independent of the complementary coordinates. The proof uses the affine-map and
independence theorems from TauCeti's multivariate Gaussian library. The global Markov property
follows from the block structure of the precision matrix on vertices outside a separator.

* `MSSS.condIndepFun_iff_precision_eq_zero`, `MSSS.condExp_gaussianLaw_coord`,
  `MSSS.condVar_gaussianLaw_coord`, `MSSS.condCorr_gaussianLaw_coord`: SYNOPSIS item 55.
* `MSSS.pairwiseMarkov_gaussianLaw_inv_iff`, `MSSS.gaussianLaw_markov_tfae`,
  `MSSS.globalMarkov_gaussianLaw`: SYNOPSIS item 56.
-/

public section

noncomputable section

open MeasureTheory ProbabilityTheory Matrix Finset

namespace MSSS

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The σ-algebra on `ι → ℝ` generated by the coordinates in `A`. -/
@[instance_reducible]
def coordSigma (A : Set ι) : MeasurableSpace (ι → ℝ) :=
  MeasurableSpace.comap (fun (x : ι → ℝ) (j : A) ↦ x j) inferInstance

omit [Fintype ι] [DecidableEq ι] in
lemma coordSigma_def (A : Set ι) :
    coordSigma A = MeasurableSpace.comap (fun (x : ι → ℝ) (j : A) ↦ x j) inferInstance := by
  rw [coordSigma]

omit [Fintype ι] [DecidableEq ι] in
lemma coordSigma_le (A : Set ι) : coordSigma A ≤ (inferInstance : MeasurableSpace (ι → ℝ)) := by
  rw [coordSigma]
  exact Measurable.comap_le (by fun_prop)

/-! ### Precision and conditional independence (SYNOPSIS item 55) -/

/-- The coordinate restriction matrix for a subset of a finite Gaussian vector. -/
private def coordMatrix (A : Set ι) : Matrix A ι ℝ :=
  (1 : Matrix ι ι ℝ).submatrix Subtype.val id

/-- The coordinate restriction matrix acts by selecting precisely those coordinates. -/
private lemma coordMatrix_mulVec (A : Set ι) (x : ι → ℝ) :
    coordMatrix A *ᵥ x = fun i : A ↦ x i := by
  funext i
  simp [coordMatrix, Matrix.mulVec, dotProduct, Matrix.one_apply]

/-- Multiplication by the coordinate restriction matrix keeps the corresponding rows. -/
private lemma coordMatrix_mul (A : Set ι) (Q : Matrix ι ι ℝ) :
    coordMatrix A * Q = Q.submatrix Subtype.val id := by
  ext i j
  exact congrFun (coordMatrix_mulVec A (fun k ↦ Q k j)) i

/-- Multiplication by the transposed coordinate matrix keeps the corresponding columns. -/
private lemma mul_coordMatrix_transpose {κ : Type*} (A : Set ι) (Q : Matrix κ ι ℝ) :
    Q * (coordMatrix A)ᵀ = Q.submatrix id Subtype.val := by
  ext i j
  simp [coordMatrix, Matrix.mul_apply, Matrix.one_apply]

/-- The centered coordinate vector has the centered multivariate Gaussian law. -/
private lemma hasLaw_centered_gaussianLaw (μ : ι → ℝ) {S : Matrix ι ι ℝ} (hS : S.PosSemidef) :
    HasLaw (fun x : ι → ℝ ↦ WithLp.toLp 2 (x - μ)) (multivariateGaussian 0 S)
      (gaussianLaw μ S) := by
  refine ⟨(by fun_prop), ?_⟩
  rw [gaussianLaw_def, Measure.map_map (by fun_prop) (by fun_prop)]
  have he : (fun x : ι → ℝ ↦ WithLp.toLp 2 (x - μ)) ∘ WithLp.ofLp =
      fun x : EuclideanSpace ℝ ι ↦ (1 : Matrix ι ι ℝ).toEuclideanLin x +
        -(WithLp.toLp 2 μ) := by
    funext x
    ext i
    simp [sub_eq_add_neg]
  rw [he, TauCeti.Probability.map_affine_multivariateGaussian _ hS]
  simp

/-- The residual obtained by applying the precision and inverting the principal block. -/
private def precisionResidualMatrix (A : Set ι) [Fintype A] [DecidableEq A]
    (Q : Matrix ι ι ℝ) : Matrix A ι ℝ :=
  (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹ * coordMatrix A * Q

/-- The precision residual has covariance the inverse of the principal precision block. -/
private lemma precisionResidualMatrix_cov (A : Set ι) [Fintype A] [DecidableEq A]
    {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) :
    let R := precisionResidualMatrix A Q
    R * Q⁻¹ * Rᵀ = (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹ := by
  intro R
  let Q₀ : Matrix A A ℝ := Q.submatrix Subtype.val Subtype.val
  have hQ₀ := hQ.submatrix (Subtype.val_injective : Function.Injective (Subtype.val : A → ι))
  have hQdet : IsUnit Q.det := (Matrix.isUnit_iff_isUnit_det Q).mp hQ.isUnit
  have hQ₀det : IsUnit Q₀.det := (Matrix.isUnit_iff_isUnit_det Q₀).mp hQ₀.isUnit
  have hQt : Qᵀ = Q := hQ.isHermitian.isSymm
  have hQ₀t : Q₀ᵀ = Q₀ := hQ₀.isHermitian.isSymm
  have hRt : Rᵀ = Q * ((coordMatrix A)ᵀ * Q₀⁻¹) := by
    dsimp only [R, precisionResidualMatrix]
    rw [transpose_mul, transpose_mul, transpose_nonsing_inv, hQt, hQ₀t]
  have hblock : coordMatrix A * Q * (coordMatrix A)ᵀ = Q₀ := by
    rw [coordMatrix_mul, mul_coordMatrix_transpose, submatrix_submatrix]
    rfl
  dsimp only [R, precisionResidualMatrix] at hRt ⊢
  calc
    _ = (Q₀⁻¹ * coordMatrix A) * ((Q * Q⁻¹) * (Q * ((coordMatrix A)ᵀ * Q₀⁻¹))) := by
      rw [hRt]
      simp only [Matrix.mul_assoc, Q₀]
    _ = Q₀⁻¹ * (coordMatrix A * Q * (coordMatrix A)ᵀ) * Q₀⁻¹ := by
      rw [Matrix.mul_nonsing_inv Q hQdet, Matrix.one_mul]
      simp only [Matrix.mul_assoc]
    _ = Q₀⁻¹ := by rw [hblock, Matrix.nonsing_inv_mul Q₀ hQ₀det, Matrix.one_mul]

/-- The precision residual is uncorrelated with all observations outside the principal block. -/
private lemma precisionResidualMatrix_cross (A : Set ι) [Fintype A] [DecidableEq A]
    {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) :
    precisionResidualMatrix A Q * Q⁻¹ * (coordMatrix Aᶜ)ᵀ = 0 := by
  have hd : IsUnit Q.det := (Matrix.isUnit_iff_isUnit_det Q).mp hQ.isUnit
  have hcross : coordMatrix A * (coordMatrix Aᶜ)ᵀ = 0 := by
    rw [mul_coordMatrix_transpose, coordMatrix, submatrix_submatrix]
    ext i j
    have hij : (i : ι) ≠ (j : ι) := fun h ↦ j.property (h ▸ i.property)
    simp [hij]
  rw [precisionResidualMatrix, Matrix.mul_nonsing_inv_cancel_right _ _ hd, Matrix.mul_assoc,
    hcross, Matrix.mul_zero]

/-- The centered precision residual is Gaussian and independent of the complementary block. -/
private lemma precisionResidual_hasLaw_indep (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (A : Set ι) [Fintype A] [DecidableEq A] [Fintype (Aᶜ : Set ι)] :
    let R := fun x : ι → ℝ ↦ WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))
    let Y := fun (x : ι → ℝ) (j : (Aᶜ : Set ι)) ↦ x j
    HasLaw R (multivariateGaussian 0 (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹)
        (gaussianLaw μ Q⁻¹) ∧ IndepFun R Y (gaussianLaw μ Q⁻¹) := by
  intro R Y
  let X := fun x : ι → ℝ ↦ WithLp.toLp 2 (x - μ)
  let T := precisionResidualMatrix A Q
  let D := coordMatrix Aᶜ
  have hX := hasLaw_centered_gaussianLaw μ hQ.inv.posSemidef
  have hR : R = fun x ↦ T.toEuclideanLin (X x) := rfl
  refine ⟨⟨(by rw [hR]; fun_prop), ?_⟩, ?_⟩
  · rw [hR, ← Function.comp_def, ← Measure.map_map (by fun_prop) (by fun_prop), hX.map_eq]
    have hm := TauCeti.Probability.map_affine_multivariateGaussian 0 hQ.inv.posSemidef T 0
    have hcov : T * Q⁻¹ * Tᵀ =
        (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹ := precisionResidualMatrix_cov A hQ
    rw [hcov] at hm
    simpa only [add_zero, map_zero] using hm
  · have hi := (TauCeti.Probability.indepFun_matrix_of_hasLaw_multivariateGaussian_iff
      hQ.inv.posSemidef hX T D).2 (precisionResidualMatrix_cross A hQ)
    have hill := hi.comp (φ := id) (ψ := fun y : EuclideanSpace ℝ (Aᶜ : Set ι) ↦
      fun j : (Aᶜ : Set ι) ↦ y j + μ j) measurable_id (by fun_prop)
    have hY : (fun y : EuclideanSpace ℝ (Aᶜ : Set ι) ↦ fun j : (Aᶜ : Set ι) ↦ y j + μ j) ∘
        (fun x ↦ D.toEuclideanLin (X x)) = Y := by
      funext x j
      have hh : D.toEuclideanLin (X x) j = (D *ᵥ (x - μ)) j := rfl
      rw [Function.comp_apply, hh, coordMatrix_mulVec]
      dsimp only [Pi.sub_apply, Y]
      exact sub_add_cancel (x j) (μ j)
    rw [Function.id_comp, hY, ← hR] at hill
    exact hill


/-- Given the complementary coordinates, functions of the residual have their Gaussian means. -/
private lemma condExp_precisionResidual (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (A : Set ι) [Fintype A] [DecidableEq A] [Fintype (Aᶜ : Set ι)]
    {g : EuclideanSpace ℝ A → ℝ} (hg : Measurable g) :
    let P := gaussianLaw μ Q⁻¹
    let R := fun x : ι → ℝ ↦ WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))
    P[g ∘ R | coordSigma Aᶜ] =ᵐ[P]
      fun _ ↦ ∫ r, g r ∂multivariateGaussian 0
        (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹ := by
  intro P R
  let Y := fun (x : ι → ℝ) (j : (Aᶜ : Set ι)) ↦ x j
  obtain ⟨hR, hI⟩ := precisionResidual_hasLaw_indep μ hQ A
  change HasLaw R _ P at hR
  change IndepFun R Y P at hI
  have hm : Measurable R := by
    change Measurable (fun x ↦ (precisionResidualMatrix A Q).toEuclideanLin
      (WithLp.toLp 2 (x - μ)))
    fun_prop
  have hC := condExp_indep_eq hm.comap_le (coordSigma_le Aᶜ)
    (hg.comp (comap_measurable R)).stronglyMeasurable ((IndepFun_iff_Indep _ _ _).mp hI)
  rw [hR.integral_comp hg.aestronglyMeasurable] at hC
  exact hC

/-- The residual matrix restricts to the identity on its own block. -/
private lemma precisionResidualMatrix_internal (A : Set ι) [Fintype A] [DecidableEq A]
    {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) :
    (precisionResidualMatrix A Q).submatrix id (Subtype.val : A → ι) = 1 := by
  have hQ₀ := hQ.submatrix (Subtype.val_injective : Function.Injective (Subtype.val : A → ι))
  have hd := (Matrix.isUnit_iff_isUnit_det _).mp hQ₀.isUnit
  have hblock : coordMatrix A * Q * (coordMatrix A)ᵀ =
      Q.submatrix (Subtype.val : A → ι) Subtype.val := by
    rw [coordMatrix_mul, mul_coordMatrix_transpose, Matrix.submatrix_submatrix]
    rfl
  rw [← mul_coordMatrix_transpose, precisionResidualMatrix, Matrix.mul_assoc, Matrix.mul_assoc,
    ← Matrix.mul_assoc (coordMatrix A), hblock, Matrix.nonsing_inv_mul _ hd]

/-- The conditional shift giving the original coordinates from the centered residual. -/
private def precisionConditionalShift (μ : ι → ℝ) (A : Set ι) [Fintype A] [DecidableEq A]
    [Fintype (Aᶜ : Set ι)] (Q : Matrix ι ι ℝ) (x : (Aᶜ : Set ι) → ℝ) (i : A) : ℝ :=
  μ i - ∑ j : (Aᶜ : Set ι), precisionResidualMatrix A Q i j * (x j - μ j)

/-- A principal coordinate is the sum of its residual and a function of the
complementary coordinates. -/
private lemma precisionResidual_add_shift (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (A : Set ι) [Fintype A] [DecidableEq A] [Fintype (Aᶜ : Set ι)] (i : A) (x : ι → ℝ) :
    (precisionResidualMatrix A Q *ᵥ (x - μ)) i +
      precisionConditionalShift μ A Q (fun j ↦ x j) i = x i := by
  classical
  let T := precisionResidualMatrix A Q
  let f := fun j ↦ T i j * (x j - μ j)
  have hA : ∑ j : A, f j = x i - μ i := by
    have hM := congrArg (fun (M : Matrix A A ℝ) ↦ (M *ᵥ fun j : A ↦ x j - μ j) i)
      (precisionResidualMatrix_internal A hQ)
    rw [Matrix.one_mulVec] at hM
    exact hM
  have hs : (∑ j : A, f j) + (∑ j : (Aᶜ : Set ι), f j) = ∑ j, f j := by
    let U := A.toFinset
    have hU : ∀ j, j ∈ U ↔ j ∈ A := by simp [U]
    have hUc : ∀ j, j ∈ Uᶜ ↔ j ∈ Aᶜ := by simp [U]
    rw [← Finset.sum_subtype U hU, ← Finset.sum_subtype Uᶜ hUc]
    exact Finset.sum_add_sum_compl U f
  change (∑ j, f j) + (μ i - ∑ j : (Aᶜ : Set ι), f j) = x i
  rw [← hs, hA]
  ring

/-- The conditional expectation of each principal coordinate is its conditional shift. -/
private lemma condExp_coord_eq_shift (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (A : Set ι) [Fintype A] [DecidableEq A] [Fintype (Aᶜ : Set ι)] (i : A) :
    let P := gaussianLaw μ Q⁻¹
    P[fun x ↦ x i | coordSigma Aᶜ] =ᵐ[P]
      fun x ↦ precisionConditionalShift μ A Q (fun j ↦ x j) i := by
  intro P
  let R := fun (x : ι → ℝ) ↦ (precisionResidualMatrix A Q *ᵥ (x - μ)) i
  let Y := fun (x : ι → ℝ) (j : (Aᶜ : Set ι)) ↦ x j
  let g := fun y ↦ precisionConditionalShift μ A Q y i
  let M := multivariateGaussian (WithLp.toLp 2 μ) Q⁻¹
  have hX : HasLaw (WithLp.toLp 2) M P := by
    refine ⟨by fun_prop, ?_⟩
    change Measure.map (WithLp.toLp 2) (gaussianLaw μ Q⁻¹) = M
    rw [gaussianLaw_def, Measure.map_map (by fun_prop) (by fun_prop)]
    exact Measure.map_id
  have hcoord : Integrable (fun x : ι → ℝ ↦ x i) P := by
    have hi : Integrable (fun x : EuclideanSpace ℝ ι ↦ x (i : ι)) M :=
      (EuclideanSpace.proj (𝕜 := ℝ) (i : ι)).integrable_comp
        (IsGaussian.integrable_id (μ := M))
    exact hX.integrable_comp hi
  obtain ⟨hR, _⟩ := precisionResidual_hasLaw_indep μ hQ A
  have hRint : Integrable R P := by
    exact hR.integrable_comp ((EuclideanSpace.proj (𝕜 := ℝ) i).integrable_comp
      (IsGaussian.integrable_id (μ := multivariateGaussian 0
        (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹)))
  have hsplit : ∀ x, R x + g (Y x) = x i := precisionResidual_add_shift μ hQ A i
  have hgint : Integrable (g ∘ Y) P := by
    convert hcoord.sub hRint using 1
    funext x
    exact eq_sub_iff_add_eq.mpr (by rw [add_comm]; exact hsplit x)
  have hg : Measurable g := by
    dsimp only [g, precisionConditionalShift]
    fun_prop
  have hgmeas : StronglyMeasurable[coordSigma Aᶜ] (g ∘ Y) :=
    (hg.comp (comap_measurable Y)).stronglyMeasurable
  have hcond : P[R | coordSigma Aᶜ] =ᵐ[P] fun _ ↦ 0 := by
    have h := condExp_precisionResidual μ hQ A (g := fun r ↦ r i) (by fun_prop)
    change (gaussianLaw μ Q⁻¹)[(fun (r : EuclideanSpace ℝ A) ↦ r i) ∘
        (fun x ↦ WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))) | coordSigma Aᶜ] =ᵐ[_]
      fun _ ↦ 0
    simpa only [TauCeti.Probability.integral_eval_multivariateGaussian, PiLp.zero_apply] using h
  have heq : (fun x ↦ x i) = R + g ∘ Y := funext fun x ↦ (hsplit x).symm
  rw [heq]
  refine (condExp_add hRint hgint _).trans ?_
  rw [condExp_of_stronglyMeasurable (coordSigma_le _) hgmeas hgint]
  filter_upwards [hcond] with x hx
  simp only [Pi.add_apply, hx, zero_add]
  rfl

omit [Fintype ι] [DecidableEq ι] in
/-- The inverse of a singleton principal block is the scalar reciprocal. -/
private lemma principalInverse_singleton (i : ι) [Fintype ({i} : Set ι)]
    [DecidableEq ({i} : Set ι)] (Q : Matrix ι ι ℝ) :
    let a : ({i} : Set ι) := ⟨i, rfl⟩
    (Q.submatrix (Subtype.val : ({i} : Set ι) → ι) Subtype.val)⁻¹ a a = (Q i i)⁻¹ := by
  intro a
  have : Subsingleton ({i} : Set ι) :=
    ⟨fun j k ↦ Subtype.ext ((Set.mem_singleton_iff.mp j.property).trans
      (Set.mem_singleton_iff.mp k.property).symm)⟩
  rw [Matrix.inv_subsingleton, Matrix.diagonal_apply_eq, Ring.inverse_eq_inv]
  rfl

/-- The singleton residual has coefficient (Q_{ii}^{-1} Q_{ij}) in column (j). -/
private lemma precisionResidualMatrix_singleton (i j : ι) [Fintype ({i} : Set ι)]
    [DecidableEq ({i} : Set ι)] (Q : Matrix ι ι ℝ) :
    let a : ({i} : Set ι) := ⟨i, rfl⟩
    precisionResidualMatrix ({i} : Set ι) Q a j = (Q i i)⁻¹ * Q i j := by
  intro a
  let _ : Unique ({i} : Set ι) := ⟨⟨a⟩, fun k ↦ Subtype.ext (Set.mem_singleton_iff.mp k.property)⟩
  rw [precisionResidualMatrix, Matrix.mul_assoc, coordMatrix_mul, Matrix.mul_apply,
    Fintype.sum_unique]
  exact congrArg (fun t ↦ t * Q i j) (principalInverse_singleton i Q)

/-- For a singleton block the shift is the weighted sum over the remaining coordinates. -/
private lemma precisionConditionalShift_singleton (i : ι) [Fintype ({i} : Set ι)]
    [DecidableEq ({i} : Set ι)] [Fintype (({i} : Set ι)ᶜ : Set ι)]
    (μ : ι → ℝ) (Q : Matrix ι ι ℝ) (x : ι → ℝ) :
    precisionConditionalShift μ ({i} : Set ι) Q (fun j ↦ x j) ⟨i, rfl⟩ =
      μ i - (Q i i)⁻¹ * ∑ j ∈ univ.erase i, Q i j * (x j - μ j) := by
  simp only [precisionConditionalShift, precisionResidualMatrix_singleton i _ Q, mul_assoc,
    Finset.mul_sum]
  have hs := Finset.sum_subtype (F := inferInstanceAs (Fintype (({i} : Set ι)ᶜ : Set ι)))
    (univ.erase i) (p := fun j ↦ j ∈ ({i}ᶜ : Set ι))
    (fun j ↦ by simp) (fun j ↦ (Q i i)⁻¹ * (Q i j * (x j - μ j)))
  exact congrArg (μ i - ·) hs.symm

section ConditionalLaw

variable {Ω W U V V' : Type*} [MeasurableSpace Ω] [MeasurableSpace W] [MeasurableSpace U]
  [MeasurableSpace V] [MeasurableSpace V'] [StandardBorelSpace Ω]
  {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure U} [IsProbabilityMeasure ν]

/-- Sample the independent input with its fixed law and apply a function of both inputs. -/
private def independentInputKernel (ν : Measure U) [IsProbabilityMeasure ν] (f : W × U → V) :
    Kernel W V :=
  (Kernel.id ×ₖ Kernel.const W ν).map f

private lemma independentInputKernel_apply (f : W × U → V) (hf : Measurable f) (y : W) :
    independentInputKernel ν f y = ν.map (fun z ↦ f (y, z)) := by
  rw [independentInputKernel, Kernel.map_apply _ hf, Kernel.prod_apply, Kernel.id_apply,
    Kernel.const_apply, Measure.dirac_prod, Measure.map_map hf (by fun_prop)]
  rfl

omit [StandardBorelSpace Ω] in
/-- The conditional law of a function of the observed and independent input variables. -/
private lemma condDistrib_independentInput [StandardBorelSpace V] [Nonempty V]
    {X : Ω → U} {Y : Ω → W} (hX : Measurable X) (hY : Measurable Y) (hL : HasLaw X ν P)
    (hI : IndepFun X Y P) (f : W × U → V) (hf : Measurable f) :
    condDistrib (fun w ↦ f (Y w, X w)) Y P =ᵐ[P.map Y] independentInputKernel ν f := by
  have : IsMarkovKernel (independentInputKernel ν f) := Kernel.IsMarkovKernel.map _ hf
  apply condDistrib_ae_eq_of_measure_eq_compProd_of_measurable hY
    (hf.comp (hY.prodMk hX))
  let g : W × U → W × V := fun z ↦ (z.1, f z)
  have hm : Measurable g := measurable_fst.prodMk hf
  have hmap := (indepFun_iff_map_prod_eq_prod_map_map hY.aemeasurable hX.aemeasurable).mp hI.symm
  rw [hL.map_eq] at hmap
  change P.map (g ∘ (fun w ↦ (Y w, X w))) = _
  rw [← Measure.map_map hm (hY.prodMk hX), hmap]
  ext s hs
  rw [Measure.map_apply hm hs, Measure.prod_apply (hm hs), Measure.compProd_apply hs]
  apply lintegral_congr
  intro y
  have hfy : Measurable (fun z ↦ f (y, z)) := hf.comp measurable_prodMk_left
  rw [independentInputKernel_apply f hf y, Measure.map_apply hfy (measurable_prodMk_left hs)]
  rfl

/-- Conditional independence given the observation is independence of the two output functions
with respect to the independent input law, for almost every observation. -/
private lemma condIndepFun_iff_indepFun_given_independentInput
    [StandardBorelSpace V] [Nonempty V] [StandardBorelSpace V'] [Nonempty V']
    {X : Ω → U} {Y : Ω → W} (hX : Measurable X) (hY : Measurable Y) (hL : HasLaw X ν P)
    (hI : IndepFun X Y P) (f : W × U → V) (g : W × U → V')
    (hf : Measurable f) (hg : Measurable g) :
    CondIndepFun (MeasurableSpace.comap Y inferInstance) hY.comap_le
      (fun w ↦ f (Y w, X w)) (fun w ↦ g (Y w, X w)) P ↔
      ∀ᵐ y ∂P.map Y, IndepFun (fun z ↦ f (y, z)) (fun z ↦ g (y, z)) ν := by
  let F := fun w ↦ f (Y w, X w)
  let G := fun w ↦ g (Y w, X w)
  have hF : Measurable F := hf.comp (hY.prodMk hX)
  have hG : Measurable G := hg.comp (hY.prodMk hX)
  change CondIndepFun _ _ F G P ↔ _
  rw [condIndepFun_iff_map_prod_eq_prod_condDistrib_prod_condDistrib hF hG hY,
    ← Measure.compProd_eq_comp_prod, ← compProd_map_condDistrib hY.aemeasurable
      (hF.prodMk hG).aemeasurable, Kernel.compProd_eq_iff]
  have hFG := condDistrib_independentInput hX hY hL hI (fun z ↦ (f z, g z)) (hf.prodMk hg)
  have hf' := condDistrib_independentInput hX hY hL hI f hf
  have hg' := condDistrib_independentInput hX hY hL hI g hg
  apply Filter.eventually_congr
  filter_upwards [hFG, hf', hg'] with y hfg hyf hyg
  rw [Kernel.prod_apply, hfg, hyf, hyg, independentInputKernel_apply _ (hf.prodMk hg),
    independentInputKernel_apply _ hf, independentInputKernel_apply _ hg]
  exact (indepFun_iff_map_prod_eq_prod_map_map (hf.comp (by fun_prop)).aemeasurable
    (hg.comp (by fun_prop)).aemeasurable).symm

end ConditionalLaw

/-- Translating two functions of the Gaussian residual by functions of the observation preserves
their independence exactly when the translated functions are conditionally independent. -/
private lemma condIndepFun_precisionResidual_add_shift_iff
    {V V' : Type*} [AddGroup V] [AddGroup V'] [MeasurableSpace V] [MeasurableSpace V']
    [MeasurableAdd₂ V] [MeasurableAdd₂ V'] [StandardBorelSpace V] [StandardBorelSpace V']
    (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (A : Set ι) [Fintype A] [DecidableEq A] [Fintype (Aᶜ : Set ι)]
    {f : EuclideanSpace ℝ A → V} {g : EuclideanSpace ℝ A → V'}
    {u : ((Aᶜ : Set ι) → ℝ) → V} {v : ((Aᶜ : Set ι) → ℝ) → V'}
    (hf : Measurable f) (hg : Measurable g) (hu : Measurable u) (hv : Measurable v) :
    let P := gaussianLaw μ Q⁻¹
    let R := fun x : ι → ℝ ↦ WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))
    let Y := fun (x : ι → ℝ) (j : (Aᶜ : Set ι)) ↦ x j
    CondIndepFun (coordSigma Aᶜ) (coordSigma_le _)
      (fun x ↦ f (R x) + u (Y x)) (fun x ↦ g (R x) + v (Y x)) P ↔
      IndepFun f g (multivariateGaussian 0 (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹) := by
  intro P R Y
  have hRm : Measurable R := by
    change Measurable (fun x ↦ (precisionResidualMatrix A Q).toEuclideanLin
      (WithLp.toLp 2 (x - μ)))
    fun_prop
  have hYm : Measurable Y := by
    dsimp only [Y]
    fun_prop
  obtain ⟨hR, hI⟩ := precisionResidual_hasLaw_indep μ hQ A
  change HasLaw R _ P at hR
  change IndepFun R Y P at hI
  let F : (((Aᶜ : Set ι) → ℝ) × EuclideanSpace ℝ A) → V := fun p ↦ f p.2 + u p.1
  let H : (((Aᶜ : Set ι) → ℝ) × EuclideanSpace ℝ A) → V' := fun p ↦ g p.2 + v p.1
  have hFm : Measurable F := (hf.comp measurable_snd).add (hu.comp measurable_fst)
  have hHm : Measurable H := (hg.comp measurable_snd).add (hv.comp measurable_fst)
  change CondIndepFun (MeasurableSpace.comap Y inferInstance) hYm.comap_le
    (fun x ↦ F (Y x, R x)) (fun x ↦ H (Y x, R x)) P ↔ _
  rw [condIndepFun_iff_indepFun_given_independentInput hRm hYm hR hI _ _ hFm hHm]
  have htranslate (y : (Aᶜ : Set ι) → ℝ) :
      IndepFun (fun z ↦ F (y, z)) (fun z ↦ H (y, z))
          (multivariateGaussian 0 (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹) ↔
        IndepFun f g
          (multivariateGaussian 0 (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹) := by
    constructor
    · intro h
      simpa only [Function.comp_def, F, H, add_neg_cancel_right] using
        h.comp (φ := fun t ↦ t + -(u y)) (ψ := fun t ↦ t + -(v y))
          (measurable_id.add measurable_const) (measurable_id.add measurable_const)
    · intro h
      exact h.comp (φ := fun t ↦ t + u y) (ψ := fun t ↦ t + v y)
        (measurable_id.add measurable_const) (measurable_id.add measurable_const)
  simp only [htranslate, Filter.eventually_const]

/-- The independence of coordinate selections of a Gaussian vector is tested by the
corresponding cross-covariance entries. -/
private lemma indepFun_gaussian_coordSelections_iff
    {υ κ τ : Type*} [Fintype υ] [DecidableEq υ] [Fintype κ] [Fintype τ]
    {S : Matrix υ υ ℝ} (hS : S.PosSemidef) (p : κ → υ) (q : τ → υ) :
    IndepFun (fun (r : EuclideanSpace ℝ υ) k ↦ r (p k)) (fun r t ↦ r (q t))
        (multivariateGaussian 0 S) ↔ ∀ k t, S (p k) (q t) = 0 := by
  let L : Matrix κ υ ℝ := (1 : Matrix υ υ ℝ).submatrix p id
  let M : Matrix τ υ ℝ := (1 : Matrix υ υ ℝ).submatrix q id
  have hL (r : EuclideanSpace ℝ υ) :
      WithLp.ofLp (L.toEuclideanLin r) = fun k ↦ r (p k) := by
    funext k
    change (L *ᵥ WithLp.ofLp r) k = _
    simp [L, Matrix.mulVec, dotProduct, Matrix.one_apply]
  have hM (r : EuclideanSpace ℝ υ) :
      WithLp.ofLp (M.toEuclideanLin r) = fun t ↦ r (q t) := by
    funext t
    change (M *ᵥ WithLp.ofLp r) t = _
    simp [M, Matrix.mulVec, dotProduct, Matrix.one_apply]
  have hcross : L * S * Mᵀ = S.submatrix p q := by
    have hLS : L * S = S.submatrix p id := by
      ext k t
      simp [L, Matrix.mul_apply, Matrix.one_apply]
    rw [hLS]
    ext k t
    simp [M, Matrix.mul_apply, Matrix.one_apply]
  have hz : S.submatrix p q = 0 ↔ ∀ k t, S (p k) (q t) = 0 := by
    constructor
    · intro h k t
      exact congrArg (fun (B : Matrix κ τ ℝ) ↦ B k t) h
    · exact Matrix.ext
  rw [← hz, ← hcross, ← TauCeti.Probability.indepFun_matrix_multivariateGaussian_iff 0 hS L M]
  constructor
  · intro h
    have h' := h.comp (φ := WithLp.toLp 2) (ψ := WithLp.toLp 2) (by fun_prop) (by fun_prop)
    simpa only [Function.comp_def, ← hL, ← hM, WithLp.toLp_ofLp] using h'
  · intro h
    have h' := h.comp (φ := WithLp.ofLp) (ψ := WithLp.ofLp) (by fun_prop) (by fun_prop)
    simpa only [Function.comp_def, hL, hM] using h'

/-- Conditional independence of coordinate selections is tested by entries of the inverse
principal precision block. -/
private lemma condIndepFun_gaussian_coordSelections_iff
    {κ τ : Type*} [Fintype κ] [Fintype τ] (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (A : Set ι) [Fintype A] [DecidableEq A] [Fintype (Aᶜ : Set ι)] (p : κ → A) (q : τ → A) :
    CondIndepFun (coordSigma Aᶜ) (coordSigma_le _)
      (fun (x : ι → ℝ) k ↦ x (p k)) (fun x t ↦ x (q t)) (gaussianLaw μ Q⁻¹) ↔
      ∀ k t, (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹ (p k) (q t) = 0 := by
  let f : EuclideanSpace ℝ A → κ → ℝ := fun r k ↦ r (p k)
  let g : EuclideanSpace ℝ A → τ → ℝ := fun r t ↦ r (q t)
  let u : ((Aᶜ : Set ι) → ℝ) → κ → ℝ := fun y k ↦ precisionConditionalShift μ A Q y (p k)
  let v : ((Aᶜ : Set ι) → ℝ) → τ → ℝ := fun y t ↦ precisionConditionalShift μ A Q y (q t)
  have hu : Measurable u := by
    dsimp only [u, precisionConditionalShift]
    fun_prop
  have hv : Measurable v := by
    dsimp only [v, precisionConditionalShift]
    fun_prop
  have hf : Measurable f := by dsimp only [f]; fun_prop
  have hg : Measurable g := by dsimp only [g]; fun_prop
  have hx (x : ι → ℝ) :
      f (WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))) + u (fun j ↦ x j) =
        fun k ↦ x (p k) := funext fun k ↦ precisionResidual_add_shift μ hQ A (p k) x
  have hy (x : ι → ℝ) :
      g (WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))) + v (fun j ↦ x j) =
        fun t ↦ x (q t) := funext fun t ↦ precisionResidual_add_shift μ hQ A (q t) x
  have h := condIndepFun_precisionResidual_add_shift_iff μ hQ A hf hg hu hv
  dsimp only at h
  have hS := (hQ.submatrix
    (Subtype.val_injective : Function.Injective (Subtype.val : A → ι))).inv.posSemidef
  simpa only [hx, hy] using h.trans (indepFun_gaussian_coordSelections_iff hS p q)

/-- SYNOPSIS item 55: `E(x_i ∣ x_{-i}) = μ_i - Q_{ii}⁻¹ ∑_{j ≠ i} Q_{ij} (x_j - μ_j)`. -/
theorem condExp_gaussianLaw_coord (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) (i : ι) :
    (gaussianLaw μ Q⁻¹)[fun x ↦ x i | coordSigma ({i}ᶜ : Set ι)] =ᵐ[gaussianLaw μ Q⁻¹]
      fun x ↦ μ i - (Q i i)⁻¹ * ∑ j ∈ univ.erase i, Q i j * (x j - μ j) := by
  classical
  have h := condExp_coord_eq_shift μ hQ ({i} : Set ι) ⟨i, rfl⟩
  exact h.trans (Filter.Eventually.of_forall (precisionConditionalShift_singleton i μ Q))

/-- SYNOPSIS item 55: `Var(x_i ∣ x_{-i}) = Q_{ii}⁻¹`. -/
theorem condVar_gaussianLaw_coord (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) (i : ι) :
    (gaussianLaw μ Q⁻¹)[fun x ↦ (x i - (μ i - (Q i i)⁻¹ *
        ∑ j ∈ univ.erase i, Q i j * (x j - μ j))) ^ 2 | coordSigma ({i}ᶜ : Set ι)]
      =ᵐ[gaussianLaw μ Q⁻¹] fun _ ↦ (Q i i)⁻¹ := by
  classical
  let A : Set ι := {i}
  let a : A := ⟨i, rfl⟩
  let S : Matrix A A ℝ := (Q.submatrix Subtype.val Subtype.val)⁻¹
  have hE := condExp_precisionResidual μ hQ A (g := fun r ↦ r a ^ 2) (by fun_prop)
  have hS : S.PosSemidef := (hQ.submatrix Subtype.val_injective).inv.posSemidef
  have hI : ∫ r : EuclideanSpace ℝ A, r a ^ 2 ∂multivariateGaussian 0 S = S a a := by
    have hvar := variance_eval_multivariateGaussian (μ := (0 : EuclideanSpace ℝ A)) hS a
    rw [variance_eq_integral (by fun_prop), TauCeti.Probability.integral_eval_multivariateGaussian,
      PiLp.zero_apply] at hvar
    simpa only [sub_zero] using hvar
  have heq : (fun (x : ι → ℝ) ↦ (x i - (μ i - (Q i i)⁻¹ *
        ∑ j ∈ univ.erase i, Q i j * (x j - μ j))) ^ 2) =
      (fun (r : EuclideanSpace ℝ A) ↦ r a ^ 2) ∘
        (fun x ↦ WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))) := by
    funext x
    have hsplit := precisionResidual_add_shift μ hQ A a x
    change _ + precisionConditionalShift μ ({i} : Set ι) Q (fun j ↦ x j) ⟨i, rfl⟩ = x i
      at hsplit
    rw [precisionConditionalShift_singleton i μ Q] at hsplit
    exact congrArg (· ^ 2) (sub_eq_iff_eq_add.mpr hsplit.symm)
  rw [heq]
  exact hE.trans (Filter.Eventually.of_forall fun _ ↦ hI.trans (principalInverse_singleton i Q))

/-- Conditional mixed second moments of centered coordinates are entries of the inverse block. -/
private lemma condExp_centered_mul (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (A : Set ι) [Fintype A] [DecidableEq A] [Fintype (Aᶜ : Set ι)] (i j : A) :
    let P := gaussianLaw μ Q⁻¹
    let m := coordSigma Aᶜ
    P[fun x ↦ (x i - P[fun y ↦ y i | m] x) * (x j - P[fun y ↦ y j | m] x) | m]
      =ᵐ[P] fun _ ↦ (Q.submatrix (Subtype.val : A → ι) Subtype.val)⁻¹ i j := by
  intro P m
  let S : Matrix A A ℝ := (Q.submatrix Subtype.val Subtype.val)⁻¹
  have hS : S.PosSemidef := (hQ.submatrix Subtype.val_injective).inv.posSemidef
  let R := fun x : ι → ℝ ↦ WithLp.toLp 2 (precisionResidualMatrix A Q *ᵥ (x - μ))
  have hi : (fun x ↦ x i - P[fun y ↦ y i | m] x) =ᵐ[P] fun x ↦ (R x : EuclideanSpace ℝ A) i := by
    filter_upwards [condExp_coord_eq_shift μ hQ A i] with x hx
    change _ = precisionConditionalShift μ A Q (fun j ↦ x j) i at hx
    rw [hx]
    exact sub_eq_iff_eq_add.mpr (precisionResidual_add_shift μ hQ A i x).symm
  have hj : (fun x ↦ x j - P[fun y ↦ y j | m] x) =ᵐ[P] fun x ↦ (R x : EuclideanSpace ℝ A) j := by
    filter_upwards [condExp_coord_eq_shift μ hQ A j] with x hx
    change _ = precisionConditionalShift μ A Q (fun i ↦ x i) j at hx
    rw [hx]
    exact sub_eq_iff_eq_add.mpr (precisionResidual_add_shift μ hQ A j x).symm
  have hC := condExp_precisionResidual μ hQ A (g := fun r ↦ r i * r j) (by fun_prop)
  have hI : ∫ r : EuclideanSpace ℝ A, r i * r j ∂multivariateGaussian 0 S = S i j := by
    simpa only [covariance, TauCeti.Probability.integral_eval_multivariateGaussian, PiLp.zero_apply,
      sub_zero] using covariance_eval_multivariateGaussian (μ := (0 : EuclideanSpace ℝ A)) hS i j
  exact (condExp_congr_ae (hi.mul hj)).trans (hC.trans (Filter.Eventually.of_forall fun _ ↦ hI))

omit [Fintype ι] in
/-- Index the two distinct vertices by a two-element finite type. -/
private def pairIndex (i j : ι) (hij : i ≠ j) : Fin 2 ≃ ({i, j} : Set ι) := by
  let a : ({i, j} : Set ι) := ⟨i, by simp⟩
  let b : ({i, j} : Set ι) := ⟨j, by simp⟩
  let f : Fin 2 → ({i, j} : Set ι) := fun k ↦ if k = 0 then a else b
  have hab : a ≠ b := fun h ↦ hij (congrArg Subtype.val h)
  refine Equiv.ofBijective f ⟨?_, ?_⟩
  · intro k l hk
    fin_cases k <;> fin_cases l <;> simp_all [f, Ne.symm hab]
  · intro k
    rcases Set.mem_insert_iff.mp k.property with hk | hk
    · exact ⟨0, by simpa [f, a] using (Subtype.ext hk.symm : a = k)⟩
    · exact ⟨1, by simpa [f, b] using (Subtype.ext (Set.mem_singleton_iff.mp hk).symm : b = k)⟩

omit [Fintype ι] [DecidableEq ι] in
/-- The entries of the inverse of the two-coordinate precision block. -/
private lemma principalInverse_pair_entries (Q : Matrix ι ι ℝ) {i j : ι}
    (hij : i ≠ j) [Fintype ({i, j} : Set ι)] [DecidableEq ({i, j} : Set ι)] :
    let a : ({i, j} : Set ι) := ⟨i, by simp⟩
    let b : ({i, j} : Set ι) := ⟨j, by simp⟩
    let B : Matrix ({i, j} : Set ι) ({i, j} : Set ι) ℝ := Q.submatrix Subtype.val Subtype.val
    B⁻¹ a a = B.det⁻¹ * Q j j ∧ B⁻¹ a b = B.det⁻¹ * -Q i j ∧
      B⁻¹ b b = B.det⁻¹ * Q i i := by
  intro a b B
  let e := pairIndex i j hij
  have he0 : e 0 = a := by
    change (if (0 : Fin 2) = 0 then a else b) = a
    simp
  have he1 : e 1 = b := by
    change (if (1 : Fin 2) = 0 then a else b) = b
    simp
  let M : Matrix (Fin 2) (Fin 2) ℝ := B.submatrix e e
  have hM_inv : M⁻¹ = B⁻¹.submatrix e e := Matrix.inv_reindex e.symm e.symm B
  have hMd : M.det = B.det := Matrix.det_submatrix_equiv_self e B
  have hM00 : M 0 0 = Q i i := by change Q (e 0) (e 0) = _; rw [he0]
  have hM11 : M 1 1 = Q j j := by change Q (e 1) (e 1) = _; rw [he1]
  have hM01 : M 0 1 = Q i j := by change Q (e 0) (e 1) = _; rw [he0, he1]
  rw [← he0, ← he1]
  change (B⁻¹.submatrix e e) 0 0 = _ ∧ (B⁻¹.submatrix e e) 0 1 = _ ∧
    (B⁻¹.submatrix e e) 1 1 = _
  rw [← hM_inv, Matrix.inv_def, Ring.inverse_eq_inv, Matrix.adjugate_fin_two, hMd]
  exact ⟨congrArg (B.det⁻¹ * ·) hM11, congrArg (fun t ↦ B.det⁻¹ * -t) hM01,
    congrArg (B.det⁻¹ * ·) hM00⟩

omit [Fintype ι] [DecidableEq ι] in
/-- The covariance inverse to the two-coordinate precision block gives its partial correlation. -/
private lemma principalInverse_pair_corr {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) {i j : ι}
    (hij : i ≠ j) [Fintype ({i, j} : Set ι)] [DecidableEq ({i, j} : Set ι)] :
    let a : ({i, j} : Set ι) := ⟨i, by simp⟩
    let b : ({i, j} : Set ι) := ⟨j, by simp⟩
    let S := (Q.submatrix (Subtype.val : ({i, j} : Set ι) → ι) Subtype.val)⁻¹
    S a b / Real.sqrt (S a a * S b b) = -Q i j / Real.sqrt (Q i i * Q j j) := by
  intro a b S
  let B : Matrix ({i, j} : Set ι) ({i, j} : Set ι) ℝ := Q.submatrix Subtype.val Subtype.val
  have hd : 0 < B.det := (hQ.submatrix Subtype.val_injective).det_pos
  obtain ⟨ha, hab, hb⟩ := principalInverse_pair_entries Q hij
  change B⁻¹ a a = B.det⁻¹ * Q j j at ha
  change B⁻¹ a b = B.det⁻¹ * -Q i j at hab
  change B⁻¹ b b = B.det⁻¹ * Q i i at hb
  change B⁻¹ a b / Real.sqrt (B⁻¹ a a * B⁻¹ b b) = _
  rw [ha, hab, hb]
  have hmul : B.det⁻¹ * Q j j * (B.det⁻¹ * Q i i) = (Q i i * Q j j) / B.det ^ 2 := by
    ring
  rw [hmul, Real.sqrt_div (mul_nonneg hQ.diag_pos.le hQ.diag_pos.le), Real.sqrt_sq hd.le]
  field_simp [hd.ne']

/-- SYNOPSIS item 55: `Corr(x_i, x_j ∣ x_{-ij}) = -Q_{ij} / (Q_{ii} Q_{jj})^{1/2}`, with the
conditional correlation formed from the conditional moments of the residuals
`r_k = x_k - E(x_k ∣ x_{-ij})`. -/
theorem condCorr_gaussianLaw_coord (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) {i j : ι}
    (hij : i ≠ j) :
    let P := gaussianLaw μ Q⁻¹
    let m := coordSigma ({i, j}ᶜ : Set ι)
    let r : ι → (ι → ℝ) → ℝ := fun k x ↦ x k - P[fun y ↦ y k | m] x
    (fun x ↦ P[fun y ↦ r i y * r j y | m] x /
        Real.sqrt (P[fun y ↦ r i y ^ 2 | m] x * P[fun y ↦ r j y ^ 2 | m] x)) =ᵐ[P]
      fun _ ↦ -Q i j / Real.sqrt (Q i i * Q j j) := by
  classical
  intro P m r
  let A : Set ι := {i, j}
  let a : A := ⟨i, by simp [A]⟩
  let b : A := ⟨j, by simp [A]⟩
  have hab := condExp_centered_mul μ hQ A a b
  have haa := condExp_centered_mul μ hQ A a a
  have hbb := condExp_centered_mul μ hQ A b b
  simp only [← pow_two] at haa hbb
  filter_upwards [hab, haa, hbb] with x hxy hxx hyy
  change P[fun y ↦ r i y * r j y | m] x = _ at hxy
  change P[fun y ↦ r i y ^ 2 | m] x = _ at hxx
  change P[fun y ↦ r j y ^ 2 | m] x = _ at hyy
  rw [hxy, hxx, hyy]
  exact principalInverse_pair_corr hQ hij

omit [Fintype ι] [DecidableEq ι] in
/-- The sigma algebra of a scalar coordinate equals that of its constant one-coordinate vector. -/
private lemma comap_unit_coord (i : ι) :
    MeasurableSpace.comap (fun (x : ι → ℝ) (_ : Unit) ↦ x i) inferInstance =
      MeasurableSpace.comap (fun x : ι → ℝ ↦ x i) inferInstance := by
  apply le_antisymm
  · rintro t ⟨s, hs, rfl⟩
    have hf : Measurable (fun (z : ℝ) (_ : Unit) ↦ z) := by fun_prop
    exact ⟨_, hf hs, rfl⟩
  · rw [← measurable_iff_comap_le]
    exact (measurable_pi_apply ()).comp
      (comap_measurable (fun (x : ι → ℝ) (_ : Unit) ↦ x i))

/-- SYNOPSIS item 55: for `x ∼ N(μ, Q⁻¹)` with `Q` positive definite and `i ≠ j`, `x_i` and `x_j`
are conditionally independent given `x_{-ij}` if and only if `Q_{ij} = 0`. -/
theorem condIndepFun_iff_precision_eq_zero (μ : ι → ℝ) {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    {i j : ι} (hij : i ≠ j) :
    CondIndepFun (coordSigma ({i, j}ᶜ : Set ι)) (coordSigma_le _) (fun x : ι → ℝ ↦ x i)
      (fun x ↦ x j) (gaussianLaw μ Q⁻¹) ↔ Q i j = 0 := by
  classical
  let A : Set ι := {i, j}
  let a : A := ⟨i, by simp [A]⟩
  let b : A := ⟨j, by simp [A]⟩
  let B : Matrix A A ℝ := Q.submatrix Subtype.val Subtype.val
  have h := condIndepFun_gaussian_coordSelections_iff μ hQ A (fun _ : Unit ↦ a) (fun _ : Unit ↦ b)
  rw [condIndepFun_iff_condIndep, comap_unit_coord i, comap_unit_coord j,
    ← condIndepFun_iff_condIndep] at h
  rw [h]
  have hab := (principalInverse_pair_entries Q hij).2.1
  change B⁻¹ a b = B.det⁻¹ * -Q i j at hab
  have hd : B.det ≠ 0 := (hQ.submatrix Subtype.val_injective).det_pos.ne'
  change (∀ (_ _ : Unit), B⁻¹ a b = 0) ↔ Q i j = 0
  rw [hab]
  simp [hd]

/-! ### Markov properties (SYNOPSIS item 56) -/

/-- `C` **separates** `A` from `B` in `G`: every walk from a vertex of `A` to a vertex of `B`
passes through `C`. -/
def Separates (G : SimpleGraph ι) (A B C : Set ι) : Prop :=
  ∀ a ∈ A, ∀ b ∈ B, ∀ p : G.Walk a b, ∃ v ∈ p.support, v ∈ C

/-- The **pairwise Markov property**: non-adjacent `x_i, x_j` are conditionally independent
given all other coordinates. -/
def PairwiseMarkov (G : SimpleGraph ι) (P : Measure (ι → ℝ)) [IsFiniteMeasure P] : Prop :=
  ∀ i j, i ≠ j → ¬ G.Adj i j →
    CondIndep (coordSigma ({i, j}ᶜ : Set ι)) (coordSigma {i}) (coordSigma {j})
      (coordSigma_le _) P

/-- The **local Markov property**: `x_i` is conditionally independent of the coordinates outside
`i` and its neighbours, given its neighbours. -/
def LocalMarkov (G : SimpleGraph ι) (P : Measure (ι → ℝ)) [IsFiniteMeasure P] : Prop :=
  ∀ i, CondIndep (coordSigma (G.neighborSet i)) (coordSigma {i})
    (coordSigma (insert i (G.neighborSet i))ᶜ) (coordSigma_le _) P

/-- The **global Markov property**: `x_A` and `x_B` are conditionally independent given `x_C`
whenever `A, B, C` are disjoint, `A, B` nonempty, and `C` separates `A` from `B`. -/
def GlobalMarkov (G : SimpleGraph ι) (P : Measure (ι → ℝ)) [IsFiniteMeasure P] : Prop :=
  ∀ A B C : Set ι, Disjoint A B → Disjoint A C → Disjoint B C → A.Nonempty → B.Nonempty →
    Separates G A B C → CondIndep (coordSigma C) (coordSigma A) (coordSigma B) (coordSigma_le _) P

omit [Fintype ι] [DecidableEq ι] in
lemma separates_def {G : SimpleGraph ι} {A B C : Set ι} :
    Separates G A B C ↔ ∀ a ∈ A, ∀ b ∈ B, ∀ p : G.Walk a b, ∃ v ∈ p.support, v ∈ C := Iff.rfl

omit [DecidableEq ι] in
lemma pairwiseMarkov_def {G : SimpleGraph ι} {P : Measure (ι → ℝ)} [IsFiniteMeasure P] :
    PairwiseMarkov G P ↔ ∀ i j, i ≠ j → ¬ G.Adj i j →
      CondIndep (coordSigma ({i, j}ᶜ : Set ι)) (coordSigma {i}) (coordSigma {j})
        (coordSigma_le _) P := Iff.rfl

omit [DecidableEq ι] in
lemma localMarkov_def {G : SimpleGraph ι} {P : Measure (ι → ℝ)} [IsFiniteMeasure P] :
    LocalMarkov G P ↔ ∀ i, CondIndep (coordSigma (G.neighborSet i)) (coordSigma {i})
      (coordSigma (insert i (G.neighborSet i))ᶜ) (coordSigma_le _) P := Iff.rfl

omit [DecidableEq ι] in
lemma globalMarkov_def {G : SimpleGraph ι} {P : Measure (ι → ℝ)} [IsFiniteMeasure P] :
    GlobalMarkov G P ↔ ∀ A B C : Set ι, Disjoint A B → Disjoint A C → Disjoint B C →
      A.Nonempty → B.Nonempty → Separates G A B C →
        CondIndep (coordSigma C) (coordSigma A) (coordSigma B) (coordSigma_le _) P := Iff.rfl

/-- When the precision has no cross-entries between a block and its complement, the same
is true of its inverse. -/
private lemma inverse_apply_eq_zero_of_block {υ : Type*} [Fintype υ] [DecidableEq υ]
    {M : Matrix υ υ ℝ} (hM : M.PosDef) (U : Set υ) {i j : υ} (hi : i ∈ U) (hj : j ∉ U)
    (hU : ∀ u ∈ U, ∀ v ∉ U, M u v = 0) : M⁻¹ i j = 0 := by
  classical
  let M₀ : Matrix U U ℝ := M.submatrix Subtype.val Subtype.val
  let v : U → ℝ := fun k ↦ M⁻¹ k j
  have hd : IsUnit M.det := (Matrix.isUnit_iff_isUnit_det _).mp hM.isUnit
  have hd₀ : IsUnit M₀.det :=
    (Matrix.isUnit_iff_isUnit_det _).mp (hM.submatrix Subtype.val_injective).isUnit
  have hv : M₀ *ᵥ v = 0 := by
    funext u
    change (∑ k : U, M u k * M⁻¹ k j) = 0
    rw [Finset.sum_set_coe (f := fun k : υ ↦ M u k * M⁻¹ k j) U]
    calc
      _ = ∑ k, M u k * M⁻¹ k j := Finset.sum_subset (Finset.subset_univ _) (by
        intro k _ hk
        rw [hU u u.property k (fun h ↦ hk (Set.mem_toFinset.mpr h)), zero_mul])
      _ = 0 := by
        change (M * M⁻¹) u j = 0
        have hne : (u : υ) ≠ j := fun h ↦ hj (h ▸ u.property)
        rw [Matrix.mul_nonsing_inv M hd, Matrix.one_apply_ne hne]
  have hv₀ := congrArg (fun z ↦ M₀⁻¹ *ᵥ z) hv
  rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul M₀ hd₀, Matrix.one_mulVec,
    Matrix.mulVec_zero] at hv₀
  exact congrFun hv₀ ⟨i, hi⟩

/-- The inverse of the precision block on vertices outside a separator has zero cross-entries
between the separated sets. -/
private lemma globalMarkov_of_precisionZeros (G : SimpleGraph ι) (μ : ι → ℝ)
    {Q : Matrix ι ι ℝ} (hQ : Q.PosDef)
    (hprec : ∀ i j, i ≠ j → ¬ G.Adj i j → Q i j = 0) :
    GlobalMarkov G (gaussianLaw μ Q⁻¹) := by
  classical
  intro A B C _ hAC hBC _ _ hsep
  let D := Cᶜ
  let H := G.induce D
  let a : A → D := fun i ↦ ⟨i, fun h ↦ Set.disjoint_left.mp hAC i.property h⟩
  let b : B → D := fun j ↦ ⟨j, fun h ↦ Set.disjoint_left.mp hBC j.property h⟩
  let M : Matrix D D ℝ := Q.submatrix Subtype.val Subtype.val
  have hM : M.PosDef := hQ.submatrix Subtype.val_injective
  have hcross (i : A) (j : B) : M⁻¹ (a i) (b j) = 0 := by
    let U : Set D := {u | H.Reachable (a i) u}
    have hreach : b j ∉ U := by
      rintro ⟨w⟩
      let f : H →g G := ⟨Subtype.val, fun h ↦ h⟩
      obtain ⟨v, hv, hvC⟩ := hsep i i.property j j.property (w.map f)
      rw [SimpleGraph.Walk.support_map] at hv
      obtain ⟨u, _, rfl⟩ := List.mem_map.mp hv
      exact u.property hvC
    apply inverse_apply_eq_zero_of_block hM U (i := a i) (j := b j)
      SimpleGraph.Reachable.rfl hreach
    intro u hu v hv
    have hne : (u : ι) ≠ (v : ι) := fun h ↦ hv (Subtype.ext h ▸ hu)
    have hAdj : ¬ G.Adj (u : ι) (v : ι) := by
      intro h
      exact hv (SimpleGraph.Reachable.trans hu
        (SimpleGraph.Adj.reachable (show H.Adj u v from h)))
    exact hprec u v hne hAdj
  have h := (condIndepFun_gaussian_coordSelections_iff μ hQ D a b).mpr hcross
  rw [condIndepFun_iff_condIndep] at h
  simpa only [D, compl_compl, coordSigma_def] using h

omit [Fintype ι] [DecidableEq ι] in
/-- A singleton coordinate set generates the same sigma algebra as its scalar coordinate map. -/
private lemma coordSigma_singleton (i : ι) :
    coordSigma {i} = MeasurableSpace.comap (fun x : ι → ℝ ↦ x i) inferInstance := by
  rw [coordSigma_def]
  apply le_antisymm
  · rintro t ⟨s, hs, rfl⟩
    have hm : Measurable (fun (z : ℝ) (_ : ({i} : Set ι)) ↦ z) := by fun_prop
    refine ⟨_, hm hs, ?_⟩
    have h (x : ι → ℝ) (j : ({i} : Set ι)) : x j = x i :=
      congrArg x (Set.mem_singleton_iff.mp j.property)
    exact congrArg (fun f ↦ f ⁻¹' s) (funext fun x ↦ funext fun j ↦ (h x j).symm)
  · rw [← measurable_iff_comap_le]
    exact (measurable_pi_apply (⟨i, rfl⟩ : ({i} : Set ι))).comp
      (comap_measurable (fun (x : ι → ℝ) (j : ({i} : Set ι)) ↦ x j))

/-- SYNOPSIS item 56: a Gaussian law with positive definite precision `Q` is pairwise Markov for
`G` if and only if `Q_{ij} = 0` for every non-adjacent pair `i ≠ j`. -/
theorem pairwiseMarkov_gaussianLaw_inv_iff (G : SimpleGraph ι) (μ : ι → ℝ)
    {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) :
    PairwiseMarkov G (gaussianLaw μ Q⁻¹) ↔ ∀ i j, i ≠ j → ¬ G.Adj i j → Q i j = 0 := by
  rw [pairwiseMarkov_def]
  simp_rw [coordSigma_singleton, ← condIndepFun_iff_condIndep]
  constructor
  · intro h i j hij hG
    exact (condIndepFun_iff_precision_eq_zero μ hQ hij).mp (h i j hij hG)
  · intro h i j hij hG
    exact (condIndepFun_iff_precision_eq_zero μ hQ hij).mpr (h i j hij hG)

omit [DecidableEq ι] in
/-- The neighbours of a vertex separate it from the other vertices. -/
private lemma localMarkov_of_globalMarkov (G : SimpleGraph ι) (P : Measure (ι → ℝ))
    [IsFiniteMeasure P] (h : GlobalMarkov G P) : LocalMarkov G P := by
  intro i
  let C := G.neighborSet i
  let B := (insert i C)ᶜ
  by_cases hB : B.Nonempty
  · have hiC : i ∉ C := G.irrefl
    have hiB : i ∉ B := fun hi ↦ hi (Set.mem_insert i C)
    have hBC : Disjoint B C := Set.disjoint_left.mpr fun _ hb hc ↦
      hb (Set.mem_insert_of_mem _ hc)
    have hsep : Separates G {i} B C := by
      intro a ha b hb w
      have ha' := Set.mem_singleton_iff.mp ha
      subst a
      cases w with
      | nil => exact (hiB hb).elim
      | cons hadj p =>
          exact ⟨_, List.mem_cons_of_mem _ p.start_mem_support, hadj⟩
    exact h {i} B C (Set.disjoint_singleton_left.mpr hiB) (Set.disjoint_singleton_left.mpr hiC)
      hBC (Set.singleton_nonempty i) hB hsep
  · have he : B = ∅ := Set.not_nonempty_iff_eq_empty.mp hB
    have hempty : coordSigma (∅ : Set ι) = ⊥ := by
      rw [coordSigma_def]
      have hh : (fun (x : ι → ℝ) (j : (∅ : Set ι)) ↦ x j) =
          fun _ j ↦ (j.property : False).elim := by
        funext x j
        exact (j.property : False).elim
      rw [hh, MeasurableSpace.comap_const]
    change CondIndep (coordSigma C) (coordSigma {i}) (coordSigma B) (coordSigma_le C) P
    rw [he, hempty]
    exact condIndep_bot_right _

/-- The local Gaussian Markov property forces zero precision entries at nonedges. -/
private lemma precisionZeros_of_localMarkov (G : SimpleGraph ι) (μ : ι → ℝ)
    {Q : Matrix ι ι ℝ} (hQ : Q.PosDef) (h : LocalMarkov G (gaussianLaw μ Q⁻¹)) :
    ∀ i j, i ≠ j → ¬ G.Adj i j → Q i j = 0 := by
  classical
  intro i j hij hj
  let C := G.neighborSet i
  let D := Cᶜ
  let B := (insert i C)ᶜ
  let a : D := ⟨i, G.irrefl⟩
  let b : B → D := fun k ↦ ⟨k, fun hk ↦ k.property (Set.mem_insert_of_mem _ hk)⟩
  let t : D := ⟨j, hj⟩
  let M : Matrix D D ℝ := Q.submatrix Subtype.val Subtype.val
  have hM : M.PosDef := hQ.submatrix Subtype.val_injective
  have hGauss : CondIndepFun (coordSigma Dᶜ) (coordSigma_le _)
      (fun (x : ι → ℝ) (_ : Unit) ↦ x a) (fun x (k : B) ↦ x (b k))
      (gaussianLaw μ Q⁻¹) := by
    rw [condIndepFun_iff_condIndep, comap_unit_coord i, ← coordSigma_singleton]
    have hi := h i
    simpa only [D, compl_compl, C, coordSigma_def] using hi
  have hcov := (condIndepFun_gaussian_coordSelections_iff μ hQ D (fun _ : Unit ↦ a) b).mp hGauss
  have ht : t ∉ ({a} : Set D) := fun ht ↦
    hij ((congrArg Subtype.val (Set.mem_singleton_iff.mp ht)).symm)
  have hcross (u : D) (hu : u ∈ ({a} : Set D)) (v : D) (hv : v ∉ ({a} : Set D)) :
      M⁻¹ u v = 0 := by
    have he := Set.mem_singleton_iff.mp hu
    subst u
    have hvB : (v : ι) ∈ B := by
      intro hb
      rcases Set.mem_insert_iff.mp hb with hb | hb
      · exact hv (Set.mem_singleton_iff.mpr (Subtype.ext hb))
      · exact v.property hb
    exact hcov () ⟨v, hvB⟩
  have Hz := inverse_apply_eq_zero_of_block hM.inv ({a} : Set D) (Set.mem_singleton a) ht hcross
  rw [Matrix.nonsing_inv_nonsing_inv _ ((Matrix.isUnit_iff_isUnit_det _).mp hM.isUnit)] at Hz
  exact Hz

/-- SYNOPSIS item 56: for a nondegenerate Gaussian law, the pairwise, local, and global Markov
properties with respect to any graph are equivalent. -/
theorem gaussianLaw_markov_tfae (G : SimpleGraph ι) (μ : ι → ℝ) {S : Matrix ι ι ℝ}
    (hS : S.PosDef) :
    List.TFAE [PairwiseMarkov G (gaussianLaw μ S), LocalMarkov G (gaussianLaw μ S),
      GlobalMarkov G (gaussianLaw μ S)] := by
  have hSdet := (Matrix.isUnit_iff_isUnit_det _).mp hS.isUnit
  have hRepr := Matrix.nonsing_inv_nonsing_inv S hSdet
  have h12 : LocalMarkov G (gaussianLaw μ S) → PairwiseMarkov G (gaussianLaw μ S) := by
    rw [← hRepr]
    intro h
    exact (pairwiseMarkov_gaussianLaw_inv_iff G μ hS.inv).mpr
      (precisionZeros_of_localMarkov G μ hS.inv h)
  have h23 : PairwiseMarkov G (gaussianLaw μ S) → GlobalMarkov G (gaussianLaw μ S) := by
    rw [← hRepr]
    intro h
    exact globalMarkov_of_precisionZeros G μ hS.inv
      ((pairwiseMarkov_gaussianLaw_inv_iff G μ hS.inv).mp h)
  tfae_have 2 → 1 := h12
  tfae_have 1 → 3 := h23
  tfae_have 3 → 2 := localMarkov_of_globalMarkov G _
  tfae_finish

/-- SYNOPSIS item 56: a Gaussian Markov random field for `G` (`Q_{ij} ≠ 0` exactly for
neighbours `i ∼ j`) has the global Markov property; for `C = ∅` this is independence. -/
theorem globalMarkov_gaussianLaw (G : SimpleGraph ι) (μ : ι → ℝ) {Q : Matrix ι ι ℝ}
    (hQ : Q.PosDef) (hG : ∀ i j, i ≠ j → (Q i j ≠ 0 ↔ G.Adj i j)) :
    GlobalMarkov G (gaussianLaw μ Q⁻¹) :=
  globalMarkov_of_precisionZeros G μ hQ fun i j hij h ↦ not_not.mp (mt (hG i j hij).mp h)

end MSSS
