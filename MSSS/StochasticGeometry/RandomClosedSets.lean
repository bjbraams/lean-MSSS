variable {E : Type*} [NormedAddCommGroup E]

/-- A translated grain meets a set iff its translation vector belongs to their difference. -/
lemma image_add_right_inter_nonempty_iff_mem_sub {F K : Set E} {x : E} :
    (((· + x) '' F) ∩ K).Nonempty ↔ x ∈ K - F := by
  constructor
  · rintro ⟨_, ⟨v, hv, rfl⟩, hk⟩
    refine Set.mem_sub.mpr ⟨v + x, hk, v, hv, ?_⟩
    abel
  · rintro ⟨y, hy, v, hv, rfl⟩
    refine ⟨y, ⟨v, hv, ?_⟩, hy⟩
    exact add_sub_cancel v y

/-- For a compact test set, the event that a translated closed grain hits it is jointly
measurable in the translation and the grain. -/
lemma measurableSet_image_add_right_inter_nonempty [ProperSpace E] [SecondCountableTopology E]
    [MeasurableSpace E] [BorelSpace E] {K : Set E} (hK : IsCompact K) :
    MeasurableSet {p : E × Closeds E | (((· + p.1) '' (p.2 : Set E)) ∩ K).Nonempty} := by
  let a : ℕ → E := denseSeq E
  let ε (n : ℕ) : ℝ := 1 / (↑n + 1)
  let B (n m : ℕ) := K + closedBall (- a m) (ε n)
  have hε (n : ℕ) : 0 < ε n := by positivity
  have hc (n m : ℕ) : IsCompact (B n m) := hK.add (isCompact_closedBall _ _)
  have hmeas : MeasurableSet (⋃ n : ℕ, ⋃ m : ℕ, ball (a m) (ε n) ×ˢ
      {F : Closeds E | (F : Set E) ∩ B n m = ∅}) := by
    refine MeasurableSet.iUnion fun n ↦ MeasurableSet.iUnion fun m ↦
      measurableSet_ball.prod ?_
    exact measurableSet_miss_compact measurable_id (hc n m)
  have heq : (⋃ n : ℕ, ⋃ m : ℕ, ball (a m) (ε n) ×ˢ
      {F : Closeds E | (F : Set E) ∩ B n m = ∅}) =
        {p : E × Closeds E | (((· + p.1) '' (p.2 : Set E)) ∩ K).Nonempty}ᶜ := by
    ext p
    simp only [mem_iUnion, mem_prod, mem_ofPred_eq, mem_compl_iff,
      image_add_right_inter_nonempty_iff_mem_sub]
    constructor
    · rintro ⟨n, m, hxm, hmiss⟩ ⟨k, hk, z, hz, h⟩
      have hzB : z ∈ B n m := by
        refine Set.mem_add.mpr ⟨k, hk, -p.1, ?_, ?_⟩
        · simpa only [mem_closedBall, dist_neg_neg] using hxm.le
        · rw [← h]
          exact neg_sub k z ▸ add_sub_cancel k z
      exact Set.notMem_empty z (hmiss ▸ ⟨hz, hzB⟩)
    · intro hmiss
      have hclosed : IsClosed (K - (p.2 : Set E)) := by
        rw [sub_eq_add_neg]
        exact p.2.isClosed.neg.add_left_of_isCompact hK
      obtain ⟨δ, hδ, hball⟩ := isOpen_iff.mp hclosed.isOpen_compl p.1 hmiss
      obtain ⟨n, hn⟩ := exists_nat_one_div_lt (half_pos hδ)
      obtain ⟨m, hxm⟩ := Metric.denseRange_iff.mp (denseRange_denseSeq E) p.1 (ε n) (hε n)
      refine ⟨n, m, hxm, Set.eq_empty_iff_forall_notMem.mpr ?_⟩
      rintro z ⟨hz, k, hk, v, hv, rfl⟩
      have hv' : dist (-v) (a m) ≤ ε n := by
        simpa only [mem_closedBall, ← dist_neg_neg v (-a m), neg_neg] using hv
      have hdist : dist (k - (k + v)) p.1 < δ := by
        have hneg : k - (k + v) = -v := by abel
        rw [hneg]
        have htri := dist_triangle (-v) (a m) p.1
        rw [dist_comm (a m) p.1] at htri
        dsimp only [ε] at hv' hxm
        linarith only [htri, hv', hxm, hn]
      exact hball hdist (Set.mem_sub.mpr ⟨k, hk, k + v, hz, rfl⟩)
  rw [heq] at hmeas
  exact MeasurableSet.of_compl hmeas

end TranslatedHit

variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}

local notation "V" => EuclideanSpace ℝ (Fin d)

/-- The data `(κ, x, G)` form a **Boolean model** with intensity `λ` and grain law `Q`. -/
structure IsBooleanModel (P : Measure Ω) (κ : Ω → ℕ∞) (x : Ω → ℕ → EuclideanSpace ℝ (Fin d))
    (G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))) (lam : ℝ)
    (Q : Measure (Closeds (EuclideanSpace ℝ (Fin d)))) : Prop where
  /-- `P` is a probability measure. -/
  isProbabilityMeasure : IsProbabilityMeasure P
  /-- The intensity is positive. -/
  lam_pos : 0 < lam
  /-- The germs are a stationary Poisson process of intensity `λ`. -/
  poisson : IsPoissonRandomMeasure P (fun ω ↦ pointSum (finiteMask (κ ω)) (x ω))
    (ENNReal.ofReal lam • volume)
  /-- The germs are measurable. -/
  measurable_germs : Measurable fun ω ↦ (κ ω, x ω)
  /-- The grains are measurable. -/
  measurable_grains : Measurable G
  /-- `Q` is a probability measure. -/
  isProbabilityMeasure_grain : IsProbabilityMeasure Q
  /-- The grains are independent with law `Q` and independent of the germs. -/
  law : P.map (fun ω ↦ ((κ ω, x ω), G ω)) =
    (P.map fun ω ↦ (κ ω, x ω)).prod (Measure.infinitePi fun _ ↦ Q)
  /-- The grains are almost surely compact. -/
  compact : ∀ᵐ (F : Closeds (EuclideanSpace ℝ (Fin d))) ∂Q,
    IsCompact (F : Set (EuclideanSpace ℝ (Fin d)))
  /-- `E V_d(Ξ_0 ⊕ K) < ∞` for compact `K`. -/
  meanVolume_lt_top : ∀ K, IsCompact K →
    ∫⁻ (F : Closeds (EuclideanSpace ℝ (Fin d))),
      volume ((F : Set (EuclideanSpace ℝ (Fin d))) + K) ∂Q < ∞

/-- The union `Ξ = ⋃_{n < κ} (x_n + Ξ_n)`. -/
def booleanSet (κ : Ω → ℕ∞) (x : Ω → ℕ → EuclideanSpace ℝ (Fin d))
    (G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))) (ω : Ω) : Set (EuclideanSpace ℝ (Fin d)) :=
  ⋃ n : ℕ, ⋃ (_ : (n : ℕ∞) < κ ω), (· + x ω n) '' (G ω n : Set (EuclideanSpace ℝ (Fin d)))

/-- The mean volume `E V_d(Ξ_0 ⊕ K)`. -/
def grainMeanVolume (Q : Measure (Closeds (EuclideanSpace ℝ (Fin d))))
    (K : Set (EuclideanSpace ℝ (Fin d))) : ℝ :=
  (∫⁻ (F : Closeds (EuclideanSpace ℝ (Fin d))),
    volume ((F : Set (EuclideanSpace ℝ (Fin d))) + K) ∂Q).toReal

/-- The **contact distribution function** `H_B(r) = 1 - P(0 ∉ Ξ ⊕ rB) / (1 - p)` with
`p = P(0 ∈ Ξ)`. -/
def contactDistribution (P : Measure Ω) (Ξ : Ω → Set (EuclideanSpace ℝ (Fin d)))
    (B : Set (EuclideanSpace ℝ (Fin d))) (r : ℝ) : ℝ :=
  1 - (P {ω | (0 : EuclideanSpace ℝ (Fin d)) ∉ Ξ ω + r • B}).toReal /
    (1 - (P {ω | (0 : EuclideanSpace ℝ (Fin d)) ∈ Ξ ω}).toReal)

omit [MeasurableSpace Ω] in
lemma booleanSet_def (κ : Ω → ℕ∞) (x : Ω → ℕ → EuclideanSpace ℝ (Fin d))
    (G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))) (ω : Ω) : booleanSet κ x G ω =
      ⋃ n : ℕ, ⋃ (_ : (n : ℕ∞) < κ ω), (· + x ω n) '' (G ω n : Set (EuclideanSpace ℝ (Fin d))) := by
  rw [booleanSet]

lemma grainMeanVolume_def (Q : Measure (Closeds (EuclideanSpace ℝ (Fin d))))
    (K : Set (EuclideanSpace ℝ (Fin d))) : grainMeanVolume Q K =
      (∫⁻ (F : Closeds (EuclideanSpace ℝ (Fin d))),
        volume ((F : Set (EuclideanSpace ℝ (Fin d))) + K) ∂Q).toReal := by
  rw [grainMeanVolume]

lemma contactDistribution_def (P : Measure Ω) (Ξ : Ω → Set (EuclideanSpace ℝ (Fin d)))
    (B : Set (EuclideanSpace ℝ (Fin d))) (r : ℝ) : contactDistribution P Ξ B r =
      1 - (P {ω | (0 : EuclideanSpace ℝ (Fin d)) ∉ Ξ ω + r • B}).toReal /
        (1 - (P {ω | (0 : EuclideanSpace ℝ (Fin d)) ∈ Ξ ω}).toReal) := by
  rw [contactDistribution]

/-- The germ-grain process is a Poisson process with the product intensity. -/
lemma IsBooleanModel.markedPoisson {P : Measure Ω} {κ : Ω → ℕ∞}
    {x : Ω → ℕ → V} {G : Ω → ℕ → Closeds V} {lam : ℝ}
    {Q : Measure (Closeds V)} (hB : IsBooleanModel P κ x G lam Q) :
    IsPoissonRandomMeasure P (fun ω ↦
      pointSum (finiteMask (κ ω)) (fun n ↦ (x ω n, G ω n)))
      ((ENNReal.ofReal lam • volume).prod Q) := by
  let := hB.isProbabilityMeasure
  let := hB.isProbabilityMeasure_grain
  rw [← Measure.compProd_const]
  refine isPoissonRandomMeasure_marking_of_map_eq_compProd (Kernel.const V Q) κ x G
    hB.measurable_germs hB.measurable_grains hB.poisson
    (Kernel.const (ℕ∞ × (ℕ → V)) (Measure.infinitePi fun _ : ℕ ↦ Q)) ?_ ?_
  · simpa only [Measure.compProd_const] using hB.law
  · exact ae_of_all _ fun _ ↦ by simp only [Kernel.const_apply]

/-- The germ positions where a fixed grain hits a test set have the volume of the
grain added to the reflected test set. -/
lemma volume_sub_eq_volume_add_neg (F K : Set V) :
    volume (K - F) = volume (F + -K) := by
  have h : F + -K = -(K - F) := by
    ext y
    rw [Set.mem_neg]
    constructor
    · rintro ⟨z, hz, w, hw, rfl⟩
      exact ⟨-w, Set.mem_neg.mp hw, z, hz, by dsimp; abel⟩
    · rintro ⟨k, hk, f, hf, h⟩
      refine ⟨f, hf, -k, Set.mem_neg.mpr (by simpa only [neg_neg] using hk), ?_⟩
      have he : k - f = -y := h
      rw [← neg_neg y, ← he]
      dsimp
      abel
  rw [h, Measure.measure_neg]

/-- The count of marked points in the hit event is the sum of the corresponding indicators. -/
lemma pointSum_apply_hit {κ : ℕ∞} (x : ℕ → V) (G : ℕ → Closeds V)
    {K : Set V} (hK : IsCompact K) :
    pointSum (finiteMask κ) (fun n ↦ (x n, G n))
      {z : V × Closeds V | (((· + z.1) '' (z.2 : Set V)) ∩ K).Nonempty} =
    ∑' n, ({n : ℕ | (n : ℕ∞) < κ ∧ (((· + x n) '' (G n : Set V)) ∩ K).Nonempty}.indicator
      (1 : ℕ → ℝ≥0∞) n) := by
  classical
  rw [pointSum_def, Measure.sum_apply _ (measurableSet_image_add_right_inter_nonempty hK)]
  apply tsum_congr
  intro n
  by_cases hκ : (n : ℕ∞) < κ
  · rw [ite_eq_left (by simpa only [finiteMask_def, decide_eq_true_eq] using hκ)]
    rw [Measure.dirac_apply' _ (measurableSet_image_add_right_inter_nonempty hK)]
    simp only [Set.indicator, Pi.one_apply, mem_ofPred_eq, hκ, true_and]
  · simp [finiteMask_def, hκ, Set.indicator]

/-- The intensity of grains that hit a compact window is the mean translated volume. -/
lemma prod_measure_hit_eq {Q : Measure (Closeds V)} [IsProbabilityMeasure Q]
    {lam : ℝ} (F : Set V) (hF : IsCompact F) :
    ((ENNReal.ofReal lam • volume).prod Q)
      {z : V × Closeds V | (((· + z.1) '' (z.2 : Set V)) ∩ F).Nonempty} =
    ENNReal.ofReal lam * ∫⁻ K : Closeds V, volume ((K : Set V) + -F) ∂Q := by
  rw [Measure.prod_smul_left, smul_apply, smul_eq_mul,
    Measure.prod_apply_symm (measurableSet_image_add_right_inter_nonempty hF)]
  congr 1
  apply lintegral_congr
  intro K
  rw [← volume_sub_eq_volume_add_neg (K : Set V) F]
  congr 1
  ext p
  exact image_add_right_inter_nonempty_iff_mem_sub

/-- SYNOPSIS item 113: the number of grains hitting a compact `K` is Poisson with mean
`λ E V_d(Ξ_0 ⊕ Ǩ)`. -/
theorem boolean_hitCount {P : Measure Ω} {κ : Ω → ℕ∞} {x : Ω → ℕ → EuclideanSpace ℝ (Fin d)}
    {G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))} {lam : ℝ}
    {Q : Measure (Closeds (EuclideanSpace ℝ (Fin d)))} (hB : IsBooleanModel P κ x G lam Q)
    {K : Set (EuclideanSpace ℝ (Fin d))} (hK : IsCompact K) :
    HasLaw (fun ω ↦ ∑' n, ({n : ℕ | (n : ℕ∞) < κ ω ∧
        ((· + x ω n) '' (G ω n : Set (EuclideanSpace ℝ (Fin d))) ∩ K).Nonempty}.indicator
          (1 : ℕ → ℝ≥0∞) n))
      ((poissonMeasure (Real.toNNReal (lam * grainMeanVolume Q (-K)))).map
        (Nat.cast : ℕ → ℝ≥0∞)) P := by
  let := hB.isProbabilityMeasure_grain
  let hit := {z : V × Closeds V | (((· + z.1) '' (z.2 : Set V)) ∩ K).Nonempty}
  have hr : ((ENNReal.ofReal lam • volume).prod Q) hit =
      ENNReal.ofReal (lam * grainMeanVolume Q (-K)) := by
    rw [prod_measure_hit_eq K hK, grainMeanVolume_def, ENNReal.ofReal_mul hB.lam_pos.le,
      ENNReal.ofReal_toReal (hB.meanVolume_lt_top (-K) hK.neg).ne]
  have hfin : ((ENNReal.ofReal lam • volume).prod Q) hit < ∞ := by
    rw [hr]
    exact ENNReal.ofReal_lt_top
  have h := hB.markedPoisson.hasLaw (measurableSet_image_add_right_inter_nonempty hK) hfin
  -- Evaluate the marked counting measure on the hit region.
  change HasLaw (fun ω ↦ pointSum (finiteMask (κ ω)) (fun n ↦ (x ω n, G ω n)) hit) _ P at h
  have hNN : (ENNReal.ofReal (lam * grainMeanVolume Q (-K))).toNNReal =
      (lam * grainMeanVolume Q (-K)).toNNReal := rfl
  simpa only [hr, hNN, hit, pointSum_apply_hit _ _ hK] using h


omit [MeasurableSpace Ω] in
/-- The Boolean union hits the test set precisely when the marked count is nonzero. -/
lemma booleanSet_inter_nonempty_iff_pointSum_ne_zero {κ : Ω → ℕ∞}
    (x : Ω → ℕ → V) (G : Ω → ℕ → Closeds V) (ω : Ω) {K : Set V} (hK : IsCompact K) :
    (booleanSet κ x G ω ∩ K).Nonempty ↔
      pointSum (finiteMask (κ ω)) (fun n ↦ (x ω n, G ω n))
        {z : V × Closeds V | (((· + z.1) '' (z.2 : Set V)) ∩ K).Nonempty} ≠ 0 := by
  classical
  rw [pointSum_apply_hit _ _ hK, ne_eq, tsum_eq_zero_iff]
  have hhit : (booleanSet κ x G ω ∩ K).Nonempty ↔
      ∃ n : ℕ, (n : ℕ∞) < κ ω ∧
        (((· + x ω n) '' (G ω n : Set V)) ∩ K).Nonempty := by
    constructor
    · rintro ⟨p, hp, hKp⟩
      obtain ⟨n, hn⟩ := mem_iUnion.mp hp
      obtain ⟨hnκ, hp⟩ := mem_iUnion.mp hn
      exact ⟨n, hnκ, p, hp, hKp⟩
    · rintro ⟨n, hnκ, p, hp, hKp⟩
      exact ⟨p, mem_iUnion.mpr ⟨n, mem_iUnion.mpr ⟨hnκ, hp⟩⟩, hKp⟩
  rw [hhit]
  push Not
  simp [Set.indicator]

/-- The event that the Boolean union hits a compact set is measurable. -/
lemma IsBooleanModel.measurableSet_hit {P : Measure Ω} {κ : Ω → ℕ∞}
    {x : Ω → ℕ → V} {G : Ω → ℕ → Closeds V} {lam : ℝ}
    {Q : Measure (Closeds V)} (hB : IsBooleanModel P κ x G lam Q) {K : Set V}
    (hK : IsCompact K) :
    MeasurableSet {ω | (booleanSet κ x G ω ∩ K).Nonempty} := by
  simp_rw [booleanSet_inter_nonempty_iff_pointSum_ne_zero x G _ hK]
  exact (measurableSet_eq_fun ((Measure.measurable_coe
    (measurableSet_image_add_right_inter_nonempty hK)).comp hB.markedPoisson.measurable)
      measurable_const).compl

/-- The probability that the Boolean union misses a compact set is the zero-count probability. -/
lemma IsBooleanModel.measureReal_miss {P : Measure Ω} {κ : Ω → ℕ∞}
    {x : Ω → ℕ → V} {G : Ω → ℕ → Closeds V} {lam : ℝ}
    {Q : Measure (Closeds V)} (hB : IsBooleanModel P κ x G lam Q) {K : Set V} (hK : IsCompact K) :
    P.real {ω | ¬ (booleanSet κ x G ω ∩ K).Nonempty} =
      Real.exp (-lam * grainMeanVolume Q (-K)) := by
  have hz := measureReal_count_eq_zero_of_hasLaw_poisson (boolean_hitCount hB hK)
  have hnonneg : 0 ≤ lam * grainMeanVolume Q (-K) :=
    mul_nonneg hB.lam_pos.le ENNReal.toReal_nonneg
  rw [Real.coe_toNNReal _ hnonneg] at hz
  simp_rw [booleanSet_inter_nonempty_iff_pointSum_ne_zero x G _ hK, not_ne_iff,
    pointSum_apply_hit _ _ hK]
  simpa only [neg_mul] using hz

/-- SYNOPSIS item 113: the capacity functional of the Boolean model is
`T(K) = 1 - exp(-λ E V_d(Ξ_0 ⊕ Ǩ))` for compact `K`, with `Ǩ = -K`. -/
theorem boolean_capacity {P : Measure Ω} {κ : Ω → ℕ∞} {x : Ω → ℕ → EuclideanSpace ℝ (Fin d)}
    {G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))} {lam : ℝ}
    {Q : Measure (Closeds (EuclideanSpace ℝ (Fin d)))} (hB : IsBooleanModel P κ x G lam Q)
    {K : Set (EuclideanSpace ℝ (Fin d))} (hK : IsCompact K) :
    (P {ω | (booleanSet κ x G ω ∩ K).Nonempty}).toReal =
      1 - Real.exp (-lam * grainMeanVolume Q (-K)) := by
  let := hB.isProbabilityMeasure
  have hc := probReal_compl_eq_one_sub (μ := P) (hB.measurableSet_hit hK)
  rw [Set.compl_ofPred, hB.measureReal_miss hK] at hc
  rw [← measureReal_def]
  linarith only [hc]

/-- SYNOPSIS item 113: the volume fraction is `p = P(0 ∈ Ξ) = 1 - e^{-λ E V_d(Ξ_0)}`. -/
theorem boolean_volumeFraction {P : Measure Ω} {κ : Ω → ℕ∞}
    {x : Ω → ℕ → EuclideanSpace ℝ (Fin d)} {G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))}
    {lam : ℝ} {Q : Measure (Closeds (EuclideanSpace ℝ (Fin d)))}
    (hB : IsBooleanModel P κ x G lam Q) :
    (P {ω | (0 : EuclideanSpace ℝ (Fin d)) ∈ booleanSet κ x G ω}).toReal =
      1 - Real.exp (-lam * grainMeanVolume Q {0}) := by
  simpa using boolean_capacity hB (isCompact_singleton (x := (0 : V)))


/-- The origin is in a sum iff the first set hits the reflection of the second. -/
lemma zero_mem_add_iff_inter_neg_nonempty {E : Type*} [AddCommGroup E] {A B : Set E} :
    0 ∈ A + B ↔ (A ∩ -B).Nonempty := by
  constructor
  · rintro ⟨a, ha, b, hb, hab⟩
    refine ⟨a, ha, Set.mem_neg.mpr ?_⟩
    rw [eq_neg_of_add_eq_zero_left hab, neg_neg]
    exact hb
  · rintro ⟨a, ha, hb⟩
    exact ⟨a, ha, -a, Set.mem_neg.mp hb, add_neg_cancel a⟩

set_option linter.unusedVariables false in
/-- SYNOPSIS item 113: for a compact convex structuring element `B` containing the origin,
`H_B(r) = 1 - exp(-λ [E V_d(Ξ_0 ⊕ rB) - E V_d(Ξ_0)])` for `r ≥ 0`. -/
theorem boolean_contactDistribution {P : Measure Ω} {κ : Ω → ℕ∞}
    {x : Ω → ℕ → EuclideanSpace ℝ (Fin d)} {G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))}
    {lam : ℝ} {Q : Measure (Closeds (EuclideanSpace ℝ (Fin d)))}
    (hB : IsBooleanModel P κ x G lam Q) {B : Set (EuclideanSpace ℝ (Fin d))} (hBc : IsCompact B)
    (hBconv : Convex ℝ B) (hB0 : (0 : EuclideanSpace ℝ (Fin d)) ∈ B) {r : ℝ} (hr : 0 ≤ r) :
    contactDistribution P (booleanSet κ x G) B r =
      1 - Real.exp (-lam * (grainMeanVolume Q (r • B) - grainMeanVolume Q {0})) := by
  have hm := hB.measureReal_miss (hBc.smul r).neg
  rw [neg_neg] at hm
  rw [contactDistribution_def, ← measureReal_def, ← measureReal_def]
  simp_rw [zero_mem_add_iff_inter_neg_nonempty]
  rw [hm, measureReal_def, boolean_volumeFraction hB]
  simp only [sub_sub_cancel]
  rw [← Real.exp_sub]
  congr 2
  ring


/-- Translation invariance identifies the expected volume for a singleton test. -/
lemma grainMeanVolume_neg_singleton (Q : Measure (Closeds V)) (r : V) :
    grainMeanVolume Q (-({r} : Set V)) = grainMeanVolume Q {0} := by
  rw [grainMeanVolume_def, grainMeanVolume_def]
  congr 1
  apply lintegral_congr
  intro F
  simp only [Set.neg_singleton, Set.add_singleton, add_zero, Set.image_id']
  rw [Set.image_add_right]
  have h := measurePreserving_add_right (volume : Measure V) (-(-r))
  rw [← Measure.map_apply h.measurable F.isClosed.measurableSet, h.map_eq]

/-- Offsetting a grain by a reflected pair gives the union of the original and the translated
grain. -/
lemma add_neg_pair_eq_union_image_sub (F : Set V) (r : V) :
    F + -({0, r} : Set V) = F ∪ (· - r) '' F := by
  have hr : -({0, r} : Set V) = ({0, -r} : Set V) := by
    ext x
    simp
  rw [hr, Set.insert_eq, Set.add_union]
  simp only [Set.add_singleton, add_zero, Set.image_id', sub_eq_add_neg]

/-- For a compact test set, the volume of germ positions where a grain would hit the test
set is measurable in the grain. -/
lemma measurable_volume_add_neg_closeds {K : Set V} (hK : IsCompact K) :
    Measurable (fun F : Closeds V ↦ volume ((F : Set V) + -K)) := by
  have he : (fun F : Closeds V ↦ volume ((F : Set V) + -K)) = fun F : Closeds V ↦ volume
      ((fun y : V ↦ (y, F)) ⁻¹'
        {z : V × Closeds V | (((· + z.1) '' (z.2 : Set V)) ∩ K).Nonempty}) := by
    funext F
    rw [← volume_sub_eq_volume_add_neg _ _]
    congr 1
    ext y
    exact image_add_right_inter_nonempty_iff_mem_sub.symm
  rw [he]
  exact measurable_measure_prodMk_right (measurableSet_image_add_right_inter_nonempty hK)

/-- For the reflected two-point test, the mean volume is found by inclusion-exclusion. -/
lemma grainMeanVolume_neg_pair {P : Measure Ω} {κ : Ω → ℕ∞}
    {x : Ω → ℕ → V} {G : Ω → ℕ → Closeds V} {lam : ℝ}
    {Q : Measure (Closeds V)} (hB : IsBooleanModel P κ x G lam Q) (r : V) :
    grainMeanVolume Q (-({0, r} : Set V)) =
      2 * grainMeanVolume Q {0} - (∫⁻ F : Closeds V, volume
        ((F : Set V) ∩ ((· - r) '' (F : Set V))) ∂Q).toReal := by
  let U (F : Closeds V) := volume ((F : Set V) + -({0, r} : Set V))
  let I (F : Closeds V) := volume ((F : Set V) ∩ ((· - r) '' (F : Set V)))
  let L (F : Closeds V) := volume ((F : Set V) + {0})
  have hpair : IsCompact ({0, r} : Set V) := isCompact_singleton.insert 0
  have hU : Measurable U := measurable_volume_add_neg_closeds hpair
  have hL : Measurable L := by
    simpa only [L, Set.neg_singleton, neg_zero] using
      measurable_volume_add_neg_closeds (isCompact_singleton (x := (0 : V)))
  have hUL (F : Closeds V) : U F + I F = L F + L F := by
    dsimp only [U, I, L]
    rw [add_neg_pair_eq_union_image_sub]
    simp only [Set.add_singleton, add_zero, Set.image_id']
    have hpres := measurePreserving_add_right (volume : Measure V) r
    have he : (· - r) '' (F : Set V) = (· + r) ⁻¹' (F : Set V) := by
      simp only [sub_eq_add_neg, Set.image_add_right, neg_neg]
    rw [he, measure_union_add_inter _ (hpres.measurable F.isClosed.measurableSet),
      ← Measure.map_apply hpres.measurable F.isClosed.measurableSet, hpres.map_eq]
  have hI : (∫⁻ F, I F ∂Q) < ∞ := by
    refine (lintegral_mono (g := L) fun F ↦ ?_).trans_lt
      (hB.meanVolume_lt_top {0} isCompact_singleton)
    exact (measure_mono Set.inter_subset_left).trans_eq
      (by simp only [L, Set.add_singleton, add_zero, Set.image_id'])
  have hUb := hB.meanVolume_lt_top (-({0, r} : Set V)) hpair.neg
  have hsum := calc
    (∫⁻ F, U F ∂Q) + (∫⁻ F, I F ∂Q) = ∫⁻ F, U F + I F ∂Q :=
      (lintegral_add_left hU I).symm
    _ = ∫⁻ F, 2 * L F ∂Q := lintegral_congr fun F ↦ by rw [hUL, two_mul]
    _ = 2 * ∫⁻ F, L F ∂Q := lintegral_const_mul'' _ hL.aemeasurable
  have hr := congrArg ENNReal.toReal hsum
  rw [ENNReal.toReal_add hUb.ne hI.ne, ENNReal.toReal_mul] at hr
  norm_num only [ENNReal.toReal_ofNat] at hr
  rw [grainMeanVolume_def, grainMeanVolume_def]
  exact eq_sub_of_add_eq hr

/-- SYNOPSIS item 113: the covariance is
`P(0 ∈ Ξ, r ∈ Ξ) = 2p - 1 + (1 - p)² exp(λ E V_d(Ξ_0 ∩ (Ξ_0 - r)))`. -/
theorem boolean_covariance {P : Measure Ω} {κ : Ω → ℕ∞} {x : Ω → ℕ → EuclideanSpace ℝ (Fin d)}
    {G : Ω → ℕ → Closeds (EuclideanSpace ℝ (Fin d))} {lam : ℝ}
    {Q : Measure (Closeds (EuclideanSpace ℝ (Fin d)))} (hB : IsBooleanModel P κ x G lam Q)
    (r : EuclideanSpace ℝ (Fin d)) :
    let p := (P {ω | (0 : EuclideanSpace ℝ (Fin d)) ∈ booleanSet κ x G ω}).toReal
    (P {ω | (0 : EuclideanSpace ℝ (Fin d)) ∈ booleanSet κ x G ω ∧
        r ∈ booleanSet κ x G ω}).toReal =
      2 * p - 1 + (1 - p) ^ 2 * Real.exp (lam * (∫⁻ (F : Closeds (EuclideanSpace ℝ (Fin d))),
        volume ((F : Set (EuclideanSpace ℝ (Fin d))) ∩ ((· - r) '' (F : Set _))) ∂Q).toReal) := by
  dsimp only
  let := hB.isProbabilityMeasure
  let A := {ω | (0 : V) ∈ booleanSet κ x G ω}
  let B := {ω | r ∈ booleanSet κ x G ω}
  let c := grainMeanVolume Q {0}
  let v := (∫⁻ F : Closeds V, volume ((F : Set V) ∩ ((· - r) '' (F : Set V))) ∂Q).toReal
  have hBmeas : MeasurableSet B := by
    simpa only [B, Set.inter_singleton_nonempty] using
      hB.measurableSet_hit (isCompact_singleton (x := r))
  have hA : P.real A = 1 - Real.exp (-lam * c) := boolean_volumeFraction hB
  have hBr : P.real B = 1 - Real.exp (-lam * c) := by
    simpa only [B, ← measureReal_def, Set.inter_singleton_nonempty, grainMeanVolume_neg_singleton]
      using boolean_capacity hB (isCompact_singleton (x := r))
  have hU : P.real (A ∪ B) = 1 - Real.exp (-lam * (2 * c - v)) := by
    have he : {ω | (booleanSet κ x G ω ∩ ({0, r} : Set V)).Nonempty} = A ∪ B := by
      ext ω
      rw [Set.mem_ofPred_eq, Set.insert_eq, Set.inter_union_distrib_left, Set.union_nonempty]
      simp only [Set.inter_singleton_nonempty, Set.mem_union, Set.mem_ofPred_eq, A, B]
    simpa only [← measureReal_def, he, grainMeanVolume_neg_pair hB] using
      boolean_capacity hB (isCompact_singleton.insert 0 : IsCompact ({0, r} : Set V))
  have hI : P.real (A ∩ B) = 2 * (1 - Real.exp (-lam * c)) - 1 +
      Real.exp (-lam * (2 * c - v)) := by
    have h := measureReal_union_add_inter (μ := P) (s := A) hBmeas
    rw [hA, hBr, hU] at h
    linarith only [h]
  have hexp : Real.exp (-lam * (2 * c - v)) =
      (Real.exp (-lam * c)) ^ 2 * Real.exp (lam * v) := by
    rw [← Real.exp_nat_mul, ← Real.exp_add]
    congr 1
    push_cast
    ring
  -- Relate the displayed probability to the two singleton hit events.
  change P.real (A ∩ B) = 2 * P.real A - 1 +
    (1 - P.real A) ^ 2 * Real.exp (lam * v)
  rw [hI, hA, hexp, sub_sub_cancel]

/-- Translate a closed set by a germ location. -/
def translateClosed (x : V) (F : Closeds V) : Closeds V :=
  ⟨(· + x) '' (F : Set V), by
    rw [Set.image_add_right]
    exact F.isClosed.preimage (continuous_id.add continuous_const)⟩

/-- The underlying set of a translated closed set. -/
lemma coe_translateClosed (x : V) (F : Closeds V) :
    (translateClosed x F : Set V) = (· + x) '' (F : Set V) := by
  rw [translateClosed, Closeds.coe_mk]

/-- Translating closed sets is measurable for the Fell sigma-algebra. -/
lemma measurable_translateClosed :
    Measurable (fun p : V × Closeds V ↦ translateClosed p.1 p.2) := by
  let f := fun p : V × Closeds V ↦ translateClosed p.1 p.2
  have hf : ∀ A ∈ {A | ∃ C : Set V, IsCompact C ∧ A = {F : Closeds V | ↑F ∩ C = ∅}},
      MeasurableSet (f ⁻¹' A) := by
    rintro _ ⟨C, hC, rfl⟩
    simpa only [f, Set.preimage, Set.mem_ofPred_eq, coe_translateClosed, Set.compl_ofPred,
      not_nonempty_iff_eq_empty] using (measurableSet_image_add_right_inter_nonempty hC).compl
  rw [measurable_iff_comap_le]
  calc
    _ = _ := congrArg (MeasurableSpace.comap f) fellSigma_def
    _ ≤ _ := measurable_iff_comap_le.mp (measurable_generateFrom hf)

/-- The set of closed subsets hitting a test set. -/
def hitClosed (C : Set V) : Set (Closeds V) := {F | ((F : Set V) ∩ C).Nonempty}

/-- A closed set hits a test set exactly when their intersection is nonempty. -/
lemma mem_hitClosed {C : Set V} {F : Closeds V} :
    F ∈ hitClosed C ↔ ((F : Set V) ∩ C).Nonempty := Iff.rfl

/-- Hitting a compact test set is a Fell-measurable event. -/
lemma measurableSet_hitClosed {C : Set V} (hC : IsCompact C) : MeasurableSet (hitClosed C) := by
  have hm : MeasurableSet {F : Closeds V | (F : Set V) ∩ C = ∅} :=
    measurableSet_miss_compact measurable_id hC
  simpa only [hitClosed, Set.compl_ofPred, ← not_nonempty_iff_eq_empty, not_not] using hm.compl

/-- Hitting the union is hitting at least one test set. -/
lemma hitClosed_union (C D : Set V) : hitClosed (C ∪ D) = hitClosed C ∪ hitClosed D := by
  ext F
  simp only [hitClosed, Set.mem_ofPred_eq, inter_union_distrib_left, union_nonempty, Set.mem_union]

/-- The nonempty closed sets are covered by the hitting events of the closed balls. -/
lemma iUnion_hitClosed_closedBall :
    (⋃ n : ℕ, hitClosed (closedBall (0 : V) n)) = {F : Closeds V | (F : Set V).Nonempty} := by
  ext F
  simp only [mem_iUnion, mem_ofPred_eq]
  constructor
  · rintro ⟨n, x, hx, _⟩
    exact ⟨x, hx⟩
  · rintro ⟨x, hx⟩
    obtain ⟨n, hn⟩ := exists_nat_ge ‖x‖
    exact ⟨n, x, hx, mem_closedBall_zero_iff.mpr hn⟩

/-- Measures carried by the nonempty closed sets and finite on each compact hitting event
are determined by their masses on compact hitting events. -/
lemma measure_eq_of_eq_hitClosed {μ ν : Measure (Closeds V)}
    (hμ : ∀ᵐ (F : Closeds V) ∂μ, (F : Set V).Nonempty)
    (hν : ∀ᵐ (F : Closeds V) ∂ν, (F : Set V).Nonempty)
    (hfin : ∀ C : Set V, IsCompact C → μ (hitClosed C) ≠ ∞)
    (heq : ∀ C : Set V, IsCompact C → μ (hitClosed C) = ν (hitClosed C)) :
    μ = ν := by
  let M : Set (Set (Closeds V)) :=
    {A | ∃ C : Set V, IsCompact C ∧ A = {F : Closeds V | (F : Set V) ∩ C = ∅}}
  have hM : IsPiSystem M := by
    rintro _ ⟨C, hC, rfl⟩ _ ⟨D, hD, rfl⟩ _
    refine ⟨C ∪ D, hC.union hD, ?_⟩
    ext F
    simp only [mem_inter_iff, mem_ofPred_eq, inter_union_distrib_left,
      ← not_nonempty_iff_eq_empty, union_nonempty, not_or]
  have hre (C : Set V) (hC : IsCompact C) :
      μ.restrict (hitClosed C) = ν.restrict (hitClosed C) := by
    refine Measure.ext_of_generateFrom_of_iUnion M (fun _ : ℕ ↦ univ)
      fellSigma_def hM (Set.iUnion_const _) (fun _ ↦ ⟨∅, isCompact_empty, ?_⟩)
      (fun _ ↦ ?_) ?_
    · simp
    · rw [Measure.restrict_apply_univ]
      exact hfin C hC
    · rintro _ ⟨D, hD, rfl⟩
      have hDm := measurableSet_hitClosed hD
      have hmiss : {F : Closeds V | (F : Set V) ∩ D = ∅} = (hitClosed D)ᶜ := by
        simp only [hitClosed, Set.compl_ofPred, not_nonempty_iff_eq_empty]
      have hdiff : (hitClosed D)ᶜ ∩ hitClosed C = hitClosed (C ∪ D) \ hitClosed D := by
        rw [hitClosed_union]
        ext F
        simp only [mem_inter_iff, mem_compl_iff, Set.mem_sdiff, mem_union]
        tauto
      have hsub : hitClosed D ⊆ hitClosed (C ∪ D) := by
        rw [hitClosed_union]
        exact subset_union_right
      rw [hmiss, Measure.restrict_apply hDm.compl, Measure.restrict_apply hDm.compl, hdiff,
        measure_sdiff hsub hDm.nullMeasurableSet (hfin D hD),
        measure_sdiff hsub hDm.nullMeasurableSet ((heq D hD) ▸ hfin D hD),
        heq _ (hC.union hD), heq D hD]
  have h := (Measure.restrict_iUnion_congr (μ := μ) (ν := ν)
    (s := fun n : ℕ ↦ hitClosed (closedBall (0 : V) n))).mpr
    (fun n : ℕ ↦ hre (closedBall (0 : V) n) (isCompact_closedBall _ _))
  rw [iUnion_hitClosed_closedBall, Measure.restrict_eq_self_of_ae_mem hμ,
    Measure.restrict_eq_self_of_ae_mem hν] at h
  exact h

/-- The intensity measure of placed grains induced by the germ and grain measures. -/
def placedGrainIntensity (lam : ℝ) (Q : Measure (Closeds V)) : Measure (Closeds V) :=
  ((ENNReal.ofReal lam • volume).prod Q).map (fun p ↦ translateClosed p.1 p.2)

/-- The explicit product-measure expression for the placed-grain intensity. -/
lemma placedGrainIntensity_def (lam : ℝ) (Q : Measure (Closeds V)) :
    placedGrainIntensity lam Q =
      ((ENNReal.ofReal lam • volume).prod Q).map (fun p ↦ translateClosed p.1 p.2) := by
  rw [placedGrainIntensity]

/-- The placed-grain intensity is carried by nonempty sets when the grain law is. -/
lemma ae_nonempty_placedGrainIntensity {lam : ℝ} {Q : Measure (Closeds V)} [IsProbabilityMeasure Q]
    (hQn : ∀ᵐ (F : Closeds V) ∂Q, (F : Set V).Nonempty) :
    ∀ᵐ (F : Closeds V) ∂placedGrainIntensity lam Q, (F : Set V).Nonempty := by
  have hm : MeasurableSet {F : Closeds V | (F : Set V).Nonempty} := by
    rw [← iUnion_hitClosed_closedBall]
    exact MeasurableSet.iUnion fun n ↦ measurableSet_hitClosed (isCompact_closedBall _ _)
  have hm' : MeasurableSet {F : Closeds V | ¬ (F : Set V).Nonempty} := by
    simpa only [Set.compl_ofPred] using hm.compl
  rw [ae_iff, placedGrainIntensity, Measure.map_apply measurable_translateClosed hm',
    Measure.prod_apply_symm (measurable_translateClosed hm')]
  apply lintegral_eq_zero_of_ae_eq_zero
  filter_upwards [hQn] with F hF
  have h : (fun x : V ↦ (x, F)) ⁻¹'
      (fun p : V × Closeds V ↦ translateClosed p.1 p.2) ⁻¹' {F : Closeds V | ¬ (F : Set V).Nonempty}
      = ∅ := by
    rw [eq_empty_iff_forall_notMem]
    intro x hx
    exact hx (by simpa only [coe_translateClosed] using hF.image (· + x))
  rw [h, measure_empty, Pi.zero_apply]

/-- A placed-grain hitting mass is the mean grain volume for the reflected test set. -/
lemma placedGrainIntensity_hitClosed {lam : ℝ} {Q : Measure (Closeds V)} [IsProbabilityMeasure Q]
    {C : Set V} (hC : IsCompact C) :
    placedGrainIntensity lam Q (hitClosed C) =
      ENNReal.ofReal lam * ∫⁻ F : Closeds V, volume ((F : Set V) + -C) ∂Q := by
  rw [placedGrainIntensity,
    Measure.map_apply measurable_translateClosed (measurableSet_hitClosed hC)]
  exact prod_measure_hit_eq C hC


/-- Hitting a union is the union of the hitting events. -/
lemma hitClosed_iUnion {α : Type*} (S : α → Set V) :
    hitClosed (⋃ n, S n) = ⋃ n, hitClosed (S n) := by
  ext F
  simp only [hitClosed, Set.mem_ofPred_eq, mem_iUnion]
  constructor
  · rintro ⟨y, hy, hy'⟩
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hy'
    exact ⟨n, y, hy, hn⟩
  · rintro ⟨n, y, hy, hn⟩
    exact ⟨y, hy, Set.mem_iUnion.mpr ⟨n, hn⟩⟩

/-- A closed test set is the increasing union of its compact restrictions to closed balls. -/
lemma measurableSet_hitClosed_isClosed {C : Set V} (hC : IsClosed C) :
    MeasurableSet (hitClosed C) := by
  have heq : (⋃ n : ℕ, C ∩ closedBall (0 : V) n) = C := by
    ext x
    simp only [mem_iUnion, mem_inter_iff, mem_closedBall_zero_iff]
    exact ⟨fun ⟨_, hx, _⟩ ↦ hx, fun hx ↦
      let ⟨n, hn⟩ := exists_nat_ge ‖x‖; ⟨n, hx, hn⟩⟩
  rw [← heq, hitClosed_iUnion]
  exact MeasurableSet.iUnion fun n ↦ measurableSet_hitClosed
    ((isCompact_closedBall 0 (n : ℝ)).inter_left hC)

/-- Strict coordinate sublevel sets can be tested measurably by closed sets. -/
lemma measurableSet_hitClosed_coord_lt (i : Fin d) (r : ℝ) :
    MeasurableSet (hitClosed {y : V | y i < r}) := by
  have hs : {y : V | y i < r} = ⋃ n : ℕ, {y : V | y i ≤ r - 1 / (↑n + 1)} := by
    ext y
    simp only [Set.mem_ofPred_eq, mem_iUnion]
    constructor
    · intro hy
      obtain ⟨n, hn⟩ := exists_nat_one_div_lt (sub_pos.mpr hy)
      exact ⟨n, by linarith only [hn]⟩
    · rintro ⟨n, hn⟩
      have hp : 0 < (1 : ℝ) / (↑n + 1) := by positivity
      linarith only [hn, hp]
  rw [hs, hitClosed_iUnion]
  exact .iUnion fun n ↦ measurableSet_hitClosed_isClosed
    (isClosed_le (PiLp.continuous_apply 2 (fun _ : Fin d ↦ ℝ) i) continuous_const)

/-- The grains whose coordinate minima lie in the unit cube, expressed using hitting events. -/
def anchorInUnitCube (d : ℕ) : Set (Closeds (EuclideanSpace ℝ (Fin d))) :=
  {F | ∀ i : Fin d, (∀ y : EuclideanSpace ℝ (Fin d), y ∈ (F : Set _) → 0 ≤ y i) ∧
    ∃ y : EuclideanSpace ℝ (Fin d), y ∈ (F : Set _) ∧ y i ≤ 1}

/-- The lower and upper bound conditions for the coordinate minima of a grain. -/
lemma mem_anchorInUnitCube {F : Closeds V} :
    F ∈ anchorInUnitCube d ↔
      ∀ i : Fin d, (∀ y : V, y ∈ (F : Set V) → 0 ≤ y i) ∧
        ∃ y : V, y ∈ (F : Set V) ∧ y i ≤ 1 := Iff.rfl

/-- The event specifying the unit cube for the coordinate minima is measurable. -/
lemma measurableSet_anchorInUnitCube : MeasurableSet (anchorInUnitCube d) := by
  have hC (i : Fin d) : MeasurableSet (hitClosed {y : V | y i ≤ 1}) :=
    measurableSet_hitClosed_isClosed
      (isClosed_le (PiLp.continuous_apply 2 (fun _ : Fin d ↦ ℝ) i) continuous_const)
  have he : anchorInUnitCube d = ⋂ i : Fin d,
      (hitClosed {y : V | y i < 0})ᶜ ∩ hitClosed {y : V | y i ≤ 1} := by
    ext F
    simp only [anchorInUnitCube, mem_ofPred_eq, mem_iInter, mem_inter_iff,
      mem_compl_iff, hitClosed, Set.nonempty_def]
    push Not
    rfl
  rw [he]
  exact .iInter fun i ↦ (measurableSet_hitClosed_coord_lt i 0).compl.inter (hC i)

/-- Unit coordinate cubes have volume one. -/
lemma volume_unit_coordinateCube (d : ℕ) :
    volume {y : EuclideanSpace ℝ (Fin d) | ∀ i, y i ∈ Icc (0 : ℝ) 1} = 1 := by
  let C := (univ : Set (Fin d)).pi (fun _ ↦ Icc (0 : ℝ) 1)
  have hC : MeasurableSet C := MeasurableSet.univ_pi fun _ ↦ measurableSet_Icc
  have he : {y : EuclideanSpace ℝ (Fin d) | ∀ i, y i ∈ Icc (0 : ℝ) 1} =
      WithLp.ofLp ⁻¹' C := by
    ext y
    simp only [Set.mem_ofPred_eq, mem_preimage, C, Set.mem_pi, Set.mem_univ, forall_const]
  rw [he, (PiLp.volume_preserving_ofLp (Fin d)).measure_preimage hC.nullMeasurableSet,
    volume_pi_pi]
  simp [Real.volume_Icc]

/-- For each nonempty compact grain the admissible placement region of the anchor has volume
one, because it is a translate of the unit cube. -/
lemma volume_anchorInUnitCube_preimage_translateClosed {F : Closeds V}
    (hFc : IsCompact (F : Set V)) (hFn : (F : Set V).Nonempty) :
    volume ((fun y : V ↦ translateClosed y F) ⁻¹' anchorInUnitCube d) = 1 := by
  have he (i : Fin d) := hFc.exists_isMinOn hFn
    ((PiLp.continuous_apply 2 (fun _ : Fin d ↦ ℝ) i).continuousOn)
  choose p hp hmin using he
  let a : V := WithLp.toLp 2 (fun i ↦ p i i)
  let C : Set V := {y | ∀ i, y i ∈ Icc (0 : ℝ) 1}
  have hC : MeasurableSet C := by
    simp only [C, Set.ofPred_forall]
    exact .iInter fun i ↦
      ((PiLp.continuous_apply 2 (fun _ : Fin d ↦ ℝ) i).measurable measurableSet_Icc)
  have hset : (fun y : V ↦ translateClosed y F) ⁻¹' anchorInUnitCube d =
      (fun y : V ↦ y + a) ⁻¹' C := by
    ext y
    simp only [mem_preimage, anchorInUnitCube, mem_ofPred_eq, coe_translateClosed, C, mem_Icc]
    constructor
    · intro hy i
      have hlow := (hy i).1 (p i + y) (mem_image_of_mem (· + y) (hp i))
      obtain ⟨_, ⟨v, hv, rfl⟩, huv⟩ := (hy i).2
      have hl : p i i ≤ v i := hmin i hv
      exact ⟨by simpa only [PiLp.add_apply, a, WithLp.ofLp_toLp, add_comm] using hlow,
        by dsimp only [a, PiLp.add_apply, WithLp.ofLp_toLp] at huv ⊢; linarith only [huv, hl]⟩
    · intro hy i
      refine ⟨?_, ⟨p i + y, mem_image_of_mem (· + y) (hp i), ?_⟩⟩
      · rintro _ ⟨v, hv, rfl⟩
        have hl : p i i ≤ v i := hmin i hv
        have hlow := (hy i).1
        dsimp only [a, PiLp.add_apply, WithLp.ofLp_toLp] at hlow ⊢
        linarith only [hlow, hl]
      · simpa only [PiLp.add_apply, a, WithLp.ofLp_toLp, add_comm] using (hy i).2
  rw [hset, (measurePreserving_add_right volume a).measure_preimage hC.nullMeasurableSet]
  exact volume_unit_coordinateCube d


/-- Restricting placed grains to anchors in the unit cube recovers the unplaced grain intensity
on translation-invariant events. -/
lemma placedGrainIntensity_anchorInUnitCube {lam : ℝ} {Q : Measure (Closeds V)}
    [IsProbabilityMeasure Q] (hQc : ∀ᵐ F : Closeds V ∂Q, IsCompact (F : Set V))
    (hQn : ∀ᵐ F : Closeds V ∂Q, (F : Set V).Nonempty)
    {A : Set (Closeds V)} (hA : MeasurableSet A)
    (hInv : ∀ (F : Closeds V) (x : V), F ∈ A ↔ translateClosed x F ∈ A) :
    placedGrainIntensity lam Q (anchorInUnitCube d ∩ A) = ENNReal.ofReal lam * Q A := by
  have hC : MeasurableSet (anchorInUnitCube d ∩ A) := measurableSet_anchorInUnitCube.inter hA
  rw [placedGrainIntensity, Measure.map_apply measurable_translateClosed hC,
    Measure.prod_smul_left, smul_apply, smul_eq_mul,
    Measure.prod_apply_symm (measurable_translateClosed hC), ← lintegral_indicator_one hA]
  congr 1
  apply lintegral_congr_ae
  filter_upwards [hQc, hQn] with F hFc hFn
  classical
  by_cases hFA : F ∈ A
  · have he : (fun y : V ↦ (y, F)) ⁻¹'
        (fun b : V × Closeds V ↦ translateClosed b.1 b.2) ⁻¹' (anchorInUnitCube d ∩ A) =
        (fun y : V ↦ translateClosed y F) ⁻¹' anchorInUnitCube d := by
      ext y
      simp only [mem_preimage, mem_inter_iff, ← hInv F y, hFA, and_true]
    rw [he, volume_anchorInUnitCube_preimage_translateClosed hFc hFn, Set.indicator_of_mem hFA]
    rfl
  · have he : (fun y : V ↦ (y, F)) ⁻¹'
        (fun b : V × Closeds V ↦ translateClosed b.1 b.2) ⁻¹' (anchorInUnitCube d ∩ A) =
        ∅ := by
      ext y
      simp only [mem_preimage, mem_inter_iff, ← hInv F y, hFA, and_false, Set.mem_empty_iff_false]
    rw [he, measure_empty, Set.indicator_of_notMem hFA]

/-- SYNOPSIS item 113: the capacity functional determines `λ` and the law of `Ξ_0` up to
translation: if two Boolean models with almost surely nonempty grains have the same values of
`λ E V_d(Ξ_0 ⊕ K)` for all compact `K`, then their intensities agree and their grain laws agree
on translation-invariant measurable sets of closed sets. -/
theorem boolean_identifiable {lam lam' : ℝ} (hlam : 0 < lam) (hlam' : 0 < lam')
    {Q Q' : Measure (Closeds (EuclideanSpace ℝ (Fin d)))} [IsProbabilityMeasure Q]
    [IsProbabilityMeasure Q']
    (hQc : ∀ᵐ (F : Closeds (EuclideanSpace ℝ (Fin d))) ∂Q,
    IsCompact (F : Set (EuclideanSpace ℝ (Fin d))))
    (hQ'c : ∀ᵐ (F : Closeds (EuclideanSpace ℝ (Fin d))) ∂Q',
      IsCompact (F : Set (EuclideanSpace ℝ (Fin d))))
    (hQn : ∀ᵐ (F : Closeds (EuclideanSpace ℝ (Fin d))) ∂Q,
      (F : Set (EuclideanSpace ℝ (Fin d))).Nonempty)
    (hQ'n : ∀ᵐ (F : Closeds (EuclideanSpace ℝ (Fin d))) ∂Q',
      (F : Set (EuclideanSpace ℝ (Fin d))).Nonempty)
    (hfin : ∀ K, IsCompact K →
      ∫⁻ (F : Closeds (EuclideanSpace ℝ (Fin d))),
        volume ((F : Set (EuclideanSpace ℝ (Fin d))) + K) ∂Q < ∞)
    (hfin' : ∀ K, IsCompact K →
      ∫⁻ (F : Closeds (EuclideanSpace ℝ (Fin d))),
        volume ((F : Set (EuclideanSpace ℝ (Fin d))) + K) ∂Q' < ∞)
    (h : ∀ K, IsCompact K → lam * grainMeanVolume Q K = lam' * grainMeanVolume Q' K) :
    lam = lam' ∧ ∀ A : Set (Closeds (EuclideanSpace ℝ (Fin d))), MeasurableSet A →
      (∀ (F : Closeds (EuclideanSpace ℝ (Fin d))) (v : EuclideanSpace ℝ (Fin d)) (F' : Closeds _),
        (F' : Set _) = (· + v) '' (F : Set (EuclideanSpace ℝ (Fin d))) → (F ∈ A ↔ F' ∈ A)) →
      Q A = Q' A := by
  have he (l : ℝ) (hl : 0 ≤ l) (R : Measure (Closeds V)) [IsProbabilityMeasure R]
      (hR : ∀ K : Set V, IsCompact K → ∫⁻ F : Closeds V, volume ((F : Set V) + K) ∂R < ∞)
      (C : Set V) (hC : IsCompact C) : placedGrainIntensity l R (hitClosed C) =
        ENNReal.ofReal (l * grainMeanVolume R (-C)) := by
    rw [placedGrainIntensity_hitClosed hC, grainMeanVolume_def, ENNReal.ofReal_mul hl,
      ENNReal.ofReal_toReal (hR _ hC.neg).ne]
  have hm : placedGrainIntensity lam Q = placedGrainIntensity lam' Q' := by
    apply measure_eq_of_eq_hitClosed (ae_nonempty_placedGrainIntensity hQn)
      (ae_nonempty_placedGrainIntensity hQ'n)
    · intro C hC
      rw [he lam hlam.le Q hfin C hC]
      exact ENNReal.ofReal_ne_top
    · intro C hC
      rw [he lam hlam.le Q hfin C hC, he lam' hlam'.le Q' hfin' C hC, h _ hC.neg]
  have hr (A : Set (Closeds V)) (hA : MeasurableSet A)
      (hInv : ∀ (F : Closeds V) (x : V), F ∈ A ↔ translateClosed x F ∈ A) :
      lam * (Q A).toReal = lam' * (Q' A).toReal := by
    have h' := congrArg (fun m : Measure (Closeds V) ↦ m (anchorInUnitCube d ∩ A)) hm
    rw [placedGrainIntensity_anchorInUnitCube hQc hQn hA hInv,
      placedGrainIntensity_anchorInUnitCube hQ'c hQ'n hA hInv] at h'
    simpa only [ENNReal.toReal_mul, ENNReal.toReal_ofReal hlam.le, ENNReal.toReal_ofReal hlam'.le]
      using congrArg ENNReal.toReal h'
  have hl : lam = lam' := by
    simpa only [measure_univ, ENNReal.toReal_one, mul_one] using
      hr univ MeasurableSet.univ (fun _ _ ↦ Iff.rfl)
  refine ⟨hl, fun A hA hI ↦ ?_⟩
  have hq := hr A hA (fun F x ↦ hI F x _ (coe_translateClosed _ _))
  rw [← hl] at hq
  exact (ENNReal.toReal_eq_toReal_iff' (measure_ne_top Q A) (measure_ne_top Q' A)).mp
    (mul_left_cancel₀ hlam.ne' hq)

end Boolean

