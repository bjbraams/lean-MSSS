/-!
# Capacity functionals of random closed sets

The Fell sigma-algebra on closed subsets is generated by the events of missing a compact set.
For a locally compact second-countable Hausdorff space, the Choquet–Matheron theorem identifies
probability laws on this sigma-algebra with completely alternating, upper semicontinuous
capacity functionals.

## Main results

* `MSSS.capacity_properties` and `MSSS.succDiff_eq` give the properties of a capacity functional.
* `MSSS.existsUnique_law_of_capacity` reconstructs the unique law from its capacity.
* `MSSS.map_eq_of_capacity_eq` gives uniqueness from the probabilities of hitting compact sets.

The existence proof uses Mathlib’s Kolmogorov extension and compact-subcover theorems, and
TauCeti’s Möbius sum over an interval of finite subsets.
-/

public section

noncomputable section

open MeasureTheory Set Filter TopologicalSpace
open scoped ENNReal Topology

namespace MSSS

/-! ### Random closed sets (SYNOPSIS item 112) -/

section ChoquetMatheron

variable {E : Type*} [TopologicalSpace E]

/-- The σ-algebra on closed sets generated by `{F : F ∩ C = ∅}` for compact `C`. -/
@[instance_reducible]
def fellSigma : MeasurableSpace (Closeds E) :=
  MeasurableSpace.generateFrom
    {A | ∃ C : Set E, IsCompact C ∧ A = {F : Closeds E | (F : Set E) ∩ C = ∅}}

lemma fellSigma_def : (fellSigma : MeasurableSpace (Closeds E)) =
    MeasurableSpace.generateFrom
      {A | ∃ C : Set E, IsCompact C ∧ A = {F : Closeds E | (F : Set E) ∩ C = ∅}} := by
  rw [fellSigma]

attribute [local instance] fellSigma

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The **capacity functional** `T(C) = P(Z ∩ C ≠ ∅)` of a random closed set. -/
def capacity (P : Measure Ω) (Z : Ω → Closeds E) (C : Set E) : ℝ :=
  (P {ω | ((Z ω : Set E) ∩ C).Nonempty}).toReal

/-- The successive differences `S_0(C_0) = 1 - T(C_0)` and
`S_k(C_0; C_1, …, C_k) = S_{k-1}(C_0; C_1, …, C_{k-1}) - S_{k-1}(C_0 ∪ C_k; C_1, …, C_{k-1})`. -/
def succDiff (T : Set E → ℝ) : (k : ℕ) → Set E → (Fin k → Set E) → ℝ
  | 0, C₀, _ => 1 - T C₀
  | k + 1, C₀, C => succDiff T k C₀ (Fin.init C) - succDiff T k (C₀ ∪ C (Fin.last k)) (Fin.init C)

lemma capacity_def (P : Measure Ω) (Z : Ω → Closeds E) (C : Set E) :
    capacity P Z C = (P {ω | ((Z ω : Set E) ∩ C).Nonempty}).toReal := by
  rw [capacity]

omit [TopologicalSpace E] in
lemma succDiff_zero (T : Set E → ℝ) (C₀ : Set E) (C : Fin 0 → Set E) :
    succDiff T 0 C₀ C = 1 - T C₀ := by
  rw [succDiff]

omit [TopologicalSpace E] in
lemma succDiff_succ (T : Set E → ℝ) (k : ℕ) (C₀ : Set E) (C : Fin (k + 1) → Set E) :
    succDiff T (k + 1) C₀ C =
      succDiff T k C₀ (Fin.init C) - succDiff T k (C₀ ∪ C (Fin.last k)) (Fin.init C) := by
  rw [succDiff]

variable [LocallyCompactSpace E] [T2Space E] [SecondCountableTopology E]

omit [LocallyCompactSpace E] [T2Space E] [SecondCountableTopology E] in
/-- Missing a compact set is a measurable event for a Fell-measurable random closed set. -/
lemma measurableSet_miss_compact {Z : Ω → Closeds E} (hZ : Measurable Z)
    {C : Set E} (hC : IsCompact C) : MeasurableSet {ω | (Z ω : Set E) ∩ C = ∅} :=
  hZ (MeasurableSpace.measurableSet_generateFrom ⟨C, hC, rfl⟩)

omit [LocallyCompactSpace E] [T2Space E] [SecondCountableTopology E] in
/-- Hitting a compact set is a measurable event for a Fell-measurable random closed set. -/
private lemma measurableSet_hit_compact {Z : Ω → Closeds E} (hZ : Measurable Z)
    {C : Set E} (hC : IsCompact C) : MeasurableSet {ω | ((Z ω : Set E) ∩ C).Nonempty} := by
  simpa only [Set.compl_ofPred, ← not_nonempty_iff_eq_empty, not_not] using
    (measurableSet_miss_compact hZ hC).compl

omit [LocallyCompactSpace E] [T2Space E] [SecondCountableTopology E] in
/-- The probability of missing a compact set is the complement of its capacity. -/
private lemma measureReal_miss_compact {P : Measure Ω} [IsProbabilityMeasure P]
    {Z : Ω → Closeds E} (hZ : Measurable Z) {C : Set E} (hC : IsCompact C) :
    P.real (Z ⁻¹' {F : Closeds E | (F : Set E) ∩ C = ∅}) = 1 - capacity P Z C := by
  have hS : Z ⁻¹' {F : Closeds E | (F : Set E) ∩ C = ∅} =
      {ω | ((Z ω : Set E) ∩ C).Nonempty}ᶜ := by
    ext ω
    simp [not_nonempty_iff_eq_empty]
  rw [hS, probReal_compl_eq_one_sub (measurableSet_hit_compact hZ hC)]
  rfl

-- Keep the ambient topology assumptions in the existing interface.
set_option linter.unusedSectionVars false in
/-- SYNOPSIS item 112: the successive differences are
`S_k(C_0; C_1, …, C_k) = P(Z ∩ C_0 = ∅, Z ∩ C_i ≠ ∅ for i = 1, …, k)`. -/
theorem succDiff_eq {P : Measure Ω} [IsProbabilityMeasure P] {Z : Ω → Closeds E}
    (hZ : Measurable Z) (k : ℕ) (C₀ : Set E) (C : Fin k → Set E) (hC₀ : IsCompact C₀)
    (hC : ∀ i, IsCompact (C i)) :
    succDiff (capacity P Z) k C₀ C = (P {ω | (Z ω : Set E) ∩ C₀ = ∅ ∧
      ∀ i, ((Z ω : Set E) ∩ C i).Nonempty}).toReal := by
  induction k generalizing C₀ with
  | zero =>
    rw [succDiff_zero, capacity_def, ← measureReal_def, ← measureReal_def,
      ← probReal_compl_eq_one_sub (measurableSet_hit_compact hZ hC₀)]
    congr 1
    ext ω
    simp [not_nonempty_iff_eq_empty]
  | succ k ih =>
    let A := {ω | (Z ω : Set E) ∩ C₀ = ∅ ∧
      ∀ i, ((Z ω : Set E) ∩ Fin.init C i).Nonempty}
    let B := {ω | (Z ω : Set E) ∩ (C₀ ∪ C (Fin.last k)) = ∅ ∧
      ∀ i, ((Z ω : Set E) ∩ Fin.init C i).Nonempty}
    have hB : MeasurableSet B := by
      convert (measurableSet_miss_compact hZ (hC₀.union (hC (Fin.last k)))).inter
        (MeasurableSet.iInter fun i : Fin k ↦ measurableSet_hit_compact hZ (hC i.castSucc)) using 1
      ext ω
      simp [B, Fin.init]
    have hBA : B ⊆ A := fun ω ⟨hmiss, hhit⟩ ↦
      ⟨eq_empty_of_subset_empty (hmiss ▸ inter_subset_inter_right _ subset_union_left), hhit⟩
    rw [succDiff_succ, ih C₀ (Fin.init C) hC₀ (fun i ↦ hC i.castSucc),
      ih _ (Fin.init C) (hC₀.union (hC _)) (fun i ↦ hC i.castSucc)]
    refine (measureReal_sdiff hBA hB).symm.trans ?_
    congr 2
    ext ω
    simp only [A, B, Set.mem_sdiff, mem_ofPred_eq, inter_union_distrib_left,
      ← not_nonempty_iff_eq_empty, Set.union_nonempty, Fin.forall_iff_castSucc, Fin.init]
    tauto

/-- SYNOPSIS item 112: the capacity functional of a random closed set satisfies `0 ≤ T ≤ 1` and
`T(∅) = 0`, is upper semicontinuous along decreasing sequences of compact sets, and is completely
alternating. -/
theorem capacity_properties {P : Measure Ω} [IsProbabilityMeasure P] {Z : Ω → Closeds E}
    (hZ : Measurable Z) :
    (∀ C, 0 ≤ capacity P Z C ∧ capacity P Z C ≤ 1) ∧ capacity P Z ∅ = 0 ∧
      (∀ C : ℕ → Set E, (∀ n, IsCompact (C n)) → Antitone C →
        Tendsto (fun n ↦ capacity P Z (C n)) atTop (𝓝 (capacity P Z (⋂ n, C n)))) ∧
      ∀ k (C₀ : Set E) (C : Fin k → Set E), IsCompact C₀ → (∀ i, IsCompact (C i)) →
        0 ≤ succDiff (capacity P Z) k C₀ C := by
  refine ⟨fun C ↦ ⟨ENNReal.toReal_nonneg, ?_⟩, ?_, ?_, ?_⟩
  · rw [capacity_def, ← ENNReal.toReal_one]
    exact ENNReal.toReal_mono ENNReal.one_ne_top (prob_le_one (μ := P))
  · simp [capacity_def]
  · intro C hC hanti
    let H := fun n ↦ {ω | ((Z ω : Set E) ∩ C n).Nonempty}
    have hH : Antitone H := fun i j hij _ h ↦
      h.mono (inter_subset_inter_right _ (hanti hij))
    have hlim := tendsto_measure_iInter_atTop (μ := P)
      (fun n ↦ (measurableSet_hit_compact hZ (hC n)).nullMeasurableSet) hH
      ⟨0, measure_ne_top P (H 0)⟩
    have hi : (⋂ n, H n) = {ω | ((Z ω : Set E) ∩ (⋂ n, C n)).Nonempty} := by
      ext ω
      rw [mem_iInter, mem_ofPred_eq, inter_iInter]
      refine ⟨fun h ↦ ?_, fun h n ↦ h.mono (iInter_subset _ n)⟩
      exact IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed _
        (fun n ↦ inter_subset_inter_right _ (hanti (Nat.le_succ n))) h
        ((hC 0).inter_left (Z ω).isClosed) (fun n ↦ (Z ω).isClosed.inter (hC n).isClosed)
    rw [hi] at hlim
    exact (ENNReal.continuousAt_toReal (measure_ne_top P _)).tendsto.comp hlim
  · intro k C₀ C hC₀ hC
    rw [succDiff_eq hZ k C₀ C hC₀ hC]
    exact ENNReal.toReal_nonneg

-- Keep the ambient topology assumptions in the existing interface.
set_option linter.unusedSectionVars false in
/-- SYNOPSIS item 112: the capacity functional determines the law of a random closed set. -/
theorem map_eq_of_capacity_eq {Ω' : Type*} [MeasurableSpace Ω'] {P : Measure Ω}
    {P' : Measure Ω'} [IsProbabilityMeasure P] [IsProbabilityMeasure P'] {Z : Ω → Closeds E}
    {Z' : Ω' → Closeds E} (hZ : Measurable Z) (hZ' : Measurable Z')
    (h : ∀ C, IsCompact C → capacity P Z C = capacity P' Z' C) : P.map Z = P'.map Z' := by
  let G : Set (Set (Closeds E)) :=
    {A | ∃ C : Set E, IsCompact C ∧ A = {F : Closeds E | (F : Set E) ∩ C = ∅}}
  have hG : IsPiSystem G := by
    rintro _ ⟨C, hC, rfl⟩ _ ⟨D, hD, rfl⟩ _
    refine ⟨C ∪ D, hC.union hD, ?_⟩
    ext F
    simp only [mem_inter_iff, mem_ofPred_eq, inter_union_distrib_left,
      ← not_nonempty_iff_eq_empty, Set.union_nonempty, not_or]
  refine Measure.ext_of_generateFrom_of_iUnion G (fun _ : ℕ ↦ univ) (fellSigma_def) hG
    (Set.iUnion_const _) (fun _ ↦ ⟨∅, isCompact_empty, ?_⟩) (fun _ ↦ measure_ne_top _ _) ?_
  · ext F
    simp only [mem_univ, mem_ofPred_eq, inter_empty]
  rintro _ ⟨C, hC, rfl⟩
  have hmeas : MeasurableSet {F : Closeds E | (F : Set E) ∩ C = ∅} :=
    MeasurableSpace.measurableSet_generateFrom ⟨C, hC, rfl⟩
  rw [Measure.map_apply hZ hmeas, Measure.map_apply hZ' hmeas]
  refine (ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _)).1 ?_
  simp only [← measureReal_def, measureReal_miss_compact hZ hC,
    measureReal_miss_compact hZ' hC, h C hC]

end ChoquetMatheron

variable {E : Type*} [TopologicalSpace E]

omit [TopologicalSpace E] in
/-- The successive differences of a capacity are alternating sums over subsets of the tests. -/
lemma succDiff_eq_sum_powerset (T : Set E → ℝ) (k : ℕ) (C₀ : Set E) (C : Fin k → Set E) :
    succDiff T k C₀ C = ∑ J ∈ (Finset.univ : Finset (Fin k)).powerset,
      (-1 : ℝ) ^ J.card * (1 - T (C₀ ∪ ⋃ i ∈ J, C i)) := by
  induction k generalizing C₀ with
  | zero => simp [succDiff_zero]
  | succ k ih =>
    let u : Finset (Fin k) := Finset.univ
    let v : Finset (Fin (k + 1)) := u.image Fin.castSucc
    have hl : Fin.last k ∉ v := by simp [v, u]
    have hu : (Finset.univ : Finset (Fin (k + 1))) = insert (Fin.last k) v := by
      rw [Fin.univ_castSuccEmb, Finset.cons_eq_insert, Finset.map_eq_image]
      rfl
    have hI : Set.InjOn (Finset.image (Fin.castSucc : Fin k → Fin (k + 1))) ↑u.powerset :=
      Finset.image_injOn_powerset_of_injOn (Fin.castSucc_injective k).injOn
    have hcard (J : Finset (Fin k)) : (J.image Fin.castSucc).card = J.card :=
      Finset.card_image_of_injective J (Fin.castSucc_injective k)
    have hJ (J : Finset (Fin k)) : (⋃ i ∈ J.image Fin.castSucc, C i) =
        ⋃ i ∈ J, Fin.init C i := by
      ext x
      simp only [mem_iUnion, Finset.mem_image, Fin.init]
      constructor
      · rintro ⟨_, ⟨i, hi, rfl⟩, hx⟩
        exact ⟨i, hi, hx⟩
      · rintro ⟨i, hi, hx⟩
        exact ⟨i.castSucc, ⟨i, hi, rfl⟩, hx⟩
    have hlast (J : Finset (Fin k)) :
        (⋃ i ∈ insert (Fin.last k) (J.image Fin.castSucc), C i) =
          C (Fin.last k) ∪ ⋃ i ∈ J, Fin.init C i := by
      rw [← hJ]
      ext x
      simp only [mem_iUnion, Finset.mem_insert, mem_union]
      aesop
    have hnot (J : Finset (Fin k)) : Fin.last k ∉ J.image Fin.castSucc := by
      have hs : J.image Fin.castSucc ⊆ v := Finset.image_mono _ (Finset.subset_univ J)
      exact fun h ↦ hl (hs h)
    rw [succDiff_succ, ih, ih, hu, Finset.sum_powerset_insert hl]
    dsimp only [v]
    rw [Finset.powerset_image, Finset.sum_image hI, Finset.sum_image hI]
    simp only [u, hcard, hJ, hlast, Finset.card_insert_of_notMem (hnot _), pow_succ, mul_neg_one,
      neg_mul, Finset.sum_neg_distrib, ← union_assoc, sub_eq_add_neg]

/-- The inclusion-exclusion mass assigned to a precise set of missed tests. -/
def avoidanceAtom {α : Type*} [Fintype α] [DecidableEq α]
    (a : Finset α → ℝ) (B : Finset α) : ℝ :=
  ∑ C ∈ Finset.Icc B Finset.univ, (-1 : ℝ) ^ (C.card - B.card) * a C

/-- The defining sum of a finite avoidance atom. -/
lemma avoidanceAtom_def {α : Type*} [Fintype α] [DecidableEq α]
    (a : Finset α → ℝ) (B : Finset α) :
    avoidanceAtom a B = ∑ C ∈ Finset.Icc B Finset.univ,
      (-1 : ℝ) ^ (C.card - B.card) * a C := by
  rw [avoidanceAtom]

/-- Möbius inversion recovers the probability of missing at least the given tests. -/
lemma sum_avoidanceAtom_Ici {α : Type*} [Fintype α] [DecidableEq α]
    (a : Finset α → ℝ) (A : Finset α) :
    ∑ B ∈ Finset.Icc A Finset.univ, avoidanceAtom a B = a A := by
  classical
  simp only [avoidanceAtom]
  have he (B : Finset α) : Finset.Icc B Finset.univ = Finset.univ.filter (B ⊆ ·) := by
    ext C
    simp
  simp_rw [he, Finset.sum_filter]
  have hm (B : Finset α) :
      (if A ⊆ B then ∑ C : Finset α, if B ⊆ C then (-1 : ℝ) ^ (C.card - B.card) * a C else 0
        else 0) = ∑ C : Finset α, if A ⊆ B then
          (if B ⊆ C then (-1 : ℝ) ^ (C.card - B.card) * a C else 0) else 0 := by
    by_cases hh : A ⊆ B <;> simp [hh]
  simp_rw [hm]
  rw [Finset.sum_comm]
  have he' (C : Finset α) :
      (∑ B : Finset α, if A ⊆ B then
        (if B ⊆ C then (-1 : ℝ) ^ (C.card - B.card) * a C else 0) else 0) =
          ∑ B ∈ Finset.Icc A C, (-1 : ℝ) ^ (C.card - B.card) * a C := by
    rw [show Finset.Icc A C = Finset.univ.filter (fun B ↦ A ⊆ B ∧ B ⊆ C) by ext B; simp,
      Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro B _
    by_cases h₁ : A ⊆ B <;> by_cases h₂ : B ⊆ C <;> simp [h₁, h₂]
  simp_rw [he', ← Finset.sum_mul, Finset.sum_Icc_neg_one_pow_card_sub_card_right]
  simp

/-- A disjoint supplement increases the number of tests by its cardinality. -/
lemma avoidanceAtom_eq_sum_powerset_compl {α : Type*} [Fintype α] [DecidableEq α]
    (a : Finset α → ℝ) (B : Finset α) :
    avoidanceAtom a B = ∑ J ∈ (Finset.univ \ B).powerset, (-1 : ℝ) ^ J.card * a (B ∪ J) := by
  rw [avoidanceAtom, Finset.Icc_eq_image_powerset (Finset.subset_univ B), Finset.sum_image]
  · refine Finset.sum_congr rfl fun J hJ ↦ ?_
    have hd : Disjoint B J := Finset.disjoint_sdiff.mono_right (Finset.mem_powerset.mp hJ)
    rw [Finset.card_union_of_disjoint hd, Nat.add_sub_cancel_left]
  · intro J hJ L hL he
    have hJ' : Disjoint B J := Finset.disjoint_sdiff.mono_right (Finset.mem_powerset.mp hJ)
    have hL' : Disjoint B L := Finset.disjoint_sdiff.mono_right (Finset.mem_powerset.mp hL)
    change B ∪ J = B ∪ L at he
    rw [← Finset.union_sdiff_cancel_left hJ', he, Finset.union_sdiff_cancel_left hL']


/-- A finite union of compact tests indexed by a finset. -/
def familyUnion {α : Type*} (K : α → Set E) (A : Finset α) : Set E := ⋃ a ∈ A, K a

omit [TopologicalSpace E] in
/-- Membership in a finite family union. -/
lemma mem_familyUnion {α : Type*} {K : α → Set E} {A : Finset α} {x : E} :
    x ∈ familyUnion K A ↔ ∃ i ∈ A, x ∈ K i := by
  simp only [familyUnion, mem_iUnion, exists_prop]

omit [TopologicalSpace E] in
/-- The union of a combined family of sets is the union of the two family unions. -/
lemma familyUnion_union {α : Type*} [DecidableEq α] (K : α → Set E) (A B : Finset α) :
    familyUnion K (A ∪ B) = familyUnion K A ∪ familyUnion K B := by
  ext x
  simp only [familyUnion, mem_iUnion, Finset.mem_union, mem_union]
  aesop

/-- The union of a finite family of compact sets is compact. -/
lemma isCompact_familyUnion {α : Type*} (K : α → Set E) (hK : ∀ i, IsCompact (K i))
    (A : Finset α) : IsCompact (familyUnion K A) := by
  exact Finset.isCompact_biUnion A (fun i _ ↦ hK i)

/-- Complete alternation ensures that each finite inclusion-exclusion mass is nonnegative. -/
lemma avoidanceAtom_nonneg {α : Type*} [Fintype α] [DecidableEq α]
    (T : Set E → ℝ) (K : α → Set E) (hK : ∀ i, IsCompact (K i))
    (hAlt : ∀ k (C₀ : Set E) (C : Fin k → Set E), IsCompact C₀ → (∀ i, IsCompact (C i)) →
      0 ≤ succDiff T k C₀ C) (B : Finset α) :
    0 ≤ avoidanceAtom (fun A ↦ 1 - T (familyUnion K A)) B := by
  let N := Finset.univ \ B
  let e : Fin N.card ≃ N := (Fintype.equivFinOfCardEq (Fintype.card_coe N)).symm
  let f : Fin N.card ↪ α := ⟨fun i ↦ (e i).1, Subtype.val_injective.comp e.injective⟩
  have hU : (Finset.univ : Finset (Fin N.card)).image f = N := by
    ext j
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    refine ⟨fun ⟨i, hi⟩ ↦ hi ▸ (e i).2, fun hj ↦ ⟨e.symm ⟨j, hj⟩, ?_⟩⟩
    simp only [f, Function.Embedding.coeFn_mk, e.apply_symm_apply]
  have hcard (J : Finset (Fin N.card)) : (J.image f).card = J.card :=
    Finset.card_image_of_injective _ f.injective
  have hEq (J : Finset (Fin N.card)) : familyUnion K (J.image f) = ⋃ i ∈ J, K (f i) := by
    ext x
    simp only [familyUnion, mem_iUnion, Finset.mem_image]
    aesop
  rw [avoidanceAtom_eq_sum_powerset_compl]
  have hU' : (Finset.univ : Finset (Fin N.card)).image f = Finset.univ \ B := hU
  rw [← hU', Finset.powerset_image,
    Finset.sum_image (Finset.image_injOn_powerset_of_injOn f.injective.injOn)]
  simp only [hcard, familyUnion_union, hEq, ← succDiff_eq_sum_powerset]
  exact hAlt _ _ _ (isCompact_familyUnion K hK B) (fun i ↦ hK (f i))

/-- The event that the indicated finite set of tests are all missed. -/
def avoidanceEvent {α : Type*} (A : Finset α) : Set (α → Bool) :=
  {b | ∀ i ∈ A, b i = true}

/-- Membership in the event of avoiding a finite family. -/
lemma mem_avoidanceEvent {α : Type*} {A : Finset α} {b : α → Bool} :
    b ∈ avoidanceEvent A ↔ ∀ i ∈ A, b i = true := Iff.rfl

/-- All finite avoidance events are measurable under the cylinder sigma-algebra. -/
lemma measurableSet_avoidanceEvent {α : Type*} (A : Finset α) :
    MeasurableSet (avoidanceEvent A) := by
  unfold avoidanceEvent
  simp only [Set.ofPred_forall]
  exact Finset.measurableSet_biInter A (fun i _ ↦
    measurableSet_eq_fun (measurable_pi_apply i) measurable_const)

/-- The law on a finite vector of avoidance indicators assigned by inclusion-exclusion. -/
def finiteAvoidanceLaw {α : Type*} [Fintype α] [DecidableEq α]
    (a : Finset α → ℝ) : Measure (α → Bool) :=
  ∑ B : Finset α, ENNReal.ofReal (avoidanceAtom a B) •
    Measure.dirac (fun i ↦ decide (i ∈ B))

/-- Each avoidance event has its prescribed mass under the finite law. -/
lemma finiteAvoidanceLaw_apply {α : Type*} [Fintype α] [DecidableEq α]
    {a : Finset α → ℝ} (h : ∀ B, 0 ≤ avoidanceAtom a B) (A : Finset α) :
    finiteAvoidanceLaw a (avoidanceEvent A) = ENNReal.ofReal (a A) := by
  classical
  rw [finiteAvoidanceLaw, FunLike.coe_sum, Finset.sum_apply]
  simp_rw [smul_apply, smul_eq_mul, Measure.dirac_apply' _ (measurableSet_avoidanceEvent A)]
  calc
    _ = ∑ B ∈ Finset.Icc A Finset.univ, ENNReal.ofReal (avoidanceAtom a B) := by
      have hh : Finset.Icc A Finset.univ = Finset.univ.filter (A ⊆ ·) := by ext B; simp
      rw [hh, Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro B _
      have h : (fun i ↦ decide (i ∈ B)) ∈ avoidanceEvent A ↔ A ⊆ B := by
        simp only [avoidanceEvent, Set.mem_ofPred_eq, decide_eq_true_eq, Finset.subset_iff]
      simp only [Set.indicator, h, Pi.one_apply]
      split_ifs <;> simp
    _ = _ := by
      rw [← ENNReal.ofReal_sum_of_nonneg (fun B _ ↦ h B), sum_avoidanceAtom_Ici]


/-- The event of missing all tests in the empty family is the full path space. -/
lemma avoidanceEvent_empty {α : Type*} : avoidanceEvent (∅ : Finset α) = univ := by
  ext b
  simp [avoidanceEvent]

/-- A finite union of index sets corresponds to intersecting avoidance events. -/
lemma avoidanceEvent_union {α : Type*} [DecidableEq α] (A B : Finset α) :
    avoidanceEvent (A ∪ B) = avoidanceEvent A ∩ avoidanceEvent B := by
  ext b
  simp only [avoidanceEvent, mem_ofPred_eq, Finset.mem_union, mem_inter_iff]
  exact ⟨fun h ↦ ⟨fun i hi ↦ h i (Or.inl hi), fun i hi ↦ h i (Or.inr hi)⟩,
    fun ⟨hA, hB⟩ i hi ↦ hi.elim (hA i) (hB i)⟩

/-- The sigma-algebra on a Boolean product is generated by finite avoidance events. -/
lemma generateFrom_avoidanceEvent (α : Type*) :
    (inferInstance : MeasurableSpace (α → Bool)) =
      MeasurableSpace.generateFrom (range (avoidanceEvent (α := α))) := by
  let m := MeasurableSpace.generateFrom (range (avoidanceEvent (α := α)))
  have heval (i : α) : @Measurable (α → Bool) Bool m inferInstance (fun b ↦ b i) := by
    classical
    have hs : @MeasurableSet (α → Bool) m (avoidanceEvent {i}) :=
      MeasurableSpace.measurableSet_generateFrom (mem_range_self {i})
    have he : (fun b : α → Bool ↦ b i) =
        fun b ↦ if b ∈ avoidanceEvent {i} then true else false := by
      funext b
      simp [avoidanceEvent]
    rw [he]
    exact Measurable.ite hs measurable_const measurable_const
  refine le_antisymm ?_ (MeasurableSpace.generateFrom_le ?_)
  · change (⨆ i, (inferInstance : MeasurableSpace Bool).comap fun b : α → Bool ↦ b i) ≤ m
    exact iSup_le fun i ↦ measurable_iff_comap_le.mp (heval i)
  · rintro _ ⟨A, rfl⟩
    exact measurableSet_avoidanceEvent A

/-- Finite measures on a Boolean product are determined by probabilities of avoiding
finite sets of tests. -/
lemma measure_eq_of_avoidanceEvent_eq {α : Type*} {μ ν : Measure (α → Bool)}
    [IsFiniteMeasure μ] (h : ∀ A : Finset α, μ (avoidanceEvent A) = ν (avoidanceEvent A)) :
    μ = ν := by
  classical
  let M := range (avoidanceEvent (α := α))
  have hp : IsPiSystem M := by
    rintro _ ⟨A, rfl⟩ _ ⟨B, rfl⟩ _
    exact ⟨A ∪ B, avoidanceEvent_union A B⟩
  refine Measure.ext_of_generateFrom_of_iUnion M (fun _ : ℕ ↦ univ)
    (generateFrom_avoidanceEvent α) hp (Set.iUnion_const _)
    (fun _ ↦ ⟨∅, avoidanceEvent_empty⟩) (fun _ ↦ measure_ne_top _ _) ?_
  rintro _ ⟨A, rfl⟩
  exact h A

omit [TopologicalSpace E] in
/-- A finite test family is unaffected by putting its labels into a larger index set. -/
lemma familyUnion_map {α β : Type*} (K : β → Set E) (e : α ↪ β) (A : Finset α) :
    familyUnion K (A.map e) = familyUnion (K ∘ e) A := by
  ext x
  simp only [familyUnion, mem_iUnion, Finset.mem_map, Function.comp_apply]
  aesop

/-- The Kolmogorov law of a family of avoidance indicators with prescribed compact unions. -/
lemma exists_avoidanceLaw {α : Type*} (T : Set E → ℝ) (K : α → Set E)
    (hK : ∀ i, IsCompact (K i)) (hT0 : T ∅ = 0)
    (hAlt : ∀ k (C₀ : Set E) (C : Fin k → Set E), IsCompact C₀ → (∀ i, IsCompact (C i)) →
      0 ≤ succDiff T k C₀ C) :
    ∃ P : Measure (α → Bool), IsProbabilityMeasure P ∧
      ∀ A : Finset α, P (avoidanceEvent A) = ENNReal.ofReal (1 - T (familyUnion K A)) := by
  classical
  let a (I : Finset α) (A : Finset I) := 1 - T (familyUnion (fun i : I ↦ K i) A)
  let p (I : Finset α) := finiteAvoidanceLaw (a I)
  have hn (I : Finset α) (A : Finset I) : 0 ≤ avoidanceAtom (a I) A :=
    avoidanceAtom_nonneg T (fun i : I ↦ K i) (fun i ↦ hK i) hAlt A
  have hp (I : Finset α) (A : Finset I) : p I (avoidanceEvent A) = ENNReal.ofReal (a I A) :=
    finiteAvoidanceLaw_apply (hn I) A
  let (I : Finset α) : IsProbabilityMeasure (p I) := ⟨by
    rw [← avoidanceEvent_empty, hp]
    simp [a, familyUnion, hT0]⟩
  have hproj : IsProjectiveMeasureFamily (α := fun _ : α ↦ Bool) p := by
    intro I J hJI
    let e : J ↪ I := ⟨fun i ↦ ⟨i, hJI i.2⟩,
      fun i j he ↦ Subtype.ext (congrArg (fun x : I ↦ x.val) he)⟩
    apply measure_eq_of_avoidanceEvent_eq
    intro A
    have hpre : (Finset.restrict₂ (π := fun _ : α ↦ Bool) hJI) ⁻¹' avoidanceEvent A =
        avoidanceEvent (A.map e) := by
      ext b
      simp only [preimage, avoidanceEvent, mem_ofPred_eq, Finset.mem_map]
      constructor
      · intro h i hi
        obtain ⟨j, hj, rfl⟩ := hi
        exact h j hj
      · intro h j hj
        exact h (e j) ⟨j, hj, rfl⟩
    rw [Measure.map_apply (μ := p I) (Finset.measurable_restrict₂ (X := fun _ : α ↦ Bool) hJI)
      (measurableSet_avoidanceEvent A), hpre, hp, hp]
    dsimp only [a]
    rw [familyUnion_map]
    rfl
  let P := projectiveLimit (α := fun _ : α ↦ Bool) p hproj
  have hP : IsProjectiveLimit P p := isProjectiveLimit_projectiveLimit hproj
  refine ⟨P, inferInstance, fun A ↦ ?_⟩
  have hpRE : A.restrict (π := fun _ : α ↦ Bool) ⁻¹' avoidanceEvent (Finset.univ : Finset A) =
      avoidanceEvent A := by
    ext b
    simp [avoidanceEvent, Subtype.forall]
  rw [← hpRE, ← Measure.map_apply A.measurable_restrict (measurableSet_avoidanceEvent _),
    hP A, hp]
  have hU : familyUnion (fun i : A ↦ K i) Finset.univ = familyUnion K A := by
    ext x
    simp [familyUnion, Subtype.exists]
  simp only [a, hU]


omit [TopologicalSpace E] in
/-- A finite union of tests indexed by finite sets is the test indexed by their union. -/
lemma familyUnion_biUnion (U : ℕ → Set E) (J : Finset (Finset ℕ)) :
    familyUnion (familyUnion U) J = familyUnion U (J.biUnion id) := by
  ext x
  simp only [familyUnion, mem_iUnion, Finset.mem_biUnion, id_eq]
  constructor
  · rintro ⟨I, hI, i, hi, hx⟩
    exact ⟨i, ⟨I, hI, hi⟩, hx⟩
  · rintro ⟨i, ⟨I, hI, hi⟩, hx⟩
    exact ⟨I, hI, i, hi, hx⟩

/-- A single avoidance indicator is its singleton avoidance event. -/
lemma mem_avoidanceEvent_singleton {α : Type*} (j : α) (b : α → Bool) :
    b ∈ avoidanceEvent {j} ↔ b j = true := by
  classical
  simp [avoidanceEvent]

omit [TopologicalSpace E] in
/-- A law specified on finite avoidance events respects inclusion between the compact unions. -/
lemma ae_avoidanceEvent_imp {α : Type*} {P : Measure (α → Bool)} [IsFiniteMeasure P]
    {T : Set E → ℝ} {K : α → Set E}
    (hP : ∀ A : Finset α, P (avoidanceEvent A) = ENNReal.ofReal (1 - T (familyUnion K A)))
    {A B : Finset α} (hsub : familyUnion K B ⊆ familyUnion K A) :
    ∀ᵐ b ∂P, b ∈ avoidanceEvent A → b ∈ avoidanceEvent B := by
  classical
  have heq : P (avoidanceEvent A ∩ avoidanceEvent B) = P (avoidanceEvent A) := by
    rw [← avoidanceEvent_union, hP, hP, familyUnion_union, union_eq_left.mpr hsub]
  have hdiff : P (avoidanceEvent A \ avoidanceEvent B) = 0 := by
    have hset : avoidanceEvent A \ avoidanceEvent B =
        avoidanceEvent A \ (avoidanceEvent A ∩ avoidanceEvent B) := by
      ext b
      simp only [Set.mem_sdiff, Set.mem_inter_iff]
      tauto
    rw [hset, measure_sdiff inter_subset_left
      ((measurableSet_avoidanceEvent A).inter (measurableSet_avoidanceEvent B)).nullMeasurableSet
      (measure_ne_top _ _), heq, tsub_self]
  rw [ae_iff]
  have hset : {b | ¬ (b ∈ avoidanceEvent A → b ∈ avoidanceEvent B)} =
      avoidanceEvent A \ avoidanceEvent B := by
    ext b
    simp [not_imp]
  rwa [hset]

/-- The missed open neighbourhoods determine a closed set by taking the complement of
their union. -/
def closedFromAvoidance {α : Type*} (K : α → Set E) (b : α → Bool) : Closeds E :=
  ⟨(⋃ i, ⋃ (_ : b i = true), interior (K i))ᶜ,
    (isOpen_iUnion fun _ ↦ isOpen_iUnion fun _ ↦ isOpen_interior).isClosed_compl⟩

/-- The underlying reconstructed closed set is the complement of all missed interiors. -/
lemma coe_closedFromAvoidance {α : Type*} (K : α → Set E) (b : α → Bool) :
    (closedFromAvoidance K b : Set E) = (⋃ i, ⋃ (_ : b i = true), interior (K i))ᶜ := by
  rw [closedFromAvoidance, Closeds.coe_mk]

/-- A closed set reconstructed from avoidance misses a compact test exactly when a
finite family of the missed interiors covers the test. -/
lemma closedFromAvoidance_inter_eq_empty_iff {α : Type*} (K : α → Set E) (b : α → Bool)
    {C : Set E} (hC : IsCompact C) :
    ((closedFromAvoidance K b : Set E) ∩ C = ∅) ↔ ∃ J : Finset α,
      b ∈ avoidanceEvent J ∧ C ⊆ familyUnion (interior ∘ K) J := by
  let I := {j | b j = true}
  have he : ((closedFromAvoidance K b : Set E) ∩ C = ∅) ↔
      C ⊆ ⋃ j ∈ I, interior (K j) := by
    rw [coe_closedFromAvoidance]
    constructor
    · intro h x hx
      by_contra hxe
      exact Set.notMem_empty x (h ▸ ⟨hxe, hx⟩)
    · intro h
      exact Set.eq_empty_iff_forall_notMem.mpr fun x hx ↦ hx.1 (h hx.2)
  rw [he]
  constructor
  · intro h
    obtain ⟨J, hJI, hJ, hJC⟩ := hC.elim_finite_subcover_image (fun j _ ↦ isOpen_interior) h
    refine ⟨hJ.toFinset, fun j hj ↦ hJI (hJ.mem_toFinset.mp hj), ?_⟩
    simpa only [familyUnion, Function.comp_apply, hJ.mem_toFinset] using hJC
  · rintro ⟨J, hJ, hCover⟩
    exact hCover.trans (iUnion₂_mono' fun j hj ↦ ⟨j, hJ j hj, subset_rfl⟩)

/-- Reconstruction from a countable family of avoidance indicators is Fell measurable. -/
lemma measurable_closedFromAvoidance {α : Type*} [Countable α] (K : α → Set E) :
    @Measurable (α → Bool) (Closeds E) inferInstance fellSigma (closedFromAvoidance K) := by
  apply measurable_generateFrom
  rintro _ ⟨C, hC, rfl⟩
  have he : (closedFromAvoidance K) ⁻¹' {F : Closeds E | (F : Set E) ∩ C = ∅} =
      ⋃ J : Finset α, ⋃ (_ : C ⊆ familyUnion (interior ∘ K) J), avoidanceEvent J := by
    ext b
    rw [mem_preimage, Set.mem_ofPred_eq, closedFromAvoidance_inter_eq_empty_iff K b hC]
    simp only [mem_iUnion, and_comm, exists_prop]
  rw [he]
  exact MeasurableSet.iUnion fun J ↦ MeasurableSet.iUnion fun _ ↦ measurableSet_avoidanceEvent J


section Approximation

variable {E : Type*} [TopologicalSpace E] [LocallyCompactSpace E] [T2Space E]
  [SecondCountableTopology E]

/-- In a locally compact second-countable Hausdorff space there is a countable open basis
whose closures are compact and can be chosen inside any given open neighbourhood. -/
lemma exists_precompact_open_basis :
    ∃ U : ℕ → Set E, (∀ n, IsOpen (U n)) ∧ (∀ n, IsCompact (closure (U n))) ∧
      ∀ O, IsOpen O → ∀ x ∈ O, ∃ n, x ∈ U n ∧ closure (U n) ⊆ O := by
  let B := insert (∅ : Set E) {U ∈ countableBasis E | IsCompact (closure U)}
  have hB : B.Countable :=
    ((countable_countableBasis E).mono (Set.sep_subset _ _)).insert _
  have hBn : B.Nonempty := ⟨∅, Set.mem_insert _ _⟩
  obtain ⟨U, hU⟩ := hB.exists_eq_range hBn
  have hu (n : ℕ) : U n ∈ B := hU ▸ mem_range_self n
  have hprops (n : ℕ) : IsOpen (U n) ∧ IsCompact (closure (U n)) := by
    have hn := hu n
    rcases Set.mem_insert_iff.mp hn with he | hm
    · simp only [he, closure_empty, isOpen_empty, isCompact_empty, and_self]
    · exact ⟨isOpen_of_mem_countableBasis hm.1, hm.2⟩
  refine ⟨U, fun n ↦ (hprops n).1, fun n ↦ (hprops n).2, ?_⟩
  intro O hO x hx
  obtain ⟨C, ⟨hxC, hC⟩, hCO⟩ := (compact_basis_nhds x).mem_iff.mp (hO.mem_nhds hx)
  have hxI : x ∈ interior C := mem_interior_iff_mem_nhds.mpr hxC
  obtain ⟨W, hW, hxW, hWC⟩ :=
    (isBasis_countableBasis E).exists_subset_of_mem_open hxI isOpen_interior
  have hcl : closure W ⊆ C := closure_minimal (hWC.trans interior_subset) hC.isClosed
  have hWB : W ∈ B :=
    Set.mem_insert_of_mem _ ⟨hW, hC.of_isClosed_subset isClosed_closure hcl⟩
  rw [hU] at hWB
  obtain ⟨n, rfl⟩ := hWB
  exact ⟨n, hxW, hcl.trans hCO⟩

omit [LocallyCompactSpace E] [T2Space E] [SecondCountableTopology E] in
/-- A compact test inside an open neighbourhood can be covered by finitely many basis
open sets with closures still inside that neighbourhood. -/
lemma exists_finite_precompact_cover (U : ℕ → Set E) (hU : ∀ n, IsOpen (U n))
    (hB : ∀ O, IsOpen O → ∀ x ∈ O, ∃ n, x ∈ U n ∧ closure (U n) ⊆ O)
    {C O : Set E} (hC : IsCompact C) (hO : IsOpen O) (hCO : C ⊆ O) :
    ∃ I : Finset ℕ, C ⊆ ⋃ i ∈ I, U i ∧ (⋃ i ∈ I, closure (U i)) ⊆ O := by
  let I := {n : ℕ | closure (U n) ⊆ O}
  have hcover : C ⊆ ⋃ n ∈ I, U n := by
    intro x hx
    obtain ⟨n, hn, hsub⟩ := hB O hO x (hCO hx)
    exact mem_iUnion₂.mpr ⟨n, hsub, hn⟩
  obtain ⟨J, hJI, hJ, hCJ⟩ := hC.elim_finite_subcover_image (fun i _ ↦ hU i) hcover
  refine ⟨hJ.toFinset, ?_, ?_⟩
  · simpa only [hJ.mem_toFinset] using hCJ
  · exact iUnion₂_subset fun i hi ↦ hJI (hJ.mem_toFinset.mp hi)

omit [LocallyCompactSpace E] [SecondCountableTopology E] in
/-- Nested compact sets eventually lie in any open neighbourhood of their intersection. -/
lemma exists_subset_of_antitone_compact_iInter_subset_open
    {L : ℕ → Set E} (hLc : ∀ n, IsCompact (L n)) (hanti : Antitone L)
    {O : Set E} (hO : IsOpen O) (hsub : (⋂ n, L n) ⊆ O) :
    ∃ n, L n ⊆ O := by
  have hdis : Disjoint (L 0 ∩ Oᶜ) (⋂ n, L n) :=
    Set.disjoint_left.mpr fun _ hx hy ↦ hx.2 (hsub hy)
  obtain ⟨n, hn⟩ := ((hLc 0).inter_right hO.isClosed_compl).elim_directed_family_closed L
    (fun n ↦ (hLc n).isClosed) hdis hanti.directed_ge
  refine ⟨n, fun x hx ↦ ?_⟩
  by_contra hxO
  exact Set.disjoint_left.mp hn ⟨hanti (Nat.zero_le n) hx, hxO⟩ hx


omit [LocallyCompactSpace E] [SecondCountableTopology E] in
/-- Compact tests have decreasing approximations by finite unions of closures from the
countable basis, with the test in the interior of each approximation. -/
lemma exists_antitone_finite_precompact_approximants (U : ℕ → Set E)
    (hU : ∀ n, IsOpen (U n))
    (hB : ∀ O, IsOpen O → ∀ x ∈ O, ∃ n, x ∈ U n ∧ closure (U n) ⊆ O)
    {C : Set E} (hC : IsCompact C) :
    ∃ J : ℕ → Finset ℕ, Antitone (fun n ↦ ⋃ i ∈ J n, closure (U i)) ∧
      (∀ n, C ⊆ interior (⋃ i ∈ J n, closure (U i))) ∧
      (⋂ n, ⋃ i ∈ J n, closure (U i)) = C := by
  classical
  let S (J : Finset ℕ) := ⋃ i ∈ J, closure (U i)
  let V (n : ℕ) := if closure (U n) ⊆ Cᶜ then (closure (U n))ᶜ else univ
  have hVo (n : ℕ) : IsOpen (V n) := by
    dsimp only [V]
    split_ifs
    · exact isClosed_closure.isOpen_compl
    · exact isOpen_univ
  have hVC (n : ℕ) : C ⊆ V n := by
    dsimp only [V]
    split_ifs with ht
    · exact Set.subset_compl_comm.mp ht
    · exact subset_univ _
  have hr {O : Set E} (hO : IsOpen O) (hCO : C ⊆ O) :
      ∃ J, C ⊆ interior (S J) ∧ S J ⊆ O := by
    obtain ⟨J, hJ, hJO⟩ := exists_finite_precompact_cover U hU hB hC hO hCO
    refine ⟨J, hJ.trans ?_, hJO⟩
    apply interior_maximal _ (isOpen_biUnion fun i _ ↦ hU i)
    exact iUnion₂_mono fun _ _ ↦ subset_closure
  choose next hnext₁ hnext₂ using @hr
  let F n (J : {J : Finset ℕ // C ⊆ interior (S J)}) : Set E := V (n + 1) ∩ interior (S J)
  have hFopen n J : IsOpen (F n J) := (hVo (n + 1)).inter isOpen_interior
  have hFmem n J : C ⊆ F n J := fun _ hx ↦ ⟨hVC _ hx, J.2 hx⟩
  let D : ℕ → {J : Finset ℕ // C ⊆ interior (S J)} :=
    Nat.rec ⟨next (hVo 0) (hVC 0), hnext₁ _ _⟩
      (fun n J ↦ ⟨next (hFopen n J) (hFmem n J), hnext₁ _ _⟩)
  have hV (n : ℕ) : S (D n).1 ⊆ V n := by
    cases n with
    | zero =>
      exact hnext₂ (hVo 0) (hVC 0)
    | succ n =>
      exact (hnext₂ (hFopen n (D n)) (hFmem n (D n))).trans inter_subset_left
  have hAnti : Antitone fun n ↦ S (D n).1 := by
    refine antitone_nat_of_succ_le fun n ↦ ?_
    exact (hnext₂ (hFopen n (D n)) (hFmem n (D n))).trans
      (inter_subset_right.trans interior_subset)
  refine ⟨fun n ↦ (D n).1, hAnti, fun n ↦ (D n).2, ?_⟩
  refine Subset.antisymm (fun x hx ↦ ?_) (subset_iInter fun n ↦ (D n).2.trans interior_subset)
  by_contra hxC
  obtain ⟨n, hxU, hUc⟩ := hB Cᶜ hC.isClosed.isOpen_compl x hxC
  have hxV := hV n (mem_iInter.mp hx n)
  rw [show V n = (closure (U n))ᶜ by simp only [V, ite_eq_left hUc]] at hxV
  exact hxV (subset_closure hxU)


end Approximation

omit [TopologicalSpace E] in
/-- A singleton set of tests has the underlying test as its union. -/
lemma familyUnion_singleton {α : Type*} (K : α → Set E) (i : α) :
    familyUnion K {i} = K i := by simp [familyUnion]

omit [TopologicalSpace E] in
/-- The avoidance bits for a law associated to compact unions are almost surely monotone
in the reverse direction of inclusion of the tests. -/
lemma ae_avoidance_antitone (U : ℕ → Set E) {P : Measure (Finset ℕ → Bool)} [IsFiniteMeasure P]
    {T : Set E → ℝ} (hP : ∀ A : Finset (Finset ℕ),
      P (avoidanceEvent A) = ENNReal.ofReal (1 - T (familyUnion (familyUnion U) A))) :
    ∀ᵐ b ∂P, ∀ I J : Finset ℕ, familyUnion U I ⊆ familyUnion U J →
      b J = true → b I = true := by
  refine ae_all_iff.mpr fun I ↦ ae_all_iff.mpr fun J ↦ ?_
  by_cases h : familyUnion U I ⊆ familyUnion U J
  · have hsub : familyUnion (familyUnion U) {I} ⊆ familyUnion (familyUnion U) {J} := by
      simpa only [familyUnion_singleton] using h
    filter_upwards [ae_avoidanceEvent_imp hP hsub] with b hb _ hJ
    exact (mem_avoidanceEvent_singleton I b).mp (hb ((mem_avoidanceEvent_singleton J b).mpr hJ))
  · exact ae_of_all _ fun _ hh ↦ False.elim (h hh)

omit [TopologicalSpace E] in
/-- Avoiding each test in a finite family almost surely implies avoiding their union. -/
lemma ae_avoidance_biUnion (U : ℕ → Set E) {P : Measure (Finset ℕ → Bool)} [IsFiniteMeasure P]
    {T : Set E → ℝ} (hP : ∀ A : Finset (Finset ℕ),
      P (avoidanceEvent A) = ENNReal.ofReal (1 - T (familyUnion (familyUnion U) A))) :
    ∀ᵐ b ∂P, ∀ J : Finset (Finset ℕ), b ∈ avoidanceEvent J → b (J.biUnion id) = true := by
  refine ae_all_iff.mpr fun J ↦ ?_
  have hsub : familyUnion (familyUnion U) {J.biUnion id} ⊆ familyUnion (familyUnion U) J := by
    rw [familyUnion_singleton, familyUnion_biUnion]
  filter_upwards [ae_avoidanceEvent_imp hP hsub] with b hb hJ
  exact (mem_avoidanceEvent_singleton _ b).mp (hb hJ)

/-- For a compact test, missing the test is almost surely avoidance of some larger
neighbourhood among the finite unions. -/
lemma ae_miss_closedFromAvoidance_iff (U : ℕ → Set E) {P : Measure (Finset ℕ → Bool)}
    [IsFiniteMeasure P] {T : Set E → ℝ} (hP : ∀ A : Finset (Finset ℕ),
      P (avoidanceEvent A) = ENNReal.ofReal (1 - T (familyUnion (familyUnion U) A)))
    {C : Set E} (hC : IsCompact C) :
    ∀ᵐ b ∂P, ((closedFromAvoidance (familyUnion U) b : Set E) ∩ C = ∅) ↔
      ∃ I : Finset ℕ, b I = true ∧ C ⊆ interior (familyUnion U I) := by
  filter_upwards [ae_avoidance_biUnion U hP] with b hb
  rw [closedFromAvoidance_inter_eq_empty_iff _ _ hC]
  constructor
  · rintro ⟨J, hJ, hCsub⟩
    refine ⟨J.biUnion id, hb J hJ, hCsub.trans ?_⟩
    rw [← familyUnion_biUnion]
    apply iUnion₂_subset
    intro j hj
    exact interior_mono (subset_iUnion₂ (s := fun i _ ↦ familyUnion U i) j hj)
  · rintro ⟨I, hb, hCsub⟩
    exact ⟨{I}, (mem_avoidanceEvent_singleton I b).mpr hb,
      by simpa only [familyUnion_singleton, Function.comp_apply] using hCsub⟩

/-- For a nested approximation of a compact test, the miss event is almost surely the
union of the single-test avoidance events along the approximation. -/
lemma ae_miss_closedFromAvoidance_eq_iUnion {E : Type*} [TopologicalSpace E] [T2Space E]
    (U : ℕ → Set E) (hU : ∀ i, IsCompact (U i))
    {P : Measure (Finset ℕ → Bool)} [IsFiniteMeasure P] {T : Set E → ℝ}
    (hP : ∀ A : Finset (Finset ℕ),
      P (avoidanceEvent A) = ENNReal.ofReal (1 - T (familyUnion (familyUnion U) A)))
    {C : Set E} (hC : IsCompact C) (J : ℕ → Finset ℕ)
    (hJ : Antitone (familyUnion U ∘ J)) (hCJ : ∀ n, C ⊆ interior (familyUnion U (J n)))
    (hJC : (⋂ n, familyUnion U (J n)) = C) :
    {b | (closedFromAvoidance (familyUnion U) b : Set E) ∩ C = ∅} =ᵐ[P]
      ⋃ n, avoidanceEvent {J n} := by
  filter_upwards [ae_miss_closedFromAvoidance_iff U hP hC, ae_avoidance_antitone U hP]
    with b hb hmono
  simp only [Set.mem_iUnion, mem_avoidanceEvent_singleton, hb]
  constructor
  · rintro ⟨I, hI, hCI⟩
    obtain ⟨n, hn⟩ := exists_subset_of_antitone_compact_iInter_subset_open
      (fun n ↦ isCompact_familyUnion U hU (J n)) hJ isOpen_interior (hJC.symm ▸ hCI)
    exact ⟨n, hmono (J n) I (hn.trans interior_subset) hI⟩
  · rintro ⟨n, hn⟩
    exact ⟨J n, hn, hCJ n⟩

/-- Almost-sure monotonicity is enough for continuity from below of the measures of a
sequence of measurable events. -/
lemma tendsto_measure_iUnion_atTop_of_ae_mono {X : Type*} [MeasurableSpace X]
    {P : Measure X} {A : ℕ → Set X}
    (hmon : ∀ᵐ b ∂P, ∀ n m : ℕ, n ≤ m → b ∈ A n → b ∈ A m) :
    Tendsto (fun n ↦ P (A n)) atTop (𝓝 (P (⋃ n, A n))) := by
  let B (n : ℕ) := ⋃ k, ⋃ (_ : k ≤ n), A k
  have hBmono : Monotone B := fun n m hnm ↦ iUnion_mono fun k ↦
    iUnion_mono' fun hkn ↦ ⟨hkn.trans hnm, subset_rfl⟩
  have hUn : (⋃ n, B n) = ⋃ n, A n := by
    ext x
    simp only [B, mem_iUnion]
    exact ⟨fun ⟨_, k, _, hx⟩ ↦ ⟨k, hx⟩, fun ⟨k, hx⟩ ↦ ⟨k, k, le_rfl, hx⟩⟩
  have hAe (n : ℕ) : B n =ᵐ[P] A n := by
    filter_upwards [hmon] with x hx
    simp only [B, mem_iUnion]
    exact ⟨fun ⟨k, hkn, hk⟩ ↦ hx k n hkn hk, fun hn ↦ ⟨n, le_rfl, hn⟩⟩
  have ht := tendsto_measure_iUnion_atTop (μ := P) hBmono
  rw [hUn] at ht
  exact ht.congr fun n ↦ measure_congr (hAe n)

/-- The law obtained by reconstructing closed sets has the target compact avoidance
probabilities. -/
lemma measureReal_miss_closedFromAvoidance {E : Type*} [TopologicalSpace E] [T2Space E]
    (U : ℕ → Set E) (hU : ∀ i, IsOpen (U i)) (hK : ∀ i, IsCompact (closure (U i)))
    (hB : ∀ O, IsOpen O → ∀ x ∈ O, ∃ n, x ∈ U n ∧ closure (U n) ⊆ O)
    {P : Measure (Finset ℕ → Bool)} [IsProbabilityMeasure P] {T : Set E → ℝ}
    (hT01 : ∀ C, 0 ≤ T C ∧ T C ≤ 1)
    (husc : ∀ C : ℕ → Set E, (∀ n, IsCompact (C n)) → Antitone C →
      Tendsto (fun n ↦ T (C n)) atTop (𝓝 (T (⋂ n, C n))))
    (hP : ∀ A : Finset (Finset ℕ), P (avoidanceEvent A) =
      ENNReal.ofReal (1 - T (familyUnion (familyUnion (closure ∘ U)) A)))
    {C : Set E} (hC : IsCompact C) :
    P.real {b | (closedFromAvoidance (familyUnion (closure ∘ U)) b : Set E) ∩ C = ∅} =
      1 - T C := by
  let L := familyUnion (closure ∘ U)
  obtain ⟨J, hJ, hCJ, hJC⟩ := exists_antitone_finite_precompact_approximants U hU hB hC
  let A (n : ℕ) := avoidanceEvent {J n}
  have hmono : ∀ᵐ b ∂P, ∀ n m : ℕ, n ≤ m → b ∈ A n → b ∈ A m := by
    filter_upwards [ae_avoidance_antitone (closure ∘ U) hP] with b hb n m hnm
    simp only [A, mem_avoidanceEvent_singleton]
    exact hb (J m) (J n) (hJ hnm)
  have ht := tendsto_measure_iUnion_atTop_of_ae_mono hmono
  have htR := (ENNReal.continuousAt_toReal (measure_ne_top P _)).tendsto.comp ht
  have he := measure_congr
    (ae_miss_closedFromAvoidance_eq_iUnion (closure ∘ U) hK hP hC J hJ hCJ hJC)
  rw [← he] at htR
  have hf (n : ℕ) : (P (A n)).toReal = 1 - T (L (J n)) := by
    dsimp only [A, L]
    rw [hP, familyUnion_singleton, ENNReal.toReal_ofReal (sub_nonneg.mpr (hT01 _).2)]
  have hT : Tendsto (fun n ↦ T (L (J n))) atTop (𝓝 (T C)) := by
    have h := husc (L ∘ J) (fun n ↦ isCompact_familyUnion (closure ∘ U) hK (J n)) hJ
    -- The approximating unions have intersection C.
    change Tendsto (fun n ↦ T (L (J n))) atTop (𝓝 (T (⋂ n, L (J n)))) at h
    exact hJC ▸ h
  have hT' := (tendsto_const_nhds (x := (1 : ℝ))).sub hT
  exact tendsto_nhds_unique (htR.congr hf) hT'


section Existence

variable [LocallyCompactSpace E] [T2Space E] [SecondCountableTopology E]

attribute [local instance] fellSigma

/-- SYNOPSIS item 112, Choquet–Matheron theorem: a functional on compact sets with
`0 ≤ T ≤ 1`, `T(∅) = 0`, upper semicontinuous along decreasing sequences, and completely
alternating is the capacity functional of a unique law on `Closeds E`. -/
theorem existsUnique_law_of_capacity (T : Set E → ℝ) (hT01 : ∀ C, 0 ≤ T C ∧ T C ≤ 1)
    (hT0 : T ∅ = 0)
    (husc : ∀ C : ℕ → Set E, (∀ n, IsCompact (C n)) → Antitone C →
      Tendsto (fun n ↦ T (C n)) atTop (𝓝 (T (⋂ n, C n))))
    (halt : ∀ k (C₀ : Set E) (C : Fin k → Set E), IsCompact C₀ → (∀ i, IsCompact (C i)) →
      0 ≤ succDiff T k C₀ C) :
    ∃! Q : Measure (Closeds E), IsProbabilityMeasure Q ∧
      ∀ C, IsCompact C → (Q {F | ((F : Set E) ∩ C).Nonempty}).toReal = T C := by
  obtain ⟨U, hU, hK, hB⟩ := exists_precompact_open_basis (E := E)
  let K := familyUnion (closure ∘ U)
  obtain ⟨P, hPP, hP⟩ := exists_avoidanceLaw T K (isCompact_familyUnion _ hK) hT0 halt
  let Z := closedFromAvoidance K
  let Q := P.map Z
  have hm : Measurable Z := measurable_closedFromAvoidance K
  have hQ (C : Set E) (hC : IsCompact C) : (Q {F | ((F : Set E) ∩ C).Nonempty}).toReal = T C := by
    let missed := {F : Closeds E | (F : Set E) ∩ C = ∅}
    have hmiss : MeasurableSet missed :=
      MeasurableSpace.measurableSet_generateFrom ⟨C, hC, rfl⟩
    have he : {F : Closeds E | ((F : Set E) ∩ C).Nonempty} = missedᶜ := by
      simp only [missed, Set.compl_ofPred, ← not_nonempty_iff_eq_empty, not_not]
    have hreal : P.real (Z ⁻¹' missed) = 1 - T C :=
      measureReal_miss_closedFromAvoidance U hU hK hB hT01 husc hP hC
    rw [he, ← measureReal_def, probReal_compl_eq_one_sub hmiss, measureReal_def]
    dsimp only [Q]
    rw [Measure.map_apply hm hmiss, ← measureReal_def, hreal, sub_sub_cancel]
  refine ⟨Q, ⟨inferInstance, hQ⟩, ?_⟩
  intro Q' ⟨hQ'P, hQ'⟩
  have h := map_eq_of_capacity_eq (P := Q') (P' := Q) (Z := id) (Z' := id)
    measurable_id measurable_id (fun C hC ↦ (hQ' C hC).trans (hQ C hC).symm)
  simpa only [Measure.map_id] using h

end Existence

end MSSS
